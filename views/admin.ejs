<!doctype html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Administration — Private Member' }) %>
</head>
<body class="app-body">
  <header class="topbar">
    <div class="topbar-brand">
      <span class="brand-mark small">PM</span>
      <span class="brand-name">Private Member</span>
    </div>
    <div class="topbar-user">
      <div class="user-chip">
        <span class="user-name"><%= currentUser.firstName %> <%= currentUser.lastName %></span>
        <span class="user-grade">Administration</span>
      </div>
      <form method="POST" action="/deconnexion">
        <button type="submit" class="btn btn-ghost">Déconnexion</button>
      </form>
    </div>
  </header>

  <main class="page">
    <section class="page-head">
      <span class="eyebrow">Tableau de bord</span>
      <h1>Gestion du personnel &amp; des outils</h1>
      <p class="muted">Ajoutez des membres, constituez votre catalogue d'outils et gérez les affectations.</p>
    </section>

    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
    <% } %>

    <section class="stats-grid">
      <div class="stat-card">
        <span class="stat-value"><%= stats.employeeCount %></span>
        <span class="stat-label">Membres du personnel</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= stats.toolCount %></span>
        <span class="stat-label">Outils au catalogue</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= stats.assignedCount %></span>
        <span class="stat-label">Affectations actives</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= stats.availableCount %></span>
        <span class="stat-label">Outils disponibles</span>
      </div>
    </section>

    <nav class="tabs" id="tabs">
      <button class="tab-btn is-active" data-tab="personnel">Personnel</button>
      <button class="tab-btn" data-tab="outils">Outils</button>
      <button class="tab-btn" data-tab="affectations">Affectations</button>
    </nav>

    <!-- PERSONNEL -->
    <section class="tab-panel is-active" id="personnel">
      <div class="grid-2">
        <div class="card">
          <h3>Ajouter un membre</h3>
          <form method="POST" action="/admin/employes" class="form-grid">
            <label>
              <span>Prénom</span>
              <input type="text" name="first_name" required />
            </label>
            <label>
              <span>Nom</span>
              <input type="text" name="last_name" required />
            </label>
            <label class="span-2">
              <span>Email (identifiant de connexion)</span>
              <input type="email" name="email" required />
            </label>
            <label>
              <span>Grade</span>
              <select name="grade" required>
                <option value="" disabled selected>Choisir un grade</option>
                <% grades.forEach((g) => { %>
                  <option value="<%= g %>"><%= g %></option>
                <% }) %>
              </select>
            </label>
            <label>
              <span>Service (optionnel)</span>
              <input type="text" name="department" placeholder="Ex : Maintenance" />
            </label>
            <button type="submit" class="btn btn-gold span-2">Ajouter le membre</button>
          </form>
          <p class="hint">Un mot de passe temporaire est généré automatiquement et affiché une seule fois.</p>
        </div>

        <div class="card">
          <h3>Équipe (<%= employees.length %>)</h3>
          <% if (employees.length === 0) { %>
            <div class="empty-state"><p>Aucun membre pour le moment.</p></div>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Membre</th>
                    <th>Grade</th>
                    <th>Service</th>
                    <th>Outils</th>
                    <th>Statut</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% employees.forEach((e) => { %>
                    <tr>
                      <td>
                        <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                        <div class="muted small"><%= e.email %></div>
                      </td>
                      <td><span class="pill pill-gold"><%= e.grade %></span></td>
                      <td class="muted"><%= e.department || '—' %></td>
                      <td class="muted"><%= (toolsByEmployee[e.id] || []).length %></td>
                      <td>
                        <span class="status <%= e.active ? 'status-on' : 'status-off' %>">
                          <%= e.active ? 'Actif' : 'Désactivé' %>
                        </span>
                      </td>
                      <td class="actions">
                        <form method="POST" action="/admin/employes/<%= e.id %>/statut">
                          <button type="submit" class="btn btn-tiny"><%= e.active ? 'Désactiver' : 'Activer' %></button>
                        </form>
                        <form method="POST" action="/admin/employes/<%= e.id %>/reinitialiser">
                          <button type="submit" class="btn btn-tiny">Reset mdp</button>
                        </form>
                        <form method="POST" action="/admin/employes/<%= e.id %>/supprimer" onsubmit="return confirm('Supprimer ce membre ?');">
                          <button type="submit" class="btn btn-tiny btn-danger">Supprimer</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- OUTILS -->
    <section class="tab-panel" id="outils">
      <div class="grid-2">
        <div class="card">
          <h3>Ajouter un outil</h3>
          <form method="POST" action="/admin/outils" class="form-grid">
            <label class="span-2">
              <span>Nom de l'outil</span>
              <input type="text" name="name" required />
            </label>
            <label>
              <span>Catégorie</span>
              <input type="text" name="category" placeholder="Ex : Électroportatif" />
            </label>
            <label>
              <span>Référence</span>
              <input type="text" name="reference" placeholder="Ex : REF-2031" />
            </label>
            <label class="span-2">
              <span>Description (optionnel)</span>
              <textarea name="description" rows="3"></textarea>
            </label>
            <button type="submit" class="btn btn-gold span-2">Ajouter au catalogue</button>
          </form>
        </div>

        <div class="card">
          <h3>Catalogue (<%= tools.length %>)</h3>
          <% if (tools.length === 0) { %>
            <div class="empty-state"><p>Aucun outil pour le moment.</p></div>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Outil</th>
                    <th>Catégorie</th>
                    <th>Référence</th>
                    <th>Affecté à</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% tools.forEach((t) => { %>
                    <tr>
                      <td class="cell-strong"><%= t.name %></td>
                      <td><span class="pill"><%= t.category || '—' %></span></td>
                      <td class="muted"><%= t.reference || '—' %></td>
                      <td class="muted">
                        <%= (employeesByTool[t.id] || []).length %> membre(s)
                      </td>
                      <td class="actions">
                        <form method="POST" action="/admin/outils/<%= t.id %>/supprimer" onsubmit="return confirm('Supprimer cet outil ?');">
                          <button type="submit" class="btn btn-tiny btn-danger">Supprimer</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- AFFECTATIONS -->
    <section class="tab-panel" id="affectations">
      <div class="grid-2">
        <div class="card">
          <h3>Affecter un outil</h3>
          <form method="POST" action="/admin/affectations" class="form-grid">
            <label class="span-2">
              <span>Membre</span>
              <select name="employee_id" required>
                <option value="" disabled selected>Choisir un membre</option>
                <% employees.forEach((e) => { %>
                  <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %> — <%= e.grade %></option>
                <% }) %>
              </select>
            </label>
            <label class="span-2">
              <span>Outil</span>
              <select name="tool_id" required>
                <option value="" disabled selected>Choisir un outil</option>
                <% tools.forEach((t) => { %>
                  <option value="<%= t.id %>"><%= t.name %><%= t.reference ? ' — ' + t.reference : '' %></option>
                <% }) %>
              </select>
            </label>
            <label class="span-2">
              <span>Note (optionnel)</span>
              <input type="text" name="note" placeholder="Ex : usage exclusif chantier" />
            </label>
            <button type="submit" class="btn btn-gold span-2">Affecter</button>
          </form>
        </div>

        <div class="card">
          <h3>Affectations actives</h3>
          <% const rows = Object.values(toolsByEmployee).flat(); %>
          <% if (rows.length === 0) { %>
            <div class="empty-state"><p>Aucune affectation pour le moment.</p></div>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Membre</th>
                    <th>Outil</th>
                    <th>Depuis</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% rows.sort((a, b) => new Date(b.assigned_at) - new Date(a.assigned_at)).forEach((row) => { %>
                    <tr>
                      <td class="cell-strong">
                        <%= employeesMap[row.employee_id].first_name %> <%= employeesMap[row.employee_id].last_name %>
                      </td>
                      <td><%= toolsMap[row.tool_id].name %></td>
                      <td class="muted"><%= new Date(row.assigned_at).toLocaleDateString('fr-FR') %></td>
                      <td class="actions">
                        <form method="POST" action="/admin/affectations/<%= row.id %>/supprimer">
                          <button type="submit" class="btn btn-tiny btn-danger">Retirer</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  </main>

  <script src="/js/admin.js"></script>
</body>
</html>

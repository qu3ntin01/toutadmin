<!doctype html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Modifier ' + employee.first_name + ' — Private Member' }) %>
</head>
<body class="app-body">
  <%- include('partials/page-header', { headerTitle: 'Administration', backHref: '/admin#personnel' }) %>

  <main class="page">
    <section class="page-intro">
      <h2><%= employee.first_name %> <%= employee.last_name %></h2>
      <p><%= employee.email %> · <%= employee.contract_type || 'contrat non renseigné' %></p>
    </section>

    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
    <% } %>

    <div class="card">
      <div class="card-head"><h3>Profil du membre</h3></div>
      <form method="POST" action="/admin/employes/<%= employee.id %>/modifier" class="form-grid">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>
          <span>Grade</span>
          <select name="grade" required>
            <% grades.forEach((g) => { %>
              <option value="<%= g %>" <%= employee.grade === g ? 'selected' : '' %>><%= g %></option>
            <% }) %>
          </select>
        </label>
        <label>
          <span>Service</span>
          <input type="text" name="department" value="<%= employee.department %>" placeholder="Ex : Maintenance" />
        </label>
        <label>
          <span>Type de contrat</span>
          <select name="contract_type" required>
            <% contractTypes.forEach((c) => { %>
              <option value="<%= c %>" <%= employee.contract_type === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </label>
        <label>
          <span>Fin de contrat</span>
          <input type="date" name="contract_end_date" value="<%= employee.contract_end_date || '' %>" />
        </label>
        <label class="span-2">
          <span>TJM en € (freelance uniquement)</span>
          <input type="number" name="daily_rate" min="0" step="0.01" value="<%= employee.daily_rate ?? '' %>" placeholder="Ex : 450" />
        </label>
        <div class="span-2 form-actions">
          <button type="submit" class="btn btn-primary">Enregistrer</button>
          <a href="/admin#personnel" class="btn btn-quiet">Annuler</a>
          <% if (employee.contract_type === 'Freelance') { %>
            <a href="/admin/employes/<%= employee.id %>/temps" class="btn">Voir le pointage</a>
          <% } %>
        </div>
      </form>
      <p class="hint">
        Videz le champ « Fin de contrat » pour repasser en durée indéterminée. Le compte se désactive
        automatiquement le lendemain de la date de fin. Le TJM sert au calcul du taux horaire (TJM ÷ 8 h).
      </p>
    </div>
  </main>

  <script src="/js/theme.js"></script>
</body>
</html>

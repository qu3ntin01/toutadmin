<%
  const current = target || {
    kind: 'syslog', label: '', transport: 'udp', host: '', port: 514, format: 'rfc5424',
    facility: 16, app_name: 'toutadmin', min_level: 6, channels: '', path: '',
    allow_self_signed: 0, enabled: 0,
  };
  const selectedChannels = String(current.channels || '').split(',').filter(Boolean);
%>
<form method="POST" action="<%= action %>" class="form-grid">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <label class="span-2">
    <span><%= t('log.targetName') %></span>
    <input type="text" name="label" value="<%= current.label %>" maxlength="120" required placeholder="<%= t('log.targetNameHint') %>" />
  </label>

  <label>
    <span><%= t('log.targetKind') %></span>
    <select name="kind">
      <% kinds.forEach((k) => { %>
        <option value="<%= k %>" <%= current.kind === k ? 'selected' : '' %>><%= t('log.kind.' + k) %></option>
      <% }) %>
    </select>
  </label>

  <label>
    <span><%= t('log.transport') %></span>
    <select name="transport">
      <% transports.forEach((tr) => { %>
        <option value="<%= tr %>" <%= current.transport === tr ? 'selected' : '' %>><%= t('log.transport.' + tr) %></option>
      <% }) %>
    </select>
  </label>

  <label>
    <span><%= t('log.host') %></span>
    <input type="text" name="host" value="<%= current.host %>" maxlength="200" placeholder="wazuh.interne" />
  </label>

  <label>
    <span><%= t('log.port') %></span>
    <input type="number" name="port" value="<%= current.port %>" min="1" max="65535" />
  </label>

  <label class="span-2">
    <span><%= t('log.path') %></span>
    <input type="text" name="path" value="<%= current.path %>" maxlength="300" placeholder="/var/ossec/logs/toutadmin.json" />
  </label>

  <label>
    <span><%= t('log.format') %></span>
    <select name="format">
      <% formats.forEach((f) => { %>
        <option value="<%= f %>" <%= current.format === f ? 'selected' : '' %>><%= t('log.format.' + f) %></option>
      <% }) %>
    </select>
  </label>

  <label>
    <span><%= t('log.facility') %></span>
    <input type="number" name="facility" value="<%= current.facility %>" min="0" max="23" />
  </label>

  <label>
    <span><%= t('log.appName') %></span>
    <input type="text" name="app_name" value="<%= current.app_name %>" maxlength="48" />
  </label>

  <label>
    <span><%= t('log.minLevel') %></span>
    <select name="min_level">
      <% levels.forEach((l) => { %>
        <option value="<%= l.value %>" <%= Number(current.min_level) === l.value ? 'selected' : '' %>><%= t('log.level.' + l.key) %></option>
      <% }) %>
    </select>
  </label>

  <fieldset class="span-2">
    <legend><%= t('log.channelsFilter') %></legend>
    <p class="hint"><%= t('log.channelsHint') %></p>
    <div class="checks">
      <% channels.forEach((c) => { %>
        <label class="check">
          <input type="checkbox" name="channels" value="<%= c %>" <%= selectedChannels.includes(c) ? 'checked' : '' %> />
          <span><%= t('log.channel.' + c) %></span>
        </label>
      <% }) %>
    </div>
  </fieldset>

  <label class="check">
    <input type="checkbox" name="allow_self_signed" value="1" <%= current.allow_self_signed ? 'checked' : '' %> />
    <span><%= t('log.allowSelfSigned') %></span>
  </label>

  <label class="check">
    <input type="checkbox" name="enabled" value="1" <%= current.enabled ? 'checked' : '' %> />
    <span><%= t('log.enabled') %></span>
  </label>

  <div class="span-2 form-actions">
    <button type="submit" class="btn btn-primary"><%= target ? t('common.save') : t('log.addTarget') %></button>
  </div>
</form>

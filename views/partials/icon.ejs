<%
/* Jeu d'icônes partagé : évite de recopier les SVG dans chaque vue. */
const size = typeof iconSize !== 'undefined' ? iconSize : 18;
%><svg viewBox="0 0 24 24" width="<%= size %>" height="<%= size %>" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<% if (name === 'users') { %>
  <path d="M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20" /><circle cx="10" cy="8" r="3.5" /><path d="M20 20v-1.5a3.5 3.5 0 0 0-2.6-3.4" /><path d="M15 4.6a3.5 3.5 0 0 1 0 6.8" />
<% } else if (name === 'tool') { %>
  <path d="M14.5 3.5a4.5 4.5 0 0 0 6 6l-11 11-3 1 1-3Z" /><path d="m13 5 6 6" />
<% } else if (name === 'link') { %>
  <path d="M10 13.5a3.5 3.5 0 0 0 5 0l3-3a3.5 3.5 0 0 0-5-5l-1.5 1.5" /><path d="M14 10.5a3.5 3.5 0 0 0-5 0l-3 3a3.5 3.5 0 0 0 5 5l1.5-1.5" />
<% } else if (name === 'clock') { %>
  <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5v5l3.5 2" />
<% } else if (name === 'shield') { %>
  <path d="M12 3.5 5 6.2v5c0 4.6 3 7.4 7 9.3 4-1.9 7-4.7 7-9.3v-5Z" />
<% } else if (name === 'inbox') { %>
  <rect x="4" y="4" width="16" height="16" rx="2" /><path d="M8 9h8M8 13h8M8 17h5" />
<% } else if (name === 'card') { %>
  <rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="M3.5 10h17" /><path d="M7 14.5h4" />
<% } else if (name === 'calendar') { %>
  <rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" />
<% } else if (name === 'check') { %>
  <circle cx="12" cy="12" r="8.5" /><path d="m8.5 12 2.5 2.5 4.5-5" />
<% } else if (name === 'plus') { %>
  <rect x="4" y="4" width="16" height="16" rx="3" /><path d="M8.5 12h7M12 8.5v7" />
<% } else if (name === 'external') { %>
  <path d="M14 4h6v6" /><path d="M20 4 11 13" /><path d="M18 14v5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 19V8a1.5 1.5 0 0 1 1.5-1.5H10" />
<% } else if (name === 'logout') { %>
  <path d="M14 8V6a1.5 1.5 0 0 0-1.5-1.5h-6A1.5 1.5 0 0 0 5 6v12a1.5 1.5 0 0 0 1.5 1.5h6A1.5 1.5 0 0 0 14 18v-2" /><path d="M17 12H9" /><path d="m14.5 9 3 3-3 3" />
<% } else if (name === 'back') { %>
  <path d="M15 5.5 8.5 12l6.5 6.5" />
<% } %>
</svg>

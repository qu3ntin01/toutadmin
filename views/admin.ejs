<!doctype html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Administration — Private Member' }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <aside class="sidebar">
      <div class="sidebar-brand">
        <span class="brand-mark small">PM</span>
        <span class="brand-name">Private Member</span>
      </div>

      <nav class="sidebar-nav" id="tabs">
        <button class="side-link tab-btn is-active" data-tab="personnel">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 5 18.5V20" /><circle cx="9.5" cy="8" r="3.5" /></svg>
          Personnel
        </button>
        <button class="side-link tab-btn" data-tab="outils">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m14.5 3.5 2 2L6 16 3 17l1-3Z" /><path d="m13 5 2 2" /></svg>
          Outils
        </button>
        <button class="side-link tab-btn" data-tab="affectations">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
          Affectations
        </button>
        <button class="side-link tab-btn" data-tab="remuneration">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></svg>
          Rémunération
        </button>
        <button class="side-link tab-btn" data-tab="rh">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v5c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-3Z" /></svg>
          RH
          <% if (pendingRequestCount > 0) { %><span class="nav-badge"><%= pendingRequestCount %></span><% } %>
        </button>
      </nav>

      <div class="sidebar-footer">
        <%- include('partials/theme-toggle') %>
        <div class="user-chip">
          <span class="user-avatar"><%= currentUser.firstName.charAt(0) %><%= currentUser.lastName.charAt(0) %></span>
          <div class="user-meta">
            <span class="user-name"><%= currentUser.firstName %> <%= currentUser.lastName %></span>
            <span class="user-grade">Administration</span>
          </div>
        </div>
        <form method="POST" action="/deconnexion">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-ghost btn-block">Déconnexion</button>
        </form>
      </div>
    </aside>

    <div class="app-main">
      <header class="topbar">
        <div class="topbar-brand">
          <span class="brand-mark small">PM</span>
          <span class="brand-name">Private Member</span>
        </div>
        <div class="topbar-user">
          <%- include('partials/theme-toggle') %>
          <form method="POST" action="/deconnexion">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn-ghost">Déconnexion</button>
          </form>
        </div>
      </header>

      <main class="page">
        <section class="page-head">
          <div>
            <span class="eyebrow">Tableau de bord</span>
            <h1>Gestion du personnel &amp; des outils</h1>
            <p class="muted">Ajoutez des membres, constituez votre catalogue d'outils et gérez les affectations.</p>
          </div>
        </section>

        <% if (flash) { %>
          <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
        <% } %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 5 18.5V20" /><circle cx="9.5" cy="8" r="3.5" /></svg>
            </span>
            <div class="stat-body">
              <span class="stat-value"><%= stats.employeeCount %></span>
              <span class="stat-label">Membres du personnel</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m14.5 3.5 2 2L6 16 3 17l1-3Z" /></svg>
            </span>
            <div class="stat-body">
              <span class="stat-value"><%= stats.toolCount %></span>
              <span class="stat-label">Outils au catalogue</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
            </span>
            <div class="stat-body">
              <span class="stat-value"><%= stats.assignedCount %></span>
              <span class="stat-label">Affectations actives</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="4" /><path d="M8 12h8M12 8v8" /></svg>
            </span>
            <div class="stat-body">
              <span class="stat-value"><%= stats.availableCount %></span>
              <span class="stat-label">Outils disponibles</span>
            </div>
          </div>
        </section>

        <!-- PERSONNEL -->
        <section class="tab-panel is-active" id="personnel">
          <div class="grid-2">
            <div class="card">
              <h3>Ajouter un membre</h3>
              <form method="POST" action="/admin/employes" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label>
                  <span>Prénom</span>
                  <input type="text" name="first_name" required />
                </label>
                <label>
                  <span>Nom</span>
                  <input type="text" name="last_name" required />
                </label>
                <label class="span-2">
                  <span>Email (identifiant de connexion)</span>
                  <input type="email" name="email" required />
                </label>
                <label>
                  <span>Grade</span>
                  <select name="grade" required>
                    <option value="" disabled selected>Choisir un grade</option>
                    <% grades.forEach((g) => { %>
                      <option value="<%= g %>"><%= g %></option>
                    <% }) %>
                  </select>
                </label>
                <label>
                  <span>Service (optionnel)</span>
                  <input type="text" name="department" placeholder="Ex : Maintenance" />
                </label>
                <label>
                  <span>Type de contrat</span>
                  <select name="contract_type" required>
                    <option value="" disabled selected>Choisir un type</option>
                    <% contractTypes.forEach((c) => { %>
                      <option value="<%= c %>"><%= c %></option>
                    <% }) %>
                  </select>
                </label>
                <label>
                  <span>Fin de contrat (optionnel)</span>
                  <input type="date" name="contract_end_date" />
                </label>
                <label class="span-2">
                  <span>TJM — taux journalier moyen (optionnel, freelance uniquement)</span>
                  <input type="number" name="daily_rate" min="0" step="0.01" placeholder="Ex : 450" />
                </label>
                <button type="submit" class="btn btn-gold span-2">Ajouter le membre</button>
              </form>
              <p class="hint">Un mot de passe temporaire est généré automatiquement et affiché une seule fois. Si une date de fin est renseignée, le compte se désactive automatiquement à cette date. Le TJM n'est utilisé que pour estimer la rémunération des membres en freelance.</p>
            </div>

            <div class="card">
              <h3>Équipe (<%= employees.length %>)</h3>
              <% if (employees.length === 0) { %>
                <div class="empty-state"><p>Aucun membre pour le moment.</p></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Membre</th>
                        <th>Grade</th>
                        <th>Contrat</th>
                        <th>Outils</th>
                        <th>Statut</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% const todayStr = new Date().toISOString().slice(0, 10); %>
                      <% employees.forEach((e) => { %>
                        <%
                          let daysLeft = null;
                          if (e.contract_end_date) {
                            daysLeft = Math.ceil((new Date(e.contract_end_date + 'T00:00:00Z') - new Date(todayStr + 'T00:00:00Z')) / 86400000);
                          }
                          const isExpired = daysLeft !== null && daysLeft < 0;
                          const isSoon = daysLeft !== null && daysLeft >= 0 && daysLeft <= 30;
                        %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                            <div class="muted small"><%= e.email %></div>
                          </td>
                          <td><span class="pill pill-gold"><%= e.grade %></span></td>
                          <td>
                            <div class="cell-strong small"><%= e.contract_type || '—' %></div>
                            <% if (e.contract_end_date) { %>
                              <% const dateClass = isExpired ? 'text-danger' : (isSoon ? 'text-warning' : 'muted'); %>
                              <div class="small <%= dateClass %>">
                                <%= isExpired ? 'Expiré le' : "Jusqu'au" %> <%= new Date(e.contract_end_date + 'T00:00:00Z').toLocaleDateString('fr-FR') %>
                                <% if (!isExpired) { %>(dans <%= daysLeft %> j.)<% } %>
                              </div>
                            <% } else { %>
                              <div class="small muted">Durée indéterminée</div>
                            <% } %>
                          </td>
                          <td class="muted"><%= (toolsByEmployee[e.id] || []).length %></td>
                          <td>
                            <% if (isExpired) { %>
                              <span class="status status-warning">Expiré</span>
                            <% } else { %>
                              <span class="status <%= e.active ? 'status-on' : 'status-off' %>">
                                <%= e.active ? 'Actif' : 'Désactivé' %>
                              </span>
                            <% } %>
                          </td>
                          <td class="actions">
                            <a href="/admin/employes/<%= e.id %>/modifier" class="btn btn-tiny">Modifier</a>
                            <form method="POST" action="/admin/employes/<%= e.id %>/statut">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-tiny"><%= e.active ? 'Désactiver' : 'Activer' %></button>
                            </form>
                            <form method="POST" action="/admin/employes/<%= e.id %>/reinitialiser">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-tiny">Reset mdp</button>
                            </form>
                            <form method="POST" action="/admin/employes/<%= e.id %>/supprimer" data-confirm="Supprimer ce membre ?">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-tiny btn-danger">Supprimer</button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- OUTILS -->
        <section class="tab-panel" id="outils">
          <div class="grid-2">
            <div class="card">
              <h3>Ajouter un outil</h3>
              <form method="POST" action="/admin/outils" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span>Nom de l'outil</span>
                  <input type="text" name="name" required />
                </label>
                <label>
                  <span>Catégorie</span>
                  <input type="text" name="category" placeholder="Ex : Électroportatif" />
                </label>
                <label>
                  <span>Référence</span>
                  <input type="text" name="reference" placeholder="Ex : REF-2031" />
                </label>
                <label class="span-2">
                  <span>URL de connexion (optionnel)</span>
                  <input type="url" name="login_url" placeholder="https://outil.entreprise.com/connexion" />
                </label>
                <label class="span-2">
                  <span>Description (optionnel)</span>
                  <textarea name="description" rows="3"></textarea>
                </label>
                <button type="submit" class="btn btn-gold span-2">Ajouter au catalogue</button>
              </form>
            </div>

            <div class="card">
              <h3>Catalogue (<%= tools.length %>)</h3>
              <% if (tools.length === 0) { %>
                <div class="empty-state"><p>Aucun outil pour le moment.</p></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Outil</th>
                        <th>Catégorie</th>
                        <th>Référence</th>
                        <th>Affecté à</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% tools.forEach((t) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= t.name %></div>
                            <% if (t.login_url) { %><div class="muted small">Connexion configurée</div><% } %>
                          </td>
                          <td><span class="pill"><%= t.category || '—' %></span></td>
                          <td class="muted"><%= t.reference || '—' %></td>
                          <td class="muted">
                            <%= (employeesByTool[t.id] || []).length %> membre(s)
                          </td>
                          <td class="actions">
                            <a href="/admin/outils/<%= t.id %>/modifier" class="btn btn-tiny">Modifier</a>
                            <form method="POST" action="/admin/outils/<%= t.id %>/supprimer" data-confirm="Supprimer cet outil ?">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-tiny btn-danger">Supprimer</button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- AFFECTATIONS -->
        <section class="tab-panel" id="affectations">
          <div class="grid-2">
            <div class="card">
              <h3>Affecter un outil</h3>
              <form method="POST" action="/admin/affectations" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span>Membre</span>
                  <select name="employee_id" required>
                    <option value="" disabled selected>Choisir un membre</option>
                    <% employees.forEach((e) => { %>
                      <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %> — <%= e.grade %></option>
                    <% }) %>
                  </select>
                </label>
                <label class="span-2">
                  <span>Outil</span>
                  <select name="tool_id" required>
                    <option value="" disabled selected>Choisir un outil</option>
                    <% tools.forEach((t) => { %>
                      <option value="<%= t.id %>"><%= t.name %><%= t.reference ? ' — ' + t.reference : '' %></option>
                    <% }) %>
                  </select>
                </label>
                <label>
                  <span>Identifiant (optionnel)</span>
                  <input type="text" name="username" placeholder="Ex : marie.dupont" />
                </label>
                <label>
                  <span>Note (optionnel)</span>
                  <input type="text" name="note" placeholder="Ex : usage exclusif chantier" />
                </label>
                <button type="submit" class="btn btn-gold span-2">Affecter</button>
              </form>
              <p class="hint">L'identifiant renseigné sera visible par le membre dans son espace, à côté de l'URL de connexion de l'outil.</p>
            </div>

            <div class="card">
              <h3>Affectations actives</h3>
              <% const rows = Object.values(toolsByEmployee).flat(); %>
              <% if (rows.length === 0) { %>
                <div class="empty-state"><p>Aucune affectation pour le moment.</p></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Membre</th>
                        <th>Outil</th>
                        <th>Identifiant</th>
                        <th>Depuis</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% rows.sort((a, b) => new Date(b.assigned_at) - new Date(a.assigned_at)).forEach((row) => { %>
                        <tr>
                          <td class="cell-strong">
                            <%= employeesMap[row.employee_id].first_name %> <%= employeesMap[row.employee_id].last_name %>
                          </td>
                          <td><%= toolsMap[row.tool_id].name %></td>
                          <td class="muted"><%= row.username || '—' %></td>
                          <td class="muted"><%= new Date(row.assigned_at).toLocaleDateString('fr-FR') %></td>
                          <td class="actions">
                            <form method="POST" action="/admin/affectations/<%= row.id %>/supprimer">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-tiny btn-danger">Retirer</button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- REMUNERATION -->
        <section class="tab-panel" id="remuneration">
          <div class="card">
            <h3>Temps &amp; rémunération estimée — freelances</h3>
            <% if (freelancers.length === 0) { %>
              <div class="empty-state"><p>Aucun membre en freelance pour le moment. Passez le type de contrat d'un membre en « Freelance » pour activer son pointage.</p></div>
            <% } else { %>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Membre</th>
                      <th>TJM</th>
                      <th>Heures ce mois</th>
                      <th>Est. ce mois</th>
                      <th>Heures totales</th>
                      <th>Est. totale</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% freelancers.forEach((e) => { %>
                      <% const s = freelanceStats[e.id]; %>
                      <tr>
                        <td>
                          <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                          <% if (openEntriesMap[e.id]) { %><span class="status status-on">En cours</span><% } %>
                        </td>
                        <td class="muted"><%= e.daily_rate ? e.daily_rate.toFixed(2) + ' €' : '—' %></td>
                        <td class="muted"><%= s.monthHours.toFixed(1) %> h</td>
                        <td class="cell-strong"><%= s.monthEstimate.toFixed(2) %> €</td>
                        <td class="muted"><%= s.totalHours.toFixed(1) %> h</td>
                        <td class="cell-strong"><%= s.totalEstimate.toFixed(2) %> €</td>
                        <td class="actions">
                          <a href="/admin/employes/<%= e.id %>/temps" class="btn btn-tiny">Détail</a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
            <p class="hint">Le taux horaire est calculé sur la base du TJM divisé par 8 heures. Ces montants sont des estimations, pas des bulletins de paie.</p>
          </div>
        </section>

        <!-- RH -->
        <section class="tab-panel" id="rh">
          <div class="card card-spaced">
            <div class="rh-panel-link">
              <div>
                <h3>Espace RH</h3>
                <p class="muted small">Demandes de congés, soldes et fiches de paie de tout le personnel non-freelance.</p>
              </div>
              <a href="/rh" class="btn btn-gold">Ouvrir l'espace RH →</a>
            </div>
          </div>

          <div class="grid-2">
            <div class="card">
              <h3>Nommer un responsable RH</h3>
              <% if (hrEligibleEmployees.length === 0) { %>
                <div class="empty-state"><p>Tous les membres ont déjà accès à l'espace RH.</p></div>
              <% } else { %>
                <form method="POST" action="/admin/rh/nommer" class="form-grid">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label class="span-2">
                    <span>Membre</span>
                    <select name="employee_id" required>
                      <option value="" disabled selected>Choisir un membre</option>
                      <% hrEligibleEmployees.forEach((e) => { %>
                        <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %> — <%= e.grade %></option>
                      <% }) %>
                    </select>
                  </label>
                  <button type="submit" class="btn btn-gold span-2">Donner accès à l'espace RH</button>
                </form>
              <% } %>
              <p class="hint">Un membre RH garde son propre espace personnel (congés, fiches de paie) et gagne en plus l'accès au panneau RH pour gérer tout le personnel.</p>
            </div>

            <div class="card">
              <h3>Membres RH (<%= hrMembers.length %>)</h3>
              <% if (hrMembers.length === 0) { %>
                <div class="empty-state"><p>Aucun membre RH pour le moment.</p></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr><th>Membre</th><th>Grade</th><th></th></tr>
                    </thead>
                    <tbody>
                      <% hrMembers.forEach((e) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                            <div class="muted small"><%= e.email %></div>
                          </td>
                          <td><span class="pill pill-gold"><%= e.grade %></span></td>
                          <td class="actions">
                            <form method="POST" action="/admin/rh/<%= e.id %>/retirer">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-tiny btn-danger">Retirer l'accès</button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/confirm.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>

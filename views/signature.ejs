<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: request.title + ' — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('nav.signing'),
      navItems: [{ href: '/parapheur', label: t('sig.tabAllDocuments'), icon: 'inbox', active: true }],
      footLinks: [
        { href: '/parapheur/' + request.id + '/attestation', label: t('sig.tabAttestation'), icon: 'shield' },
        { href: '/mon-espace', label: t('nav.mySpace'), icon: 'home' }
      ]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: request.title,
        headerSubtitle: request.kind + ' · ' + request.signedCount + '/' + request.total + ' signature(s)',
        backHref: '/parapheur',
        backLabel: t('nav.signing')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const moment = (iso) => (iso ? new Date(iso).toLocaleString(locale) : '—'); %>
        <% const day = (iso) => (iso ? new Date(iso.slice(0, 10) + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>

        <div class="card">
          <div class="card-head">
            <h3><%= t('sig.flowState') %></h3>
            <span class="tag <%= request.status === 'Signé' ? 'tag-success' : (request.status === 'En cours' ? 'tag-warning' : 'tag-danger') %>"><%= st(request.status) %></span>
          </div>
          <p class="cell-sub">
            <%= t('sig.openedOnCap', { date: day(request.created_at) }) %><%= request.deadline ? ` · ${t('sig.signBeforeDate', { date: day(request.deadline) })}` : '' %>
            <%= request.overdue ? ` · ${t('sig.deadlinePassed')}` : '' %>
          </p>
          <span class="meter"><span class="meter-fill" data-ratio="<%= request.progress %>"></span></span>

          <% if (!verification.ok) { %>
            <div class="flash flash-error">
              <%= t('sig.integrityFailed', {
                    detail: [
                      verification.document.ok ? '' : verification.document.reason,
                      verification.broken.length ? t('sig.invalidSeal', { names: verification.broken.join(', ') }) : '',
                    ].filter(Boolean).join(' '),
                  }) %>
            </div>
          <% } else { %>
            <p class="hint"><%= t('sig.integrityOk') %></p>
          <% } %>
          <p class="cell-sub mono">SHA-256 : <%= request.sha256 %></p>

          <% if (request.closing_reason) { %>
            <p class="cell-sub"><%= t('sig.closingReason', { reason: request.closing_reason }) %></p>
          <% } %>
        </div>

        <div class="card">
          <div class="card-head"><h3><%= t('common.document') %></h3></div>
          <% if (request.file_name) { %>
            <p class="cell-sub"><%= request.original_name %> · <%= Math.round(request.byte_size / 1024) %> Ko</p>
            <div class="row-actions"><a href="/parapheur/<%= request.id %>/document" class="btn btn-outline btn-sm"><%= t('sig.download') %></a></div>
          <% } else { %>
            <div class="minutes"><p><%= request.body %></p></div>
          <% } %>
        </div>

        <div class="card">
          <div class="card-head"><h3><%= t('sig.signatories') %></h3></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th><%= t('common.rank') %></th><th><%= t('common.signatory') %></th><th><%= t('nav.quality') %></th><th><%= t('common.state') %></th><th><%= t('common.timestamp') %></th><th><%= t('common.seal') %></th></tr></thead>
              <tbody>
                <% request.signers.forEach((s) => { %>
                  <tr>
                    <td class="cell-sub"><%= s.position %></td>
                    <td class="cell-strong"><%= s.first_name %> <%= s.last_name %><br /><span class="cell-sub"><%= s.grade || '' %></span></td>
                    <td class="cell-sub"><%= s.role_label || '—' %></td>
                    <td>
                      <span class="tag <%= s.status === 'Signé' ? 'tag-success' : (s.status === 'Refusé' ? 'tag-danger' : 'tag-warning') %>"><%= st(s.status) %></span>
                      <% if (s.reason) { %><div class="cell-sub"><%= s.reason %></div><% } %>
                    </td>
                    <td class="cell-sub nowrap"><%= moment(s.signed_at) %><% if (s.ip) { %><br /><span class="cell-sub"><%= t('sig.fromIp', { ip: s.ip }) %></span><% } %></td>
                    <td class="cell-sub mono"><%= s.seal ? s.seal.slice(0, 16) + '…' : '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <% if (myTurn.ok) { %>
          <div class="card">
            <div class="card-head"><h3><%= t('sig.sign') %></h3></div>
            <form method="POST" action="/parapheur/<%= request.id %>/signer" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="span-2 check-row">
                <input type="checkbox" name="consent" value="1" required />
                <span><%= t('sig.consent') %></span>
              </label>
              <label class="span-2"><span><%= t('sig.yourPassword') %></span><input type="password" name="password" required autocomplete="current-password" /></label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('sig.affix') %></button></div>
            </form>
            <p class="hint">
              <%= t('sig.passwordNote') %>
            </p>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('hr.refuse') %></h3></div>
            <form method="POST" action="/parapheur/<%= request.id %>/refuser" class="form-grid" data-confirm="<%= t('sig.confirmRefuse') %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="span-2"><span><%= t('common.refusalReason') %></span><textarea name="reason" rows="2" required placeholder="<%= t('sig.refusePlaceholder') %>"></textarea></label>
              <div class="span-2"><button type="submit" class="btn btn-outline btn-block"><%= t('sig.refuse') %></button></div>
            </form>
          </div>
        <% } else if (request.status === 'En cours') { %>
          <div class="card"><p class="empty-state"><%= myTurn.message %></p></div>
        <% } %>

        <% if (opener) { %>
          <div class="card">
            <div class="card-head"><h3><%= t('sig.flowAdmin') %></h3></div>
            <div class="row-actions">
              <a href="/parapheur/<%= request.id %>/attestation" class="btn btn-outline btn-sm"><%= t('sig.attestation') %></a>
              <% if (request.status === 'En cours') { %>
                <form method="POST" action="/parapheur/<%= request.id %>/annuler" class="inline-field" data-confirm="<%= t('sig.confirmWithdraw') %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="text" name="reason" class="input-sm" placeholder="<%= t('common.reason') %>" maxlength="200" />
                  <button type="submit" class="btn btn-outline btn-sm"><%= t('sig.cancelFlow') %></button>
                </form>
              <% } else if (request.signedCount === 0) { %>
                <form method="POST" action="/parapheur/<%= request.id %>/supprimer" class="inline-form" data-confirm="<%= t('sig.confirmDelete') %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-link btn-sm"><%= t('common.delete') %></button>
                </form>
              <% } %>
            </div>
            <% if (request.signedCount > 0) { %>
              <p class="hint"><%= t('sig.signedNotDeletable') %></p>
            <% } %>
          </div>
        <% } %>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/meter.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

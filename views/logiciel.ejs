<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: licence.name + ' — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('inf.panel'),
      navItems: [
        { tab: 'fiche', label: t('inf.sheet'), icon: 'network' },
        { tab: 'acces', label: t('inf.tabAccess'), icon: 'shield', badge: accessList.filter((a) => !a.revoked_on).length }
      ],
      footLinks: [{ href: '/informatique', label: t('nav.it'), icon: 'back' }]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: licence.name,
        headerSubtitle: t('inf.sheetSub')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const money = (n) => (n == null ? '—' : Number(n).toLocaleString(locale, { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' €'); %>
        <% const day = (iso) => (iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'users', iconSize: 18 }) %></span>
            <span class="stat-body">
              <span class="stat-value"><%= licence.seats > 0 ? t('inf.seatsOf', { used: licence.seats_used, total: licence.seats }) : licence.seats_used %></span>
              <span class="stat-label"><%= t('inf.openAccesses') %></span>
            </span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'card', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(yearlyCost) %></span><span class="stat-label"><%= t('inf.yearlyCost') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clock', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= day(licence.renewal_date) %></span><span class="stat-label"><%= t('inf.renewal') %></span></span>
          </div>
        </section>

        <section class="tab-panel is-active" id="fiche">
          <div class="card">
            <div class="card-head">
              <h3><%= t('inf.sheet') %></h3>
              <form method="POST" action="/informatique/logiciels/<%= licence.id %>/supprimer" data-confirm="<%= t('inf.confirmDeleteSoftware') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="btn btn-sm btn-danger"><%= t('common.delete') %></button>
              </form>
            </div>
            <form method="POST" action="/informatique/logiciels/<%= licence.id %>/modifier" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label><span><%= t('inf.software') %></span><input type="text" name="name" value="<%= licence.name %>" required maxlength="120" /></label>
              <label><span><%= t('inf.publisher') %></span><input type="text" name="publisher" value="<%= licence.publisher %>" maxlength="120" /></label>
              <label><span><%= t('common.type') %></span>
                <select name="kind"><% kinds.forEach((k) => { %><option value="<%= k %>" <%= licence.kind === k ? 'selected' : '' %>><%= st(k) %></option><% }) %></select>
              </label>
              <label><span><%= t('inf.criticality') %></span>
                <select name="criticality"><% criticalities.forEach((c) => { %><option value="<%= c %>" <%= licence.criticality === c ? 'selected' : '' %>><%= st(c) %></option><% }) %></select>
              </label>
              <label><span><%= t('inf.seats') %></span><input type="number" name="seats" min="0" max="100000" value="<%= licence.seats %>" /></label>
              <label><span><%= t('inf.unitCost') %></span><input type="text" name="unit_cost" inputmode="decimal" value="<%= licence.unit_cost == null ? '' : licence.unit_cost %>" /></label>
              <label><span><%= t('inf.billingPeriod') %></span>
                <select name="billing_period"><% billingPeriods.forEach((b) => { %><option value="<%= b %>" <%= licence.billing_period === b ? 'selected' : '' %>><%= st(b) %></option><% }) %></select>
              </label>
              <label><span><%= t('inf.renewal') %></span><input type="date" name="renewal_date" value="<%= licence.renewal_date || '' %>" /></label>
              <label><span><%= t('inf.owner') %></span>
                <select name="owner_id"><option value="">—</option>
                  <% employees.forEach((u) => { %><option value="<%= u.id %>" <%= licence.owner_id === u.id ? 'selected' : '' %>><%= u.first_name %> <%= u.last_name %></option><% }) %>
                </select>
              </label>
              <label><span><%= t('common.status') %></span>
                <select name="status"><% statuses.forEach((s) => { %><option value="<%= s %>" <%= licence.status === s ? 'selected' : '' %>><%= st(s) %></option><% }) %></select>
              </label>
              <label class="span-2 check-row">
                <input type="checkbox" name="personal_data" value="1" <%= licence.personal_data ? 'checked' : '' %> />
                <span><%= t('inf.personalDataLabel') %></span>
              </label>
              <label class="span-2"><span><%= t('common.notes') %></span><textarea name="notes" rows="3" maxlength="1000"><%= licence.notes %></textarea></label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.save') %></button></div>
            </form>
          </div>
        </section>

        <section class="tab-panel" id="acces">
          <div class="card">
            <div class="card-head"><h3><%= t('inf.grantAccess') %></h3></div>
            <% if (grantable.length === 0) { %>
              <div class="empty-state"><%= t('inf.everyoneHasAccess') %></div>
            <% } else { %>
              <form method="POST" action="/informatique/logiciels/<%= licence.id %>/acces" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label><span><%= t('common.member') %></span>
                  <select name="user_id" required>
                    <option value="" disabled selected><%= t('common.choose') %></option>
                    <% grantable.forEach((u) => { %><option value="<%= u.id %>"><%= u.first_name %> <%= u.last_name %></option><% }) %>
                  </select>
                </label>
                <label><span><%= t('inf.level') %></span>
                  <select name="level"><% levels.forEach((lv) => { %><option value="<%= lv %>"><%= st(lv) %></option><% }) %></select>
                </label>
                <label class="span-2"><span><%= t('inf.accessReason') %></span><input type="text" name="note" maxlength="300" /></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('inf.openAccess') %></button></div>
              </form>
            <% } %>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('inf.accessCount', { count: accessList.length }) %></h3></div>
            <div class="table-wrap">
              <table>
                <thead><tr>
                  <th><%= t('common.member') %></th><th><%= t('inf.level') %></th><th><%= t('inf.grantedOn') %></th>
                  <th><%= t('inf.reviewedOn') %></th><th><%= t('common.status') %></th><th></th>
                </tr></thead>
                <tbody>
                  <% accessList.forEach((access) => { %>
                    <tr>
                      <td>
                        <div class="cell-strong"><%= access.first_name %> <%= access.last_name %></div>
                        <div class="cell-sub"><%= access.email %></div>
                      </td>
                      <td class="cell-sub"><%= st(access.level) %></td>
                      <td class="cell-sub nowrap"><%= day(access.granted_on) %>
                        <% if (access.by_first_name) { %><br /><span class="cell-sub"><%= t('inf.grantedBy', { name: access.by_first_name + ' ' + access.by_last_name }) %></span><% } %>
                      </td>
                      <td class="cell-sub nowrap"><%= day(access.reviewed_on) %></td>
                      <td>
                        <% if (access.revoked_on) { %>
                          <span class="tag"><%= t('inf.revokedOn', { date: day(access.revoked_on) }) %></span>
                        <% } else if (!access.active) { %>
                          <span class="tag tag-danger"><%= t('inf.accountClosed') %></span>
                        <% } else { %>
                          <span class="tag tag-success"><%= t('inf.accessOpen') %></span>
                        <% } %>
                      </td>
                      <td class="actions">
                        <% if (!access.revoked_on) { %>
                          <form method="POST" action="/informatique/acces/<%= access.id %>/revoquer" data-confirm="<%= t('inf.confirmRevoke') %>">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-sm btn-danger"><%= t('inf.revoke') %></button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (accessList.length === 0) { %><tr><td colspan="6" class="cell-sub"><%= t('inf.noAccess') %></td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

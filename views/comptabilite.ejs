<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>"<%- railAttrs %>>
<head>
  <%- include('partials/head', { title: 'Comptabilité — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/services-sidebar') %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('pcs.tabAccounting'),
        headerSubtitle: t('cpt.headerSub', { year }),
        onglets: [
          { tab: 'ecritures', label: t('cpt.tabEntries'), icon: 'card' },
          { tab: 'balance', label: t('cpt.tabBalance'), icon: 'network' },
          { tab: 'grand-livre', label: t('cpt.tabLedger'), icon: 'inbox' },
          { tab: 'lettrage', label: t('cpt.tabLettering'), icon: 'check' },
          { tab: 'plan', label: t('cpt.tabChart'), icon: 'settings' },
          { tab: 'cloture', label: t('cpt.tabClosing'), icon: 'shield' }
        ]
      }) %>

      <main class="page">
        <% if (flash) { %>
          <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
        <% } %>

        <% const money = (n) => Number(n || 0).toLocaleString(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'; %>
        <% const day = (iso) => (iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'card', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(income.revenue) %></span><span class="stat-label"><%= t('cpt.revenue') %> <%= year %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'ticket', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(income.expenses) %></span><span class="stat-label"><%= t('cpt.expenses') %> <%= year %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'check', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(income.result) %></span><span class="stat-label"><%= t('cpt.result') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'inbox', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= unposted.length %></span><span class="stat-label"><%= t('cpt.toPost') %></span></span>
          </div>
        </section>

        <!-- ---------- Écritures ---------- -->
        <section class="tab-panel is-active" id="ecritures">
          <div class="card">
            <div class="card-head"><h3><%= t('cpt.newEntry') %></h3></div>
            <form method="POST" action="/comptabilite/ecritures" class="stack">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="form-grid">
                  <label>
                    <span><%= t('cpt.journal') %></span>
                    <select name="journal_id" required>
                      <% journals.forEach((j) => { %><option value="<%= j.id %>"><%= j.code %> — <%= j.label %></option><% }) %>
                    </select>
                  </label>
                  <label>
                    <span><%= t('common.date') %></span>
                    <input type="date" name="entry_date" required />
                  </label>
                </div>
                <label>
                  <span><%= t('common.label') %></span>
                  <input type="text" name="label" maxlength="160" required />
                </label>
                <label>
                  <span><%= t('pcs.piece') %></span>
                  <input type="text" name="reference" maxlength="60" />
                </label>

                <h4 class="section-label"><%= t('common.lines') %></h4>
                <% for (let i = 0; i < 4; i++) { %>
                  <div class="entry-line">
                    <select name="account_id">
                      <option value="">— compte —</option>
                      <% accounts.filter((a) => a.active).forEach((a) => { %>
                        <option value="<%= a.id %>"><%= a.code %> <%= a.label %></option>
                      <% }) %>
                    </select>
                    <input type="text" name="line_label" placeholder="<%= t('cpt.labelPlaceholder') %>" maxlength="160" />
                    <input type="text" name="debit" inputmode="decimal" placeholder="<%= t('cpt.debitPlaceholder') %>" />
                    <input type="text" name="credit" inputmode="decimal" placeholder="<%= t('cpt.creditPlaceholder') %>" />
                  </div>
                <% } %>

              <div class="form-actions">
                <button type="submit" class="btn btn-primary"><%= t('cpt.saveEntry') %></button>
              </div>
              <p class="hint"><%= t('cpt.balanceRule') %></p>
            </form>
          </div>

          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('cpt.toPost') %> <span class="muted">(<%= unposted.length %>)</span></h3></div>
              <% if (unposted.length === 0) { %>
                <div class="empty-state"><%= t('cpt.allPosted') %></div>
              <% } else { %>
                <ul class="person-list">
                  <% unposted.slice(0, 12).forEach((i) => { %>
                    <li class="person-row">
                      <span class="person-body">
                        <span class="person-name"><%= i.label %></span>
                        <span class="cell-sub"><%= i.direction %> · <%= day(i.issue_date) %> · <%= money(i.amount_ttc) %> TTC</span>
                      </span>
                      <form method="POST" action="/comptabilite/factures/<%= i.id %>/comptabiliser">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-outline btn-sm"><%= t('cpt.post') %></button>
                      </form>
                    </li>
                  <% }) %>
                </ul>
                <p class="hint"><%= t('cpt.postingRule') %></p>
              <% } %>
            </div>

            <div class="card">
                <div class="card-head"><h3><%= t('cpt.entryJournal') %> <span class="muted">(<%= entries.length %>)</span></h3></div>
                <% if (entries.length === 0) { %>
                  <div class="empty-state"><%= t('cpt.noEntry') %></div>
                <% } else { %>
                  <ul class="meeting-list">
                    <% entries.slice(0, 25).forEach((e) => { %>
                      <li class="meeting-item">
                        <div class="meeting-head">
                          <span class="meeting-title"><%= e.label %></span>
                          <span class="tag"><%= e.journal_code %></span>
                          <%# Le numéro n'existe qu'à la validation : avant, l'écriture est au brouillard. %>
                          <% if (e.validated_at) { %>
                            <span class="tag mono"><%= t('cpt.entryNumber', { n: e.number }) %></span>
                          <% } else { %>
                            <span class="status status-warning"><%= t('cpt.draft') %></span>
                          <% } %>
                        </div>
                        <p class="cell-sub"><%= day(e.entry_date) %><%= e.reference ? ' · ' + e.reference : '' %> · <%= money(e.total_debit) %></p>
                        <div class="table-wrap">
                          <table>
                            <thead><tr><th><%= t('common.account') %></th><th><%= t('common.label') %></th><th class="num"><%= t('cpt.debit') %></th><th class="num"><%= t('common.credit') %></th></tr></thead>
                            <tbody>
                              <% linesOf(e.id).forEach((l) => { %>
                                <tr>
                                  <td class="mono"><%= l.code %></td>
                                  <td class="cell-sub"><%= l.label || l.account_label %></td>
                                  <td class="num"><%= l.debit ? money(l.debit) : '' %></td>
                                  <td class="num"><%= l.credit ? money(l.credit) : '' %></td>
                                </tr>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                        <div class="row-actions">
                          <% if (!e.validated_at) { %>
                            <form method="POST" action="/comptabilite/ecritures/<%= e.id %>/supprimer" data-confirm="<%= t('cpt.confirmDeleteEntry') %>">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
                            </form>
                          <% } else if (!e.reversed_by) { %>
                            <%# Une écriture validée ne se supprime pas : elle s'annule par son inverse. %>
                            <form method="POST" action="/comptabilite/ecritures/<%= e.id %>/contrepasser" class="inline-form">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <label class="inline-form"><span class="cell-sub"><%= t('cpt.reverseOn') %></span>
                                <input type="date" name="entry_date" value="<%= lockedUntil && today <= lockedUntil ? '' : today %>" min="<%= lockedUntil || '' %>" class="input-sm" required></label>
                              <button type="submit" class="btn btn-sm"><%= t('cpt.reverse') %></button>
                            </form>
                          <% } else { %>
                            <span class="cell-sub"><%= t('cpt.reversed') %></span>
                          <% } %>
                        </div>
                      </li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>
          </div>
        </section>

        <!-- ---------- Balance ---------- -->
        <section class="tab-panel" id="balance">
          <div class="card">
            <div class="card-head">
              <div>
                <h3><%= t('cpt.trialBalance') %> <%= year %></h3>
                <p class="card-sub"><%= t('cpt.balanceNote') %></p>
              </div>
              <div class="row-actions">
                <form method="GET" action="/comptabilite" class="inline-form">
                  <select name="annee" class="input-sm">
                    <% years.forEach((y) => { %><option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option><% }) %>
                  </select>
                  <button type="submit" class="btn btn-sm"><%= t('common.open') %></button>
                </form>
                <a href="/comptabilite/balance.csv?annee=<%= year %>" class="btn btn-outline btn-sm"><%= t('cpt.exportCsv') %></a>
              </div>
            </div>

            <% if (balance.length === 0) { %>
              <div class="empty-state"><%= t('cpt.noMovementYear') %></div>
            <% } else { %>
              <div class="table-wrap">
                <table>
                  <thead><tr><th><%= t('common.account') %></th><th><%= t('common.type') %></th><th class="num"><%= t('cpt.debit') %></th><th class="num"><%= t('common.credit') %></th><th class="num"><%= t('erp.balance') %></th></tr></thead>
                  <tbody>
                    <% balance.forEach((b) => { %>
                      <tr>
                        <td>
                          <span class="mono cell-strong"><%= b.code %></span>
                          <div class="cell-sub"><%= b.label %></div>
                        </td>
                        <td><span class="tag"><%= b.kind %></span></td>
                        <td class="num"><%= money(b.debit) %></td>
                        <td class="num"><%= money(b.credit) %></td>
                        <td class="num cell-strong"><%= money(b.balance) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <p class="hint"><%= t('cpt.exportNote') %></p>
            <% } %>
          </div>
        </section>

        <!-- ---------- Grand livre ---------- -->
        <section class="tab-panel" id="grand-livre">
          <div class="card">
            <div class="card-head">
              <div>
                <h3><%= t('cpt.tabLedger') %></h3>
                <p class="card-sub"><%= t('cpt.ledgerNote') %></p>
              </div>
              <form method="GET" action="/comptabilite" class="inline-form">
                <input type="hidden" name="annee" value="<%= year %>" />
                <select name="compte" class="input-sm">
                  <option value="">— compte —</option>
                  <% accounts.forEach((a) => { %>
                    <option value="<%= a.id %>" <%= selectedAccount && selectedAccount.id === a.id ? 'selected' : '' %>><%= a.code %> <%= a.label %></option>
                  <% }) %>
                </select>
                <button type="submit" class="btn btn-sm"><%= t('common.open') %></button>
              </form>
            </div>

            <% if (!selectedAccount) { %>
              <div class="empty-state"><%= t('cpt.chooseAccount') %></div>
            <% } else if (ledger.length === 0) { %>
              <div class="empty-state"><%= t('cpt.noMovementAccount', { year }) %></div>
            <% } else { %>
              <div class="table-wrap">
                <table>
                  <thead><tr><th><%= t('common.date') %></th><th><%= t('cpt.journal') %></th><th><%= t('common.label') %></th><th class="num"><%= t('cpt.debit') %></th><th class="num"><%= t('common.credit') %></th><th class="num"><%= t('erp.balance') %></th></tr></thead>
                  <tbody>
                    <% ledger.forEach((l) => { %>
                      <tr>
                        <td><%= day(l.entry_date) %></td>
                        <td><span class="tag"><%= l.journal_code %></span></td>
                        <td>
                          <%= l.entry_label %>
                          <% if (l.label) { %><div class="cell-sub"><%= l.label %></div><% } %>
                        </td>
                        <td class="num"><%= l.debit ? money(l.debit) : '' %></td>
                        <td class="num"><%= l.credit ? money(l.credit) : '' %></td>
                        <td class="num cell-strong"><%= money(l.running) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </section>

        <!-- ---------- Lettrage ---------- -->
        <section class="tab-panel" id="lettrage">
          <div class="card">
            <div class="card-head">
              <div>
                <h3><%= t('cpt.letteringTitle') %></h3>
                <p class="card-sub"><%= t('cpt.letteringNote') %></p>
              </div>
              <form method="GET" action="/comptabilite" class="inline-form">
                <input type="hidden" name="annee" value="<%= year %>" />
                <select name="lettrage" class="input-sm" aria-label="<%= t('cpt.letteringAccount') %>">
                  <option value="">— <%= t('cpt.letteringAccount') %> —</option>
                  <% lettrables.forEach((a) => { %>
                    <option value="<%= a.id %>" <%= compteLettrage && compteLettrage.id === a.id ? 'selected' : '' %>><%= a.code %> <%= a.label %></option>
                  <% }) %>
                </select>
                <button type="submit" class="btn btn-sm"><%= t('common.open') %></button>
              </form>
            </div>

            <% if (!compteLettrage) { %>
              <div class="empty-state"><%= t('cpt.letteringChoose') %></div>
            <% } else if (lettrage.ouvertes.length === 0) { %>
              <div class="empty-state"><%= t('cpt.letteringNothing') %></div>
            <% } else { %>
              <form method="POST" action="/comptabilite/lettrage">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="account_id" value="<%= compteLettrage.id %>" />
                <div class="table-wrap">
                  <table>
                    <thead><tr><th></th><th><%= t('common.date') %></th><th><%= t('cpt.journal') %></th><th><%= t('common.label') %></th><th class="num"><%= t('cpt.debit') %></th><th class="num"><%= t('common.credit') %></th></tr></thead>
                    <tbody>
                      <% lettrage.ouvertes.forEach((l) => { %>
                        <tr>
                          <td><input type="checkbox" name="lignes" value="<%= l.id %>" aria-label="<%= l.entry_label %>" /></td>
                          <td><%= day(l.entry_date) %></td>
                          <td><span class="tag"><%= l.journal_code %></span><% if (l.number) { %> <span class="cell-sub">n° <%= l.number %></span><% } %></td>
                          <td>
                            <%= l.entry_label %>
                            <div class="cell-sub"><%= [l.reference, l.partner_name, l.label].filter(Boolean).join(' · ') %></div>
                          </td>
                          <td class="num"><%= l.debit ? money(l.debit) : '' %></td>
                          <td class="num"><%= l.credit ? money(l.credit) : '' %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                    <tfoot><tr><td colspan="4" class="cell-strong"><%= t('cpt.letteringOpen') %></td><td colspan="2" class="num cell-strong"><%= money(lettrage.solde) %></td></tr></tfoot>
                  </table>
                </div>
                <div class="form-actions mt-m"><button type="submit" class="btn btn-primary btn-sm"><%= t('cpt.letteringSubmit') %></button></div>
              </form>
            <% } %>
          </div>

          <% if (compteLettrage && lettrage.lettrages.length) { %>
            <div class="card">
              <h3><%= t('cpt.letteringDone') %></h3>
              <div class="table-wrap">
                <table>
                  <thead><tr><th><%= t('cpt.letteringCode') %></th><th><%= t('common.date') %></th><th class="num"><%= t('cpt.letteringLines') %></th><th class="num"><%= t('erp.amount') %></th><th></th></tr></thead>
                  <tbody>
                    <% lettrage.lettrages.forEach((g) => { %>
                      <tr>
                        <td><span class="tag"><%= g.code %></span></td>
                        <td><%= day(g.date) %></td>
                        <td class="num"><%= g.lignes %></td>
                        <td class="num"><%= money(g.debit) %></td>
                        <td>
                          <form method="POST" action="/comptabilite/lettrage/retirer" data-confirm="<%= t('cpt.letteringConfirmUndo') %>">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <input type="hidden" name="account_id" value="<%= compteLettrage.id %>" />
                            <input type="hidden" name="code" value="<%= g.code %>" />
                            <button type="submit" class="btn btn-sm btn-ghost"><%= t('cpt.letteringUndo') %></button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          <% } %>
        </section>

        <!-- ---------- Clôture et FEC ---------- -->
        <section class="tab-panel" id="cloture">
          <div class="grid-2">
            <div class="card">
              <div class="card-head">
                <div>
                  <h3><%= t('cpt.closingTitle') %></h3>
                  <p class="card-sub"><%= t('cpt.closingNote') %></p>
                </div>
              </div>
              <dl class="summary-list">
                <div><dt><%= t('cpt.lockedLabel') %></dt><dd><%= lockedUntil ? day(lockedUntil) : t('cpt.notLocked') %></dd></div>
                <div><dt><%= t('cpt.draft') %></dt><dd><%= t('cpt.draftsCount', { n: drafts }) %></dd></div>
              </dl>
              <form method="POST" action="/comptabilite/valider" class="inline-form mt-m" data-confirm="<%= t('cpt.confirmValidate') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="inline-form"><span><%= t('cpt.validateUntil') %></span>
                  <input type="date" name="date" value="<%= today %>" max="<%= today %>" min="<%= lockedUntil || '' %>" required></label>
                <button type="submit" class="btn btn-primary btn-sm"><%= t('cpt.validate') %></button>
              </form>
            </div>

            <div class="card">
              <div class="card-head">
                <div>
                  <h3><%= t('cpt.openingTitle') %></h3>
                  <p class="card-sub"><%= t('cpt.openingNote') %></p>
                </div>
              </div>
              <form method="POST" action="/comptabilite/a-nouveaux" class="inline-form" data-confirm="<%= t('cpt.openingConfirm') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="inline-form"><span><%= t('cpt.openingYear') %></span>
                  <input type="number" name="annee" value="<%= Number(today.slice(0, 4)) %>" min="1900" max="9999" step="1" required class="input-sm"></label>
                <button type="submit" class="btn btn-sm"><%= t('cpt.openingSubmit') %></button>
              </form>
            </div>

            <div class="card">
              <div class="card-head">
                <div>
                  <h3><%= t('cpt.fecTitle') %></h3>
                  <p class="card-sub"><%= t('cpt.fecNote') %></p>
                </div>
              </div>
              <% if (!siren) { %>
                <div class="flash flash-info"><%= t('cpt.fecNoSiren') %></div>
              <% } %>
              <form method="GET" action="/comptabilite/fec" class="form-grid">
                <label><span><%= t('cpt.fecFrom') %></span><input type="date" name="du" value="<%= year %>-01-01" required></label>
                <label><span><%= t('cpt.fecTo') %></span><input type="date" name="au" value="<%= year %>-12-31" required></label>
                <div class="form-actions span-2">
                  <button type="submit" class="btn btn-sm"<%= siren ? '' : ' disabled' %>><%= t('cpt.fecDownload') %></button>
                </div>
              </form>
            </div>
          </div>
        </section>

        <!-- ---------- Plan comptable ---------- -->
        <section class="tab-panel" id="plan">
          <div class="grid-2">
            <div class="stack">
              <div class="card">
                <div class="card-head"><h3><%= t('cpt.addAccount') %></h3></div>
                <form method="POST" action="/comptabilite/comptes" class="stack">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <div class="form-grid">
                    <label>
                      <span><%= t('common.number') %></span>
                      <input type="text" name="code" maxlength="10" placeholder="Ex : 627" required />
                    </label>
                    <label>
                      <span><%= t('common.type') %></span>
                      <select name="kind" required>
                        <% accountKinds.forEach((k) => { %><option value="<%= k %>"><%= k %></option><% }) %>
                      </select>
                    </label>
                  </div>
                  <label>
                    <span><%= t('common.title') %></span>
                    <input type="text" name="label" maxlength="160" required />
                  </label>
                  <button type="submit" class="btn btn-primary btn-block"><%= t('common.create') %></button>
                </form>
              </div>

              <div class="card">
                <div class="card-head"><h3><%= t('cpt.addJournal') %></h3></div>
                <form method="POST" action="/comptabilite/journaux" class="stack">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <div class="form-grid">
                    <label>
                      <span><%= t('common.code') %></span>
                      <input type="text" name="code" maxlength="6" placeholder="Ex : CA" required />
                    </label>
                    <label>
                      <span><%= t('common.title') %></span>
                      <input type="text" name="label" maxlength="120" required />
                    </label>
                  </div>
                  <button type="submit" class="btn btn-primary btn-block"><%= t('common.create') %></button>
                </form>
              </div>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('cpt.tabChart') %> <span class="muted">(<%= accounts.length %>)</span></h3></div>
              <div class="table-wrap">
                <table>
                  <thead><tr><th><%= t('common.account') %></th><th><%= t('common.type') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
                  <tbody>
                    <% accounts.forEach((a) => { %>
                      <tr>
                        <td>
                          <span class="mono cell-strong"><%= a.code %></span>
                          <div class="cell-sub"><%= a.label %></div>
                        </td>
                        <td><span class="tag"><%= a.kind %></span></td>
                        <td>
                          <span class="status <%= a.active ? 'status-on' : 'status-off' %>"><%= a.active ? t('common.active') : t('common.inactive') %></span>
                        </td>
                        <td class="actions">
                          <form method="POST" action="/comptabilite/comptes/<%= a.id %>/supprimer" data-confirm="<%= t('cpt.confirmDeleteAccount') %>">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

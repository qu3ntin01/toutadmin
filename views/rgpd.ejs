<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Données personnelles — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('nav.privacy'),
      navItems: [
        { tab: 'registre', label: t('gdpr.tabRegister'), icon: 'inbox' },
        { tab: 'acces', label: t('gdpr.tabAccess'), icon: 'user' }
      ],
      footLinks: [
        { href: '/securite', label: t('nav.security'), icon: 'shield' },
        { href: '/admin', label: t('nav.adminConsole'), icon: 'back' }
      ]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('nav.privacy'),
        headerSubtitle: t('gdpr.headerSub')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const fullName = (u) => [u.first_name, u.last_name].filter(Boolean).join(' '); %>

        <!-- ---------- Registre ---------- -->
        <section class="tab-panel is-active" id="registre">
          <div class="card">
            <div class="card-head">
              <h3><%= recordList.length %> traitement(s) inscrits</h3>
              <% if (recordList.length === 0) { %>
                <form method="POST" action="/rgpd/traitements/amorcer" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-outline btn-sm"><%= t('gdpr.prefill') %></button>
                </form>
              <% } %>
            </div>
            <p class="hint">
              <%- t('gdpr.prefillNote', { software: `<em>${t('gdpr.thisSoftware')}</em>` }) %>
            </p>
          </div>

          <% recordList.forEach((r) => { %>
            <div class="card">
              <div class="card-head">
                <h3><%= r.name %></h3>
                <span class="tag tag-accent"><%= r.legal_basis %></span>
              </div>
              <table>
                <tbody>
                  <tr><td class="cell-sub"><%= t('gdpr.purpose') %></td><td><%= r.purpose || '—' %></td></tr>
                  <tr><td class="cell-sub"><%= t('gdpr.dataCategories') %></td><td><%= r.data_categories || '—' %></td></tr>
                  <tr><td class="cell-sub"><%= t('common.recipients') %></td><td><%= r.recipients || '—' %></td></tr>
                  <tr><td class="cell-sub"><%= t('gdpr.retentionPeriod') %></td><td><%= r.retention || '—' %></td></tr>
                  <tr><td class="cell-sub"><%= t('gdpr.securityMeasures') %></td><td><%= r.measures || '—' %></td></tr>
                </tbody>
              </table>
              <form method="POST" action="/rgpd/traitements/<%= r.id %>/supprimer" class="inline-form" data-confirm="<%= t('gdpr.confirmRemoveProcessing') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="btn btn-danger btn-sm"><%= t('common.remove') %></button>
              </form>
            </div>
          <% }) %>

          <div class="card">
            <div class="card-head"><h3><%= t('gdpr.addProcessing') %></h3></div>
            <form method="POST" action="/rgpd/traitements" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="span-2"><span><%= t('common.title') %></span><input type="text" name="name" required maxlength="160" /></label>
              <label class="span-2"><span><%= t('gdpr.legalBasis') %></span>
                <select name="legal_basis"><% legalBases.forEach((b) => { %><option value="<%= b %>"><%= b %></option><% }) %></select>
              </label>
              <label class="span-2"><span><%= t('gdpr.purpose') %></span><textarea name="purpose" rows="2"></textarea></label>
              <label class="span-2"><span><%= t('gdpr.dataCategories') %></span><textarea name="data_categories" rows="2"></textarea></label>
              <label class="span-2"><span><%= t('common.recipients') %></span><textarea name="recipients" rows="2"></textarea></label>
              <label><span><%= t('gdpr.retention') %></span><input type="text" name="retention" maxlength="300" /></label>
              <label><span><%= t('common.measures') %></span><input type="text" name="measures" maxlength="1000" /></label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('acc.register') %></button></div>
            </form>
          </div>
        </section>

        <!-- ---------- Droit d'accès ---------- -->
        <section class="tab-panel" id="acces">
          <% if (eraseReport) { %>
            <div class="card">
              <div class="card-head"><h3><%= t('gdpr.erasureOf', { email: eraseReport.email }) %></h3></div>
              <div class="grid-2">
                <div>
                  <p class="cell-strong"><%= t('gdpr.erased') %></p>
                  <ul class="org-list">
                    <% eraseReport.erased.forEach((e) => { %>
                      <li class="org-item"><span><%= e.label %></span><span class="cell-sub"><%= e.count %></span></li>
                    <% }) %>
                    <% if (eraseReport.erased.length === 0) { %><li class="cell-sub"><%= t('gdpr.nothingToErase') %></li><% } %>
                  </ul>
                </div>
                <div>
                  <p class="cell-strong"><%= t('gdpr.keptByObligation') %></p>
                  <ul class="org-list">
                    <% eraseReport.kept.forEach((k) => { %>
                      <li class="org-item"><span><%= k.label %></span><span class="cell-sub"><%= k.count %></span></li>
                    <% }) %>
                    <% if (eraseReport.kept.length === 0) { %><li class="cell-sub"><%= t('gdpr.nothingKept') %></li><% } %>
                  </ul>
                </div>
              </div>
            </div>
          <% } %>

          <div class="card">
            <div class="card-head"><h3><%= t('gdpr.choosePerson') %></h3></div>
            <form method="GET" action="/rgpd" class="form-grid">
              <label class="span-2"><span><%= t('common.person') %></span>
                <select name="personne" required>
                  <option value="">—</option>
                  <% people.forEach((u) => { %>
                    <option value="<%= u.id %>" <%= target && target.id === u.id ? 'selected' : '' %>>
                      <%= fullName(u) %> — <%= u.email %><%= u.active ? '' : ' (désactivé)' %>
                    </option>
                  <% }) %>
                </select>
              </label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('gdpr.seeWhatHeld') %></button></div>
            </form>
          </div>

          <% if (target) { %>
            <div class="card">
              <div class="card-head">
                <h3><%= fullName(target) %> — <%= target.email %></h3>
                <a class="btn btn-outline btn-sm" href="/rgpd/personnes/<%= target.id %>/export.json"><%= t('gdpr.exportJson') %></a>
              </div>
              <div class="table-wrap">
                <table>
                  <thead><tr><th><%= t('common.source') %></th><th><%= t('gdpr.records') %></th><th><%= t('gdpr.onErasureRequest') %></th></tr></thead>
                  <tbody>
                    <% held.forEach((s) => { %>
                      <tr>
                        <td class="cell-strong"><%= s.label %></td>
                        <td><%= s.rows.length %></td>
                        <td>
                          <span class="tag <%= s.erasable ? 'tag-success' : 'tag-warning' %>">
                            <%= s.erasable ? 'effaçable' : 'conservé par obligation' %>
                          </span>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('gdpr.eraseTitle') %></h3></div>
              <p class="hint">
                <%= t('gdpr.eraseNote') %>
              </p>
              <form method="POST" action="/rgpd/personnes/<%= target.id %>/effacer" class="form-grid"
                    data-confirm="<%= t('gdpr.confirmErase') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span><%= t('gdpr.typeToConfirm', { email: target.email }) %></span>
                  <input type="text" name="confirmation" required autocomplete="off" />
                </label>
                <div class="span-2"><button type="submit" class="btn btn-danger btn-block"><%= t('gdpr.erase') %></button></div>
              </form>
            </div>
          <% } %>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

<%
/*
 * Le code de cette instance ne s'écrit pas.
 *
 * Répété à trois endroits de l'écran — devant une version disponible, devant
 * une instance à jour, et devant le retour arrière — parce que c'est à chacun
 * de ces trois moments qu'on cherche un bouton qui n'y est pas. Dire une fois
 * en haut de page laisserait deux endroits muets.
 */
%>
<div class="banner is-warning">
  <span>
    <strong><%= t('updates.immutableTitle') %></strong><br />
    <%= t('updates.immutableBody') %>
  </span>
</div>
<pre class="code-block"><%= t('updates.immutableHow') %></pre>

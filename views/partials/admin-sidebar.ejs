<%
/* Sections de la console d'administration, en un seul endroit.
   Sur /admin elles pilotent les onglets ; sur les pages d'édition elles y ramènent.
   Attend : asLinks? (booléen), active? (nom de section) */
const adminSections = [
  { tab: 'personnel', label: t('nav.personnel'), icon: 'users' },
  { tab: 'organisation', label: t('nav.organisation'), icon: 'network' },
  { tab: 'outils', label: t('nav.tools'), icon: 'tool' },
  { tab: 'affectations', label: t('nav.assignments'), icon: 'link' },
  { tab: 'actualites', label: t('nav.news'), icon: 'megaphone' },
  { tab: 'modules', label: t('nav.modules'), icon: 'plus' },
  { tab: 'apparence', label: t('nav.appearance'), icon: 'settings' },
  {
    tab: 'rh',
    label: t('nav.hr'),
    icon: 'shield',
    // Le compteur n'est calculé que sur la console elle-même.
    badge: typeof pendingRequestCount !== 'undefined' ? pendingRequestCount : 0,
  },
];
const adminAsLinks = typeof asLinks !== 'undefined' && asLinks;
const adminActive = typeof active !== 'undefined' ? active : null;
%>
<%- include('sidebar', {
  panelLabel: t('common.adminRole'),
  navItems: adminAsLinks
    ? adminSections.map((s) => ({ href: '/admin#' + s.tab, label: s.label, icon: s.icon, badge: s.badge, active: s.tab === adminActive }))
    : adminSections,
  // Un administrateur n'a pas d'espace membre : /mon-espace le renverrait ici.
  footLinks: [
    { href: '/pilotage', label: t('nav.steering'), icon: 'home' },
    { href: '/direction', label: t('nav.governance'), icon: 'ballot' },
    { href: '/planning', label: t('nav.planning'), icon: 'clock' },
    { href: '/qualite', label: t('nav.quality'), icon: 'check' },
    { href: '/accueil', label: t('nav.frontDesk'), icon: 'inbox' },
    { href: '/import', label: t('nav.dataImport'), icon: 'plus' },
    { href: '/parapheur', label: t('nav.signing'), icon: 'check' },
    { href: '/integrations', label: t('nav.integrations'), icon: 'link' },
    { href: '/demandes', label: t('nav.internalRequests'), icon: 'ballot' },
    { href: '/pieces', label: t('nav.intake'), icon: 'inbox' },
    { href: '/organigramme', label: t('nav.orgChart'), icon: 'network' },
    { href: '/projets', label: t('nav.projects'), icon: 'briefcase' },
    { href: '/support', label: t('nav.support'), icon: 'lifebuoy' },
    { href: '/base-de-connaissances', label: t('nav.knowledge'), icon: 'inbox' },
    { href: '/informatique', label: t('nav.it'), icon: 'shield' },
    { href: '/developpement', label: t('nav.development'), icon: 'tool' },
    { href: '/evenements', label: t('nav.events'), icon: 'calendar' },
    { href: '/securite', label: t('nav.security'), icon: 'shield' },
    { href: '/sauvegardes', label: t('nav.backups'), icon: 'inbox' },
    { href: '/rgpd', label: t('nav.privacy'), icon: 'user' },
    { href: '/rh', label: t('nav.openHrSpace'), icon: 'external' },
    { href: '/gestion', label: t('nav.gestion'), icon: 'briefcase' }
  ]
}) %>

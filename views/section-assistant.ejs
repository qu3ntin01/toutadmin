<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>"<%- railAttrs %>>
<head>
  <%- include('partials/head', { title: t('sec.wizard.title', { section: t(groupe.titre) }) + ' — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/admin-sidebar', { asLinks: true }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('sec.wizard.title', { section: t(groupe.titre) }),
        headerSubtitle: t('sec.wizard.sub')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>

        <%# Les trois temps, montrés du premier au dernier : on sait où l'on en
            est et combien il en reste. Un assistant qui ne le dit pas donne
            l'impression de ne jamais finir. %>
        <ol class="wizard-steps">
          <% etapes.forEach((nom, index) => { %>
            <li class="wizard-step <%= index === etapeIndex ? 'is-active' : (index < etapeIndex ? 'is-done' : '') %>">
              <span class="wizard-num"><%= index + 1 %></span>
              <span class="wizard-name"><%= t('sec.wizard.step.' + nom) %></span>
            </li>
          <% }) %>
        </ol>

        <% if (etape === 'decouverte') { %>
          <div class="card">
            <div class="card-head"><h2><%= t('sec.wizard.whatIs', { section: t(groupe.titre) }) %></h2></div>
            <p class="hint"><%= t('sec.' + groupe.cle + '.intro') %></p>
            <div class="tiles">
              <% services.forEach((service) => { %>
                <span class="tile is-static">
                  <span class="tile-icon"><%- include('partials/icon', { name: service.icone, iconSize: 20 }) %></span>
                  <span class="tile-text">
                    <span class="tile-name"><%= t(service.titre) %></span>
                    <span class="tile-what"><%= t(service.quoi) %></span>
                  </span>
                </span>
              <% }) %>
            </div>
            <div class="form-actions">
              <a class="btn btn-primary" href="/section/<%= groupe.cle %>/assistant?etape=reglages"><%= t('sec.wizard.next') %></a>
            </div>
          </div>

        <% } else if (etape === 'reglages') { %>
          <div class="card">
            <div class="card-head"><h2><%= t('sec.wizard.settings') %></h2></div>
            <p class="hint"><%= t('sec.wizard.settingsHelp') %></p>
            <form method="POST" action="/section/<%= groupe.cle %>/assistant" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <%- include('partials/champs-section', { groupe, champs }) %>
              <div class="span-2 form-actions">
                <a class="btn" href="/section/<%= groupe.cle %>/assistant?etape=decouverte"><%= t('common.back') %></a>
                <button type="submit" class="btn btn-primary"><%= t('sec.wizard.finish') %></button>
              </div>
            </form>
          </div>

          <%# « Garder les valeurs par défaut » est une réponse, pas un abandon :
              la section est marquée configurée et l'assistant ne revient plus. %>
          <div class="card">
            <div class="card-head"><h3><%= t('sec.wizard.skipTitle') %></h3></div>
            <p class="hint"><%= t('sec.wizard.skipHelp') %></p>
            <form method="POST" action="/section/<%= groupe.cle %>/assistant">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="passer" value="1" />
              <button type="submit" class="btn"><%= t('sec.wizard.skip') %></button>
            </form>
          </div>

        <% } else { %>
          <div class="card">
            <div class="card-head"><h2><%= t('sec.wizard.done', { section: t(groupe.titre) }) %></h2></div>
            <p class="hint"><%= t('sec.wizard.doneHelp') %></p>
            <dl class="recap">
              <% champs.forEach((champ) => { %>
                <div class="recap-row">
                  <dt><%= t('sec.' + groupe.cle + '.' + champ.cle) %></dt>
                  <dd>
                    <% if (champ.type === 'bool') { %>
                      <%= champ.valeur === '1' ? t('common.yes') : t('common.no') %>
                    <% } else if (champ.type === 'mois') { %>
                      <%= new Date(Date.UTC(2000, Number(champ.valeur) - 1, 1)).toLocaleDateString(locale, { month: 'long' }) %>
                    <% } else if (champ.type === 'choix') { %>
                      <% const choisi = (champ.options || []).find((o) => o.valeur === champ.valeur); %>
                      <%= choisi ? (choisi.libelle || t('sec.' + groupe.cle + '.' + champ.cle + '.' + choisi.valeur)) : champ.valeur %>
                    <% } else { %>
                      <%= champ.valeur %>
                    <% } %>
                  </dd>
                </div>
              <% }) %>
            </dl>
            <div class="form-actions">
              <a class="btn btn-primary" href="/section/<%= groupe.cle %>"><%= t('sec.wizard.open', { section: t(groupe.titre) }) %></a>
              <a class="btn" href="/section/<%= groupe.cle %>/reglages"><%= t('sec.settings.title') %></a>
            </div>
          </div>
        <% } %>
      </main>
    </div>
  </div>
  <script src="<%= asset('/js/theme.js') %>"></script>
</body>
</html>

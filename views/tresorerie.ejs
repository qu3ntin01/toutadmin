<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Trésorerie — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('tre.panel'),
      navItems: [
        { tab: 'comptes', label: t('tre.tabAccounts'), icon: 'card' },
        { tab: 'mouvements', label: t('common.movements'), icon: 'inbox' },
        { tab: 'rapprochement', label: t('tre.tabReconcile'), icon: 'link', badge: pending.length },
        { tab: 'previsions', label: t('tre.tabForecast'), icon: 'calendar' }
      ],
      footLinks: [{ href: '/gestion', label: t('nav.gestion'), icon: 'back' }]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('tre.panel'),
        headerSubtitle: t('tre.headerSub')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const money = (n) => (n == null ? '—' : Number(n).toLocaleString(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'); %>
        <% const day = (iso) => (iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'card', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value <%= total < 0 ? 'text-danger' : '' %>"><%= money(total) %></span><span class="stat-label"><%= t('tre.consolidated') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'calendar', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value <%= projection.end < 0 ? 'text-danger' : '' %>"><%= money(projection.end) %></span><span class="stat-label"><%= t('tre.projected12') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clock', iconSize: 18 }) %></span>
            <span class="stat-body">
              <span class="stat-value <%= projection.lowest.balance < 0 ? 'text-danger' : '' %>"><%= money(projection.lowest.balance) %></span>
              <span class="stat-label"><%= projection.lowest.on_date ? t('tre.lowPointOn', { date: day(projection.lowest.on_date) }) : t('tre.lowPointToday') %></span>
            </span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'link', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= pending.length %></span><span class="stat-label"><%= t('tre.unreconciled') %></span></span>
          </div>
        </section>

        <!-- ---------- Comptes ---------- -->
        <section class="tab-panel is-active" id="comptes">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('cpt.addAccount') %></h3></div>
              <form method="POST" action="/tresorerie/comptes" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2"><span><%= t('common.title') %></span><input type="text" name="label" required maxlength="120" placeholder="<%= t('tre.accountPlaceholder') %>" /></label>
                <label><span><%= t('tre.bank') %></span><input type="text" name="bank" maxlength="80" /></label>
                <label><span>4 derniers chiffres</span><input type="text" name="iban_last4" maxlength="4" inputmode="numeric" /></label>
                <label class="span-2"><span><%= t('tre.openingBalance') %></span><input type="text" name="opening_balance" inputmode="decimal" placeholder="0" /></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.add') %></button></div>
              </form>
              <p class="hint"><%= t('tre.ibanNote') %></p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= accountList.length %> compte(s)</h3></div>
              <ul class="org-list">
                <% accountList.forEach((a) => { %>
                  <li class="org-item">
                    <span>
                      <span class="cell-strong"><%= a.label %></span>
                      <br /><span class="cell-sub"><%= a.bank || '—' %><%= a.iban_last4 ? ' ····' + a.iban_last4 : '' %></span>
                    </span>
                    <span>
                      <span class="cell-strong <%= a.balance < 0 ? 'text-danger' : '' %>"><%= money(a.balance) %></span>
                      <span class="row-actions">
                        <form method="POST" action="/tresorerie/comptes/<%= a.id %>/cloturer" class="inline-form">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit" class="btn btn-outline btn-sm"><%= t('tre.close') %></button>
                        </form>
                        <form method="POST" action="/tresorerie/comptes/<%= a.id %>/supprimer" class="inline-form" data-confirm="<%= t('tre.confirmDeleteAccount') %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
                        </form>
                      </span>
                    </span>
                  </li>
                <% }) %>
                <% if (accountList.length === 0) { %><li class="cell-sub"><%= t('tre.noAccount') %></li><% } %>
              </ul>
            </div>
          </div>
        </section>

        <!-- ---------- Mouvements ---------- -->
        <section class="tab-panel" id="mouvements">
          <div class="card">
            <div class="card-head"><h3><%= t('tre.newMovement') %></h3></div>
            <form method="POST" action="/tresorerie/mouvements" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label><span><%= t('common.account') %></span>
                <select name="account_id" required>
                  <% accountList.forEach((a) => { %><option value="<%= a.id %>"><%= a.label %></option><% }) %>
                </select>
              </label>
              <label><span><%= t('tre.valueDate') %></span><input type="date" name="value_date" value="<%= today %>" required /></label>
              <label class="span-2"><span><%= t('common.label') %></span><input type="text" name="label" required maxlength="160" /></label>
              <label><span><%= t('tre.amountEuro') %></span><input type="text" name="amount" inputmode="decimal" required placeholder="-1250,00" /></label>
              <label><span><%= t('common.category') %></span><input type="text" name="category" maxlength="60" placeholder="<%= t('tre.movementPlaceholder') %>" /></label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.save') %></button></div>
            </form>
            <p class="hint"><%= t('tre.signNote') %></p>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('stk.lastMovements') %></h3></div>
            <div class="table-wrap">
              <table>
                <thead><tr><th><%= t('common.date') %></th><th><%= t('common.account') %></th><th><%= t('common.label') %></th><th><%= t('common.category') %></th><th><%= t('erp.amount') %></th><th><%= t('tre.reconciled') %></th><th></th></tr></thead>
                <tbody>
                  <% movements.forEach((m) => { %>
                    <tr>
                      <td class="cell-sub nowrap"><%= day(m.value_date) %></td>
                      <td class="cell-sub"><%= m.account_label %></td>
                      <td class="cell-strong"><%= m.label %></td>
                      <td class="cell-sub"><%= m.category || '—' %></td>
                      <td class="cell-strong <%= m.amount < 0 ? 'text-danger' : '' %>"><%= money(m.amount) %></td>
                      <td class="cell-sub"><%= m.invoice_reference || (m.claim_id ? 'note de frais' : '—') %></td>
                      <td>
                        <form method="POST" action="/tresorerie/mouvements/<%= m.id %>/supprimer" class="inline-form" data-confirm="<%= t('tre.confirmDeleteMovement') %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (movements.length === 0) { %><tr><td colspan="7" class="cell-sub"><%= t('stk.noMovement') %></td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ---------- Rapprochement ---------- -->
        <section class="tab-panel" id="rapprochement">
          <div class="card">
            <div class="card-head"><h3><%= t('tre.toReconcileCount', { count: pending.length }) %></h3></div>
            <p class="hint"><%= t('tre.reconcileNote') %></p>
            <ul class="org-list">
              <% pending.forEach((m) => { %>
                <li class="org-item">
                  <span>
                    <span class="cell-strong"><%= m.label %></span>
                    <br /><span class="cell-sub"><%= day(m.value_date) %> · <%= m.account_label %> · <%= money(m.amount) %></span>
                  </span>
                  <form method="POST" action="/tresorerie/mouvements/<%= m.id %>/rapprocher" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <select name="invoice_id" class="input-sm" required>
                      <option value="">— facture</option>
                      <% openInvoices.forEach((i) => { %>
                        <option value="<%= i.id %>"><%= i.reference || i.label %> · <%= i.direction %> · <%= money(i.amount_ht * (1 + i.vat_rate / 100)) %></option>
                      <% }) %>
                    </select>
                    <button type="submit" class="btn btn-outline btn-sm"><%= t('tre.reconcile') %></button>
                  </form>
                </li>
              <% }) %>
              <% if (pending.length === 0) { %><li class="cell-sub"><%= t('tre.allReconciled') %></li><% } %>
            </ul>
          </div>
        </section>

        <!-- ---------- Prévisionnel ---------- -->
        <section class="tab-panel" id="previsions">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('tre.addDue') %></h3></div>
              <form method="POST" action="/tresorerie/previsions" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2"><span><%= t('common.label') %></span><input type="text" name="label" required maxlength="160" placeholder="<%= t('tre.duePlaceholder') %>" /></label>
                <label><span><%= t('tre.expectedOn') %></span><input type="date" name="expected_on" required /></label>
                <label><span><%= t('tre.amountEuro') %></span><input type="text" name="amount" inputmode="decimal" required /></label>
                <label class="span-2"><span><%= t('tre.certainty') %></span>
                  <select name="certainty"><% certainties.forEach((c) => { %><option value="<%= c %>" <%= c === 'Probable' ? 'selected' : '' %>><%= c %></option><% }) %></select>
                </label>
                <label class="span-2"><span><%= t('common.note') %></span><input type="text" name="note" maxlength="300" /></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.add') %></button></div>
              </form>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('tre.dueList') %></h3></div>
              <ul class="org-list">
                <% forecastList.forEach((f) => { %>
                  <li class="org-item">
                    <span>
                      <span class="cell-strong"><%= f.label %></span>
                      <span class="tag"><%= f.certainty %></span>
                      <br /><span class="cell-sub"><%= day(f.expected_on) %> · <%= money(f.amount) %></span>
                    </span>
                    <form method="POST" action="/tresorerie/previsions/<%= f.id %>/supprimer" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-danger btn-sm"><%= t('common.remove') %></button>
                    </form>
                  </li>
                <% }) %>
                <% if (forecastList.length === 0) { %><li class="cell-sub"><%= t('tre.noDue') %></li><% } %>
              </ul>
            </div>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('tre.projection') %></h3></div>
            <p class="hint"><%= t('tre.projectionNote', { start: money(projection.start) }) %></p>
            <div class="table-wrap">
              <table>
                <thead><tr><th><%= t('common.date') %></th><th><%= t('common.origin') %></th><th><%= t('common.label') %></th><th><%= t('erp.amount') %></th><th><%= t('tre.projectedBalance') %></th></tr></thead>
                <tbody>
                  <% projection.points.forEach((p) => { %>
                    <tr>
                      <td class="cell-sub nowrap"><%= day(p.on_date) %></td>
                      <td><span class="tag"><%= p.origin %></span></td>
                      <td><%= p.label %></td>
                      <td class="<%= p.amount < 0 ? 'text-danger' : '' %>"><%= money(p.amount) %></td>
                      <td class="cell-strong <%= p.balance < 0 ? 'text-danger' : '' %>"><%= money(p.balance) %></td>
                    </tr>
                  <% }) %>
                  <% if (projection.points.length === 0) { %><tr><td colspan="5" class="cell-sub"><%= t('tre.nothingPlanned') %></td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

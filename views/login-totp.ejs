<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Vérification — ' + t('app.name') }) %>
</head>
<body class="auth-body">
  <header class="auth-top">
    <div class="auth-brand">
      <span class="brand-mark"><%= brandInitials %></span>
      <span class="brand-text">
        <span class="brand-name"><%= companyName %></span>
        <span class="brand-panel"><%= t('app.portal') %></span>
      </span>
    </div>
    <%- include('partials/theme-toggle') %>
  </header>

  <main class="auth-main">
    <div class="auth-card">
      <h1>Vérification en deux étapes</h1>
      <p class="auth-sub">Saisissez le code affiché par votre application d'authentification.</p>

      <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <form method="POST" action="/connexion/code" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>
          <span>Code à 6 chiffres</span>
          <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code"
                 pattern="[0-9A-Za-z-]{6,11}" maxlength="11" required autofocus />
        </label>
        <button type="submit" class="btn btn-primary btn-block">Valider</button>
      </form>

      <p class="auth-note">
        Téléphone perdu ? Saisissez ici l'un de vos codes de secours, à usage unique.
      </p>

      <div class="auth-foot">
        <a href="/connexion">Revenir à la connexion</a>
      </div>
    </div>
  </main>
</body>
</html>

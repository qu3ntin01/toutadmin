<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Support — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('nav.support'),
      navItems: [
        { tab: 'tickets', label: isAgent ? 'File des tickets' : 'Mes tickets', icon: 'lifebuoy' },
        { tab: 'nouveau', label: t('sup.tabOpen'), icon: 'plus' },
        { tab: 'a-moi', label: t('sup.tabAssigned'), icon: 'check', badge: assigned.length }
      ],
      footLinks: [
        { href: '/base-de-connaissances', label: t('sup.tabKb'), icon: 'inbox' },
        { href: currentUser.role === 'admin' ? '/admin' : '/mon-espace', label: t('common.back'), icon: 'back' }
      ]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('nav.support'),
        headerSubtitle: t('sup.headerSub')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>

        <% const moment = (iso) => (iso ? new Date(iso.replace(' ', 'T') + (iso.endsWith('Z') ? '' : 'Z')).toLocaleString(locale, { timeZone: 'UTC' }) : '—'); %>
        <% const priorityTag = (p) => ['Haute','Critique'].includes(p) ? 'tag-danger' : ''; %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'lifebuoy', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= summary.open %></span><span class="stat-label"><%= t('pil.openTickets') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clock', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= summary.overdue %></span><span class="stat-label"><%= t('sup.overdue') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'user', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= summary.unassigned %></span><span class="stat-label"><%= t('sup.noAssignee') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'check', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= summary.closedThisMonth %></span><span class="stat-label"><%= t('sup.closedThisMonth') %></span></span>
          </div>
        </section>

        <!-- ---------- File ---------- -->
        <section class="tab-panel is-active" id="tickets">
          <div class="card">
            <div class="card-head"><h3><%= tickets.length %> ticket(s)</h3></div>
            <form method="GET" action="/support" class="form-grid">
              <label><span><%= t('common.status') %></span>
                <select name="statut"><option value=""><%= t('sup.all') %></option>
                  <% statuses.forEach((s) => { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
                </select>
              </label>
              <label><span><%= t('common.category') %></span>
                <select name="categorie"><option value=""><%= t('hr.filterAll') %></option>
                  <% categories.forEach((c) => { %><option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
                </select>
              </label>
              <label class="check-row span-2">
                <input type="checkbox" name="tous" value="1" <%= filters.openOnly ? '' : 'checked' %> />
                <span><%= t('sup.includeClosed') %></span>
              </label>
              <div class="span-2"><button type="submit" class="btn btn-outline btn-block"><%= t('common.filter') %></button></div>
            </form>
          </div>

          <div class="card">
            <div class="table-wrap">
              <table>
                <thead><tr><th><%= t('gov.reference') %></th><th><%= t('common.subject') %></th><th><%= t('common.requester') %></th><th><%= t('common.priority') %></th><th><%= t('common.status') %></th><th><%= t('sup.handledBy') %></th><th><%= t('sup.deadline') %></th></tr></thead>
                <tbody>
                  <% tickets.forEach((tk) => { %>
                    <tr>
                      <td class="cell-sub nowrap"><a href="/support/tickets/<%= tk.id %>"><%= tk.reference %></a></td>
                      <td>
                        <a class="cell-strong" href="/support/tickets/<%= tk.id %>"><%= tk.subject %></a>
                        <br /><span class="cell-sub"><%= tk.category %><%= tk.partner_name ? ' · ' + tk.partner_name : '' %> · <%= tk.message_count %> message(s)</span>
                      </td>
                      <td class="cell-sub"><%= tk.requester_first_name ? tk.requester_first_name + ' ' + tk.requester_last_name : '—' %></td>
                      <td><span class="tag <%= priorityTag(tk.priority) %>"><%= tk.priority %></span></td>
                      <td><span class="tag <%= tk.status === 'Ouvert' ? 'tag-accent' : '' %>"><%= st(tk.status) %></span></td>
                      <td class="cell-sub"><%= tk.assignee_first_name ? tk.assignee_first_name + ' ' + tk.assignee_last_name : '—' %></td>
                      <td class="<%= tk.overdue ? 'text-danger' : 'cell-sub' %> nowrap">
                        <%= tk.first_reply_at ? 'répondu' : moment(tk.due_at) %>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (tickets.length === 0) { %><tr><td colspan="7" class="cell-sub"><%= t('sup.noTicket') %></td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ---------- Nouveau ---------- -->
        <section class="tab-panel" id="nouveau">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('sup.tabOpen') %></h3></div>
              <form method="POST" action="/support/tickets" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2"><span><%= t('common.subject') %></span><input type="text" name="subject" required maxlength="200" /></label>
                <label><span><%= t('common.category') %></span>
                  <select name="category" required><% categories.forEach((c) => { %><option value="<%= c %>"><%= c %></option><% }) %></select>
                </label>
                <label><span><%= t('common.priority') %></span>
                  <select name="priority" required><% priorities.forEach((p) => { %><option value="<%= p %>" <%= p === 'Normale' ? 'selected' : '' %>><%= p %></option><% }) %></select>
                </label>
                <% if (isAgent) { %>
                  <label><span><%= t('common.origin') %></span>
                    <select name="origin"><% origins.forEach((o) => { %><option value="<%= o %>"><%= o %></option><% }) %></select>
                  </label>
                  <label><span><%= t('sup.clientConcerned') %></span>
                    <select name="partner_id"><option value="">—</option>
                      <% partners.forEach((p) => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
                    </select>
                  </label>
                <% } %>
                <label class="span-2"><span><%= t('common.description') %></span><textarea name="body" rows="5" placeholder="<%= t('sup.ticketPlaceholder') %>"></textarea></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.open') %></button></div>
              </form>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('sup.responseTimes') %></h3></div>
              <p class="hint"><%= t('sup.priorityNote') %></p>
              <ul class="org-list">
                <% priorities.forEach((p) => { %>
                  <li class="org-item">
                    <span class="cell-strong"><%= p %></span>
                    <span class="cell-sub"><%= responseHours[p] %> h</span>
                  </li>
                <% }) %>
              </ul>
            </div>
          </div>
        </section>

        <!-- ---------- Affectés ---------- -->
        <section class="tab-panel" id="a-moi">
          <div class="card">
            <div class="card-head"><h3><%= isAgent ? assigned.length + ' ticket(s) à traiter' : 'Mes demandes' %></h3></div>
            <div class="table-wrap">
              <table>
                <thead><tr><th><%= t('gov.reference') %></th><th><%= t('common.subject') %></th><th><%= t('common.priority') %></th><th><%= t('common.status') %></th></tr></thead>
                <tbody>
                  <% (isAgent ? assigned : mine).forEach((tk) => { %>
                    <tr>
                      <td class="cell-sub"><a href="/support/tickets/<%= tk.id %>"><%= tk.reference %></a></td>
                      <td class="cell-strong"><%= tk.subject %></td>
                      <td><span class="tag <%= priorityTag(tk.priority) %>"><%= tk.priority %></span></td>
                      <td><span class="tag"><%= st(tk.status) %></span></td>
                    </tr>
                  <% }) %>
                  <% if ((isAgent ? assigned : mine).length === 0) { %><tr><td colspan="4" class="cell-sub"><%= t('sup.nothingYet') %></td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

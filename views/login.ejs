<!doctype html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Connexion — Private Member' }) %>
</head>
<body class="auth-body">
  <header class="auth-top">
    <div class="auth-brand">
      <span class="brand-mark">PM</span>
      <span class="brand-text">
        <span class="brand-name">Private Member</span>
        <span class="brand-panel">Portail interne</span>
      </span>
    </div>
    <%- include('partials/theme-toggle') %>
  </header>

  <main class="auth-main">
    <div class="auth-card">
      <h1>Connexion</h1>
      <p class="auth-sub">Accédez à votre espace personnel, RH ou d'administration.</p>

      <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <form method="POST" action="/connexion" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>
          <span>Adresse email</span>
          <input type="email" name="email" placeholder="vous@entreprise.com" required autofocus autocomplete="username" />
        </label>
        <label>
          <span>Mot de passe</span>
          <input type="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
        </label>
        <button type="submit" class="btn btn-primary btn-block">Se connecter</button>
      </form>

      <p class="auth-foot">
        Accès réservé au personnel autorisé. Les tentatives de connexion sont limitées et
        le compte se verrouille temporairement après plusieurs échecs.
      </p>
    </div>
  </main>

  <script src="/js/theme.js"></script>
</body>
</html>

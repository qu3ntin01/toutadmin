<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: service.name + ' — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('dvp.panel'),
      navItems: [
        { tab: 'fiche', label: t('dvp.sheet'), icon: 'network' },
        { tab: 'livraisons', label: t('dvp.tabReleases'), icon: 'check', badge: releaseList.length },
        { tab: 'incidents', label: t('inf.tabIncidents'), icon: 'lifebuoy', badge: service.open_incidents }
      ],
      footLinks: [{ href: '/developpement', label: t('nav.development'), icon: 'back' }]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: service.name,
        headerSubtitle: t('dvp.sheetSub')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const day = (iso) => (iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>
        <% const moment = (value) => (value ? new Date(value.replace(' ', 'T') + 'Z').toLocaleString(locale, { timeZone: 'UTC', dateStyle: 'short', timeStyle: 'short' }) : '—'); %>
        <% const spell = (minutes) => (minutes == null ? '—' : (minutes < 90 ? t('inf.minutes', { count: minutes }) : t('inf.hours', { count: Math.round(minutes / 6) / 10 }))); %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'check', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= service.live_version || '—' %></span><span class="stat-label"><%= t('dvp.liveVersion') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clock', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= day(service.live_since) %></span><span class="stat-label"><%= t('dvp.liveSince') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'lifebuoy', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= service.open_incidents %></span><span class="stat-label"><%= t('inf.openIncidents') %></span></span>
          </div>
        </section>

        <section class="tab-panel is-active" id="fiche">
          <div class="card">
            <div class="card-head">
              <h3><%= t('dvp.sheet') %></h3>
              <form method="POST" action="/developpement/services/<%= service.id %>/supprimer" data-confirm="<%= t('dvp.confirmDeleteService') %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="btn btn-sm btn-danger"><%= t('common.delete') %></button>
              </form>
            </div>
            <% if (service.repository || service.documentation) { %>
              <p class="card-sub">
                <% if (service.repository) { %><a href="<%= service.repository %>" rel="noreferrer noopener"><%= t('dvp.repository') %></a><% } %>
                <% if (service.repository && service.documentation) { %> · <% } %>
                <% if (service.documentation) { %><a href="<%= service.documentation %>" rel="noreferrer noopener"><%= t('dvp.documentation') %></a><% } %>
              </p>
            <% } %>
            <form method="POST" action="/developpement/services/<%= service.id %>/modifier" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label><span><%= t('dvp.service') %></span><input type="text" name="name" value="<%= service.name %>" required maxlength="120" /></label>
              <label><span><%= t('dvp.code') %></span><input type="text" name="code" value="<%= service.code %>" maxlength="30" /></label>
              <label><span><%= t('dvp.stack') %></span><input type="text" name="stack" value="<%= service.stack %>" maxlength="120" /></label>
              <label><span><%= t('dvp.criticality') %></span>
                <select name="criticality"><% criticalities.forEach((c) => { %><option value="<%= c %>" <%= service.criticality === c ? 'selected' : '' %>><%= st(c) %></option><% }) %></select>
              </label>
              <label><span><%= t('dvp.repository') %></span><input type="url" name="repository" value="<%= service.repository %>" maxlength="300" /></label>
              <label><span><%= t('dvp.documentation') %></span><input type="url" name="documentation" value="<%= service.documentation %>" maxlength="300" /></label>
              <label><span><%= t('dvp.lead') %></span>
                <select name="lead_id"><option value="">—</option>
                  <% employees.forEach((u) => { %><option value="<%= u.id %>" <%= service.lead_id === u.id ? 'selected' : '' %>><%= u.first_name %> <%= u.last_name %></option><% }) %>
                </select>
              </label>
              <label><span><%= t('nav.projects') %></span>
                <select name="project_id"><option value="">—</option>
                  <% projectList.forEach((p) => { %><option value="<%= p.id %>" <%= service.project_id === p.id ? 'selected' : '' %>><%= p.name %></option><% }) %>
                </select>
              </label>
              <label><span><%= t('common.status') %></span>
                <select name="status"><% statuses.forEach((s) => { %><option value="<%= s %>" <%= service.status === s ? 'selected' : '' %>><%= st(s) %></option><% }) %></select>
              </label>
              <label class="span-2"><span><%= t('common.description') %></span><textarea name="description" rows="3" maxlength="1000"><%= service.description %></textarea></label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.save') %></button></div>
            </form>
          </div>
        </section>

        <section class="tab-panel" id="livraisons">
          <div class="card">
            <div class="card-head"><h3><%= t('dvp.addRelease') %></h3></div>
            <form method="POST" action="/developpement/services/<%= service.id %>/livraisons" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label><span><%= t('dvp.version') %></span><input type="text" name="version" required maxlength="40" placeholder="1.4.0" /></label>
              <label><span><%= t('dvp.environment') %></span>
                <select name="environment"><% environments.forEach((e) => { %><option value="<%= e %>" <%= e === 'Production' ? 'selected' : '' %>><%= st(e) %></option><% }) %></select>
              </label>
              <label><span><%= t('dvp.plannedOn') %></span><input type="date" name="planned_on" /></label>
              <label><span><%= t('dvp.releasedOn') %></span><input type="date" name="released_on" /></label>
              <label class="span-2"><span><%= t('common.status') %></span>
                <select name="status"><% releaseStatuses.forEach((s) => { %><option value="<%= s %>" <%= s === 'Livrée' ? 'selected' : '' %>><%= st(s) %></option><% }) %></select>
              </label>
              <label class="span-2"><span><%= t('dvp.changelog') %></span><textarea name="changelog" rows="3" maxlength="2000"></textarea></label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.save') %></button></div>
            </form>
          </div>

          <% releaseList.forEach((release) => { %>
            <div class="card">
              <div class="card-head">
                <div>
                  <h3><%= release.version %> <span class="tag"><%= st(release.environment) %></span>
                    <span class="tag <%= release.status === 'Livrée' ? 'tag-success' : (release.status === 'Planifiée' ? '' : 'tag-danger') %>"><%= st(release.status) %></span>
                  </h3>
                  <p class="card-sub">
                    <%= day(release.released_on || release.planned_on) %>
                    <% if (release.first_name) { %> · <%= release.first_name %> <%= release.last_name %><% } %>
                    <% if (release.incident_title) { %> · <%= t('dvp.linkedIncident', { title: release.incident_title }) %><% } %>
                  </p>
                </div>
                <form method="POST" action="/developpement/livraisons/<%= release.id %>/supprimer" data-confirm="<%= t('dvp.confirmDeleteRelease') %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-sm btn-danger"><%= t('common.delete') %></button>
                </form>
              </div>
              <form method="POST" action="/developpement/livraisons/<%= release.id %>/modifier" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label><span><%= t('dvp.version') %></span><input type="text" name="version" value="<%= release.version %>" maxlength="40" /></label>
                <label><span><%= t('dvp.environment') %></span>
                  <select name="environment"><% environments.forEach((e) => { %><option value="<%= e %>" <%= release.environment === e ? 'selected' : '' %>><%= st(e) %></option><% }) %></select>
                </label>
                <label><span><%= t('dvp.plannedOn') %></span><input type="date" name="planned_on" value="<%= release.planned_on || '' %>" /></label>
                <label><span><%= t('dvp.releasedOn') %></span><input type="date" name="released_on" value="<%= release.released_on || '' %>" /></label>
                <label><span><%= t('common.status') %></span>
                  <select name="status"><% releaseStatuses.forEach((s) => { %><option value="<%= s %>" <%= release.status === s ? 'selected' : '' %>><%= st(s) %></option><% }) %></select>
                </label>
                <label><span><%= t('dvp.linkIncident') %></span>
                  <select name="incident_id"><option value="">—</option>
                    <% incidentList.forEach((i) => { %><option value="<%= i.id %>" <%= release.incident_id === i.id ? 'selected' : '' %>><%= i.title %></option><% }) %>
                  </select>
                </label>
                <label class="span-2"><span><%= t('dvp.changelog') %></span><textarea name="changelog" rows="3" maxlength="2000"><%= release.changelog %></textarea></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.save') %></button></div>
              </form>
            </div>
          <% }) %>
          <% if (releaseList.length === 0) { %><div class="card"><div class="empty-state"><%= t('dvp.noRelease') %></div></div><% } %>
        </section>

        <section class="tab-panel" id="incidents">
          <div class="card">
            <div class="card-head">
              <h3><%= t('dvp.serviceIncidents', { count: incidentList.length }) %></h3>
              <a class="btn btn-outline btn-sm" href="/informatique#incidents"><%= t('dvp.manageIncidents') %></a>
            </div>
            <div class="table-wrap">
              <table>
                <thead><tr>
                  <th><%= t('common.title') %></th><th><%= t('inf.severity') %></th><th><%= t('inf.startedAt') %></th>
                  <th><%= t('inf.downtime') %></th><th><%= t('common.status') %></th>
                </tr></thead>
                <tbody>
                  <% incidentList.forEach((incident) => { %>
                    <tr>
                      <td class="cell-strong"><%= incident.title %></td>
                      <td><span class="tag <%= incident.severity === 'Critique' ? 'tag-danger' : '' %>"><%= st(incident.severity) %></span></td>
                      <td class="cell-sub nowrap"><%= moment(incident.started_at) %></td>
                      <td class="cell-sub nowrap"><%= spell(downtime(incident)) %></td>
                      <td><span class="tag"><%= st(incident.status) %></span></td>
                    </tr>
                  <% }) %>
                  <% if (incidentList.length === 0) { %><tr><td colspan="5" class="cell-sub"><%= t('dvp.noServiceIncident') %></td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

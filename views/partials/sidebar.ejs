<%
/* Navigation latérale partagée par l'espace admin et l'espace RH.
   Attend : panelLabel, navItems [{ tab, label, icon, badge? }], sidebarLink? { href, label } */
%>
<aside class="sidebar">
  <div class="sidebar-brand">
    <span class="brand-mark">PM</span>
    <span class="brand-text">
      <span class="brand-name">Private Member</span>
      <span class="brand-panel"><%= panelLabel %></span>
    </span>
  </div>

  <nav class="sidebar-nav" id="tabs" aria-label="Sections">
    <% navItems.forEach((item, index) => { %>
      <button type="button" class="side-link tab-btn<%= index === 0 ? ' is-active' : '' %>" data-tab="<%= item.tab %>">
        <%- include('icon', { name: item.icon, iconSize: 17 }) %>
        <span class="side-link-label"><%= item.label %></span>
        <% if (item.badge) { %><span class="nav-badge"><%= item.badge %></span><% } %>
      </button>
    <% }) %>
  </nav>

  <div class="sidebar-foot">
    <% if (typeof sidebarLink !== 'undefined' && sidebarLink) { %>
      <a href="<%= sidebarLink.href %>" class="side-link side-link-quiet">
        <%- include('icon', { name: sidebarLink.icon || 'external', iconSize: 17 }) %>
        <span class="side-link-label"><%= sidebarLink.label %></span>
      </a>
    <% } %>
    <%- include('theme-toggle') %>
  </div>
</aside>

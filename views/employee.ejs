<!doctype html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Mon espace — Private Member' }) %>
</head>
<body class="app-body">
  <%- include('partials/page-header', {
    headerTitle: 'Mon espace',
    showUser: true,
    extraLink: currentUser.isHr ? { href: '/rh', label: 'Espace RH' } : null
  }) %>

  <main class="page">
    <section class="page-intro">
      <h2>Bonjour <%= currentUser.firstName %>,</h2>
      <p>Retrouvez vos accès aux outils<%= hrEligible ? ', vos congés et vos fiches de paie' : '' %><%= isFreelance ? ' et votre pointage' : '' %>.</p>
    </section>

    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
    <% } %>

    <% if (employee.contract_end_date) {
      const todayStr = new Date().toISOString().slice(0, 10);
      const daysLeft = Math.ceil((new Date(employee.contract_end_date + 'T00:00:00Z') - new Date(todayStr + 'T00:00:00Z')) / 86400000);
      const bannerClass = daysLeft < 0 ? 'is-danger' : (daysLeft <= 30 ? 'is-warning' : '');
      const endDate = new Date(employee.contract_end_date + 'T00:00:00Z').toLocaleDateString('fr-FR');
    %>
      <div class="banner <%= bannerClass %>">
        <%- include('partials/icon', { name: 'calendar', iconSize: 17 }) %>
        <span>
          Contrat <%= employee.contract_type %> —
          <% if (daysLeft < 0) { %>
            arrivé à échéance le <%= endDate %>.
          <% } else { %>
            se termine le <%= endDate %> (dans <%= daysLeft %> jour<%= daysLeft > 1 ? 's' : '' %>).
          <% } %>
        </span>
      </div>
    <% } %>

    <% if (isFreelance) { %>
      <div class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <h3>Pointage</h3>
              <p class="card-sub">Chronométrez votre temps de mission.</p>
            </div>
            <span class="status <%= openEntry ? 'status-on' : 'status-off' %>"><%= openEntry ? 'En cours' : 'Arrêté' %></span>
          </div>

          <div class="timer-display" id="live-timer" data-start="<%= openEntry ? openEntry.clock_in : '' %>">00:00:00</div>

          <% if (openEntry) { %>
            <form method="POST" action="/mon-espace/pointage/terminer">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-danger btn-block">Terminer le pointage</button>
            </form>
          <% } else { %>
            <form method="POST" action="/mon-espace/pointage/commencer">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-primary btn-block">Commencer le pointage</button>
            </form>
          <% } %>

          <div class="timer-stats">
            <div>
              <span class="stat-value"><%= statsData.monthHours.toFixed(1) %> h</span>
              <span class="stat-label">Ce mois-ci</span>
            </div>
            <div>
              <span class="stat-value"><%= statsData.monthEstimate.toFixed(2) %> €</span>
              <span class="stat-label">Estimation du mois</span>
            </div>
            <div>
              <span class="stat-value"><%= statsData.hourlyRate.toFixed(2) %> €</span>
              <span class="stat-label">Taux horaire (TJM ÷ 8 h)</span>
            </div>
          </div>
          <% if (!employee.daily_rate) { %>
            <p class="hint">Aucun TJM renseigné par l'administrateur : l'estimation n'est pas disponible.</p>
          <% } %>
        </div>

        <div class="card">
          <div class="card-head"><h3>Historique des pointages</h3></div>
          <% if (entries.length === 0) { %>
            <div class="empty-state">Aucun pointage enregistré pour le moment.</div>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Date</th><th>Début</th><th>Fin</th><th>Durée</th></tr></thead>
                <tbody>
                  <% entries.forEach((e) => {
                    const start = new Date(e.clock_in);
                    const end = e.clock_out ? new Date(e.clock_out) : null;
                    const hours = end ? (end.getTime() - start.getTime()) / 3600000 : null;
                    const timeOpts = { hour: '2-digit', minute: '2-digit' };
                  %>
                    <tr>
                      <td class="cell-strong"><%= start.toLocaleDateString('fr-FR') %></td>
                      <td class="cell-sub"><%= start.toLocaleTimeString('fr-FR', timeOpts) %></td>
                      <td class="cell-sub"><%= end ? end.toLocaleTimeString('fr-FR', timeOpts) : '—' %></td>
                      <td>
                        <% if (end) { %><span class="num cell-strong"><%= hours.toFixed(2) %> h</span>
                        <% } else { %><span class="status status-on">En cours</span><% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <% if (hrEligible) { %>
      <div class="grid-2">
        <div class="card">
          <div class="card-head">
            <div>
              <h3>Nouvelle demande</h3>
              <p class="card-sub">Solde disponible : <strong><%= employee.leave_balance.toFixed(1) %> jour<%= Math.abs(employee.leave_balance) === 1 ? '' : 's' %></strong></p>
            </div>
          </div>
          <form method="POST" action="/mon-espace/demandes" class="form-grid">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label class="span-2">
              <span>Type de demande</span>
              <select name="type" required>
                <option value="" disabled selected>Choisir…</option>
                <% requestTypes.forEach((t) => { %><option value="<%= t %>"><%= t %></option><% }) %>
              </select>
            </label>
            <label>
              <span>Du</span>
              <input type="date" name="start_date" required />
            </label>
            <label>
              <span>Au</span>
              <input type="date" name="end_date" required />
            </label>
            <label class="span-2">
              <span>Motif</span>
              <input type="text" name="reason" placeholder="Ex : congés d'été" />
            </label>
            <div class="span-2">
              <button type="submit" class="btn btn-primary btn-block">Envoyer la demande</button>
            </div>
          </form>
          <p class="hint">Les jours ouvrés (hors week-ends) sont calculés automatiquement. Seul le type « Congés payés » décompte votre solde, une fois la demande approuvée.</p>
        </div>

        <div class="card">
          <div class="card-head"><h3>Mes demandes <span class="muted">(<%= myRequests.length %>)</span></h3></div>
          <% if (myRequests.length === 0) { %>
            <div class="empty-state">Aucune demande envoyée pour le moment.</div>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Type</th><th>Période</th><th>Jours</th><th>Statut</th><th></th></tr></thead>
                <tbody>
                  <% myRequests.forEach((r) => {
                    const statusClass = r.status === 'Approuvée' ? 'status-on'
                      : r.status === 'En attente' ? 'status-warning'
                      : r.status === 'Refusée' ? 'status-danger' : 'status-off';
                  %>
                    <tr>
                      <td><span class="tag"><%= r.type %></span></td>
                      <td class="cell-sub">
                        <%= new Date(r.start_date + 'T00:00:00Z').toLocaleDateString('fr-FR') %> →
                        <%= new Date(r.end_date + 'T00:00:00Z').toLocaleDateString('fr-FR') %>
                      </td>
                      <td class="num"><%= r.days %> j</td>
                      <td>
                        <span class="status <%= statusClass %>"><%= r.status %></span>
                        <% if (r.review_note) { %><div class="cell-sub">« <%= r.review_note %> »</div><% } %>
                      </td>
                      <td class="actions">
                        <% if (r.status === 'En attente') { %>
                          <form method="POST" action="/mon-espace/demandes/<%= r.id %>/annuler">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-sm btn-danger">Annuler</button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><h3>Mes fiches de paie <span class="muted">(<%= myPayslips.length %>)</span></h3></div>
        <% if (myPayslips.length === 0) { %>
          <div class="empty-state">Aucune fiche de paie disponible pour le moment.</div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Période</th><th>Brut</th><th>Net</th><th>Statut</th></tr></thead>
              <tbody>
                <% myPayslips.forEach((p) => { %>
                  <tr>
                    <td class="cell-strong mono"><%= p.period %></td>
                    <td class="num cell-sub"><%= p.gross_amount.toFixed(2) %> €</td>
                    <td class="num cell-strong"><%= p.net_amount.toFixed(2) %> €</td>
                    <td><span class="status <%= p.status === 'Payée' ? 'status-on' : 'status-warning' %>"><%= p.status %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="card">
      <div class="card-head">
        <div>
          <h3>Mes outils <span class="muted">(<%= tools.length %>)</span></h3>
          <p class="card-sub">Accès qui vous ont été attribués par l'administration.</p>
        </div>
      </div>

      <% if (tools.length === 0) { %>
        <div class="empty-state">Aucun outil ne vous a été affecté pour le moment.</div>
      <% } else { %>
        <div class="tool-grid">
          <% tools.forEach((t) => { %>
            <article class="tool-card">
              <div class="tool-card-top">
                <span class="tool-icon"><%- include('partials/icon', { name: 'tool', iconSize: 17 }) %></span>
                <% if (t.category) { %><span class="tag"><%= t.category %></span><% } %>
              </div>
              <div>
                <div class="tool-name"><%= t.name %></div>
                <% if (t.reference) { %><div class="tool-ref">Réf. <%= t.reference %></div><% } %>
              </div>

              <% if (t.username || t.login_url) { %>
                <div class="cred-box">
                  <% if (t.username) { %>
                    <div class="cred-row">
                      <span class="k">Identifiant</span>
                      <span class="v"><%= t.username %></span>
                    </div>
                  <% } %>
                  <% if (t.login_url) { %>
                    <div class="cred-row">
                      <span class="k">Accès</span>
                      <a href="<%= t.login_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline">
                        Ouvrir <%- include('partials/icon', { name: 'external', iconSize: 13 }) %>
                      </a>
                    </div>
                  <% } %>
                </div>
              <% } %>

              <% if (t.note) { %><p class="tool-note"><%= t.note %></p><% } %>
              <div class="tool-foot">Affecté le <%= new Date(t.assigned_at).toLocaleDateString('fr-FR') %></div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>

  <script src="/js/theme.js"></script>
  <script src="/js/timer.js"></script>
</body>
</html>

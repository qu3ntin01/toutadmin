<!doctype html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Mon espace — Private Member' }) %>
</head>
<body class="app-body">
  <header class="topbar topbar-standalone">
    <div class="topbar-brand">
      <span class="brand-mark small">PM</span>
      <span class="brand-name">Private Member</span>
    </div>
    <div class="topbar-user">
      <%- include('partials/theme-toggle') %>
      <div class="user-chip">
        <span class="user-avatar"><%= currentUser.firstName.charAt(0) %><%= currentUser.lastName.charAt(0) %></span>
        <div class="user-meta">
          <span class="user-name"><%= currentUser.firstName %> <%= currentUser.lastName %></span>
          <span class="user-grade"><%= currentUser.grade %></span>
        </div>
      </div>
      <form method="POST" action="/deconnexion">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn btn-ghost">Déconnexion</button>
      </form>
    </div>
  </header>

  <main class="page">
    <section class="page-head">
      <div>
        <span class="eyebrow">Mon espace</span>
        <h1>Bonjour <%= currentUser.firstName %>,</h1>
        <p class="muted">Voici les outils qui vous sont actuellement affectés, avec leurs accès.</p>
      </div>
    </section>

    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
    <% } %>

    <% if (employee.contract_end_date) {
      const todayStr = new Date().toISOString().slice(0, 10);
      const daysLeft = Math.ceil((new Date(employee.contract_end_date + 'T00:00:00Z') - new Date(todayStr + 'T00:00:00Z')) / 86400000);
      const bannerClass = daysLeft < 0 ? 'is-danger' : (daysLeft <= 30 ? 'is-warning' : '');
    %>
      <div class="contract-banner <%= bannerClass %>">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="16" rx="2.5" /><path d="M8 3v3M16 3v3M3.5 10h17" /></svg>
        <span>
          Contrat <%= employee.contract_type || '' %> —
          <% if (daysLeft < 0) { %>
            arrivé à échéance le <%= new Date(employee.contract_end_date + 'T00:00:00Z').toLocaleDateString('fr-FR') %>.
          <% } else { %>
            se termine le <%= new Date(employee.contract_end_date + 'T00:00:00Z').toLocaleDateString('fr-FR') %> (dans <%= daysLeft %> jour<%= daysLeft > 1 ? 's' : '' %>).
          <% } %>
        </span>
      </div>
    <% } %>

    <% if (isFreelance) { %>
      <section class="card timer-card">
        <div class="timer-card-top">
          <div>
            <h3>Pointage</h3>
            <p class="muted small">Chronométrez votre temps de mission.</p>
          </div>
          <span class="status <%= openEntry ? 'status-on' : 'status-off' %>"><%= openEntry ? 'En cours' : 'Arrêté' %></span>
        </div>

        <div class="timer-display" id="live-timer" data-start="<%= openEntry ? openEntry.clock_in : '' %>">00:00:00</div>

        <div class="timer-actions">
          <% if (openEntry) { %>
            <form method="POST" action="/mon-espace/pointage/terminer">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-danger btn-block">Terminer le pointage</button>
            </form>
          <% } else { %>
            <form method="POST" action="/mon-espace/pointage/commencer">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-gold btn-block">Commencer le pointage</button>
            </form>
          <% } %>
        </div>

        <div class="timer-stats">
          <div>
            <span class="stat-value"><%= statsData.monthHours.toFixed(1) %> h</span>
            <span class="stat-label">Ce mois-ci</span>
          </div>
          <div>
            <span class="stat-value"><%= statsData.monthEstimate.toFixed(2) %> €</span>
            <span class="stat-label">Estimation ce mois</span>
          </div>
          <div>
            <span class="stat-value"><%= statsData.hourlyRate.toFixed(2) %> €/h</span>
            <span class="stat-label">Taux horaire (TJM ÷ 8h)</span>
          </div>
        </div>
        <% if (!employee.daily_rate) { %>
          <p class="hint">Aucun TJM renseigné par l'administrateur : l'estimation de rémunération n'est pas disponible pour le moment.</p>
        <% } %>
      </section>

      <section class="card card-spaced">
        <h3>Historique des pointages</h3>
        <% if (entries.length === 0) { %>
          <div class="empty-state"><p>Aucun pointage enregistré pour le moment.</p></div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>Date</th><th>Début</th><th>Fin</th><th>Durée</th></tr>
              </thead>
              <tbody>
                <% entries.forEach((e) => {
                  const start = new Date(e.clock_in);
                  const end = e.clock_out ? new Date(e.clock_out) : null;
                  const hrs = end ? (end.getTime() - start.getTime()) / 3600000 : null;
                %>
                  <tr>
                    <td class="cell-strong"><%= start.toLocaleDateString('fr-FR') %></td>
                    <td class="muted"><%= start.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></td>
                    <td class="muted"><%= end ? end.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) : '—' %></td>
                    <td>
                      <% if (end) { %><span class="cell-strong"><%= hrs.toFixed(2) %> h</span><% } else { %><span class="status status-on">En cours</span><% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>

    <% if (tools.length === 0) { %>
      <div class="empty-state">
        <p>Aucun outil ne vous a été affecté pour le moment.</p>
      </div>
    <% } else { %>
      <div class="tool-grid">
        <% tools.forEach((t) => { %>
          <div class="tool-card">
            <div class="tool-card-head">
              <span class="tool-card-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m14.5 3.5 2 2L6 16 3 17l1-3Z" /><path d="m13 5 2 2" /></svg>
              </span>
              <% if (t.category) { %><span class="pill"><%= t.category %></span><% } %>
            </div>
            <div>
              <div class="tool-card-title"><%= t.name %></div>
              <div class="tool-card-meta">
                <% if (t.reference) { %><span>Réf. <%= t.reference %></span><% } %>
              </div>
            </div>

            <% if (t.username || t.login_url) { %>
              <div class="tool-card-creds">
                <% if (t.username) { %>
                  <div class="tool-card-cred-row">
                    <span class="k">Identifiant</span>
                    <span class="v"><%= t.username %></span>
                  </div>
                <% } %>
                <% if (t.login_url) { %>
                  <div class="tool-card-cred-row">
                    <span class="k">Accès</span>
                    <a href="<%= t.login_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-tiny">Ouvrir ↗</a>
                  </div>
                <% } %>
              </div>
            <% } %>

            <% if (t.note) { %><p class="tool-card-note"><%= t.note %></p><% } %>

            <div class="tool-card-foot">
              <span class="tool-card-date">Affecté le <%= new Date(t.assigned_at).toLocaleDateString('fr-FR') %></span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <script src="/js/theme.js"></script>
  <script src="/js/timer.js"></script>
</body>
</html>

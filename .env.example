PORT=3000

# Laissez ces trois lignes commentées pour installer via l'assistant (/installation).
# Le secret de session est alors généré automatiquement dans data/session.key.
# SESSION_SECRET=un-secret-long-et-aleatoire

# Recommandé sur un serveur exposé : l'assistant réclame ce jeton avant d'installer.
# INSTALL_TOKEN=un-jeton-long-et-aleatoire

# Installation sans interface (déploiement automatisé) : crée l'administrateur au démarrage.
# ADMIN_EMAIL=admin@entreprise.com
# ADMIN_PASSWORD=un-mot-de-passe-fort

# NODE_ENV=production
# TRUST_PROXY=1

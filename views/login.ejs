<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>">
<head>
  <%- include('partials/head', { title: t('auth.title') + ' — ' + t('app.name') }) %>
</head>
<body class="auth-body">
  <header class="auth-top">
    <div class="auth-brand">
      <span class="brand-mark"><%= brandInitials %></span>
      <span class="brand-text">
        <span class="brand-name"><%= companyName %></span>
        <span class="brand-panel"><%= t('app.portal') %></span>
      </span>
    </div>
    <%- include('partials/theme-toggle') %>
  </header>

  <main class="auth-main">
    <div class="auth-card">
      <h1><%= t('auth.title') %></h1>
      <p class="auth-sub"><%= t('auth.subtitle') %></p>

      <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <form method="POST" action="/connexion" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>
          <span><%= t('auth.email') %></span>
          <input type="email" name="email" placeholder="nom@entreprise.com" required autofocus autocomplete="username" />
        </label>
        <label>
          <span><%= t('auth.password') %></span>
          <input type="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
        </label>
        <button type="submit" class="btn btn-primary btn-block"><%= t('auth.signIn') %></button>
      </form>

      <p class="auth-note">
        Vous avez quitté l'entreprise et cherchez vos bulletins de paie ?
        <a href="/coffre-fort/acces">Accéder à votre coffre-fort</a>.
      </p>

      <div class="auth-foot">
        <p><%= t('auth.note') %></p>
        <p class="cell-sub"><%= t('common.language') %></p>
        <%- include('partials/language-picker', { returnTo: '/connexion' }) %>
      </div>
    </div>
  </main>

  <script src="/js/theme.js"></script>
</body>
</html>

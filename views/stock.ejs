<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Stock et achats — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <% if (isFinance) { %>
      <%- include('partials/sidebar', {
        panelLabel: t('nav.stock'),
        navItems: [
          { tab: 'articles', label: t('stk.tabItems'), icon: 'network', badge: lowStock.length },
          { tab: 'mouvements', label: t('common.movements'), icon: 'link' },
          { tab: 'demandes', label: t('stk.tabRequests'), icon: 'inbox', badge: financeRequests.length },
          { tab: 'commandes', label: t('ach.tabOrders'), icon: 'briefcase', badge: purchaseSummary.discrepancies }
        ],
        footLinks: [{ href: '/gestion', label: t('nav.gestion'), icon: 'back' }]
      }) %>
    <% } else { %>
      <%- include('partials/member-sidebar', { active: 'stock' }) %>
    <% } %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('nav.stock'),
        headerSubtitle: isFinance ? "Articles, mouvements et demandes d'achat" : "Vos demandes d'achat"
      }) %>

      <main class="page">
        <% if (flash) { %>
          <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
        <% } %>

        <% const money = (n) => Number(n || 0).toLocaleString(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'; %>
        <% const day = (iso) => (iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>

        <% if (isFinance) { %>
          <section class="stats-grid">
            <div class="stat-card">
              <span class="stat-icon"><%- include('partials/icon', { name: 'network', iconSize: 18 }) %></span>
              <span class="stat-body"><span class="stat-value"><%= items.length %></span><span class="stat-label"><%= t('stk.tabItems') %></span></span>
            </div>
            <div class="stat-card">
              <span class="stat-icon"><%- include('partials/icon', { name: 'shield', iconSize: 18 }) %></span>
              <span class="stat-body"><span class="stat-value"><%= lowStock.length %></span><span class="stat-label"><%= t('stk.belowThreshold') %></span></span>
            </div>
            <div class="stat-card">
              <span class="stat-icon"><%- include('partials/icon', { name: 'card', iconSize: 18 }) %></span>
              <span class="stat-body"><span class="stat-value"><%= money(stockValue) %></span><span class="stat-label"><%= t('stk.stockValue') %></span></span>
            </div>
            <div class="stat-card">
              <span class="stat-icon"><%- include('partials/icon', { name: 'inbox', iconSize: 18 }) %></span>
              <span class="stat-body"><span class="stat-value"><%= financeRequests.length %></span><span class="stat-label"><%= t('stk.toApprove') %></span></span>
            </div>
          </section>

          <% if (lowStock.length) { %>
            <div class="banner is-warning">
              <%- include('partials/icon', { name: 'shield', iconSize: 17 }) %>
              <span><%= t('stk.lowStockBanner', { count: lowStock.length, list: lowStock.slice(0, 4).map((i) => i.label).join(', ') + (lowStock.length > 4 ? '…' : '') }) %></span>
            </div>
          <% } %>

          <!-- ---------- Articles ---------- -->
          <section class="tab-panel is-active" id="articles">
            <div class="grid-2">
              <div class="card">
                <div class="card-head"><h3><%= t('stk.newItem') %></h3></div>
                <form method="POST" action="/stock/articles" class="stack">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label>
                    <span><%= t('common.designation') %></span>
                    <input type="text" name="label" maxlength="160" required />
                  </label>
                  <div class="form-grid">
                    <label>
                      <span><%= t('common.reference') %></span>
                      <input type="text" name="reference" maxlength="60" />
                    </label>
                    <label>
                      <span><%= t('common.unit') %></span>
                      <input type="text" name="unit" maxlength="20" value="unité" />
                    </label>
                    <label>
                      <span><%= t('common.type') %></span>
                      <input type="text" name="category" maxlength="80" />
                    </label>
                    <label>
                      <span><%= t('stk.alertThreshold') %></span>
                      <input type="text" name="stock_min" inputmode="decimal" value="0" />
                    </label>
                    <label>
                      <span><%= t('stk.unitPrice') %></span>
                      <input type="text" name="unit_price" inputmode="decimal" />
                    </label>
                    <label>
                      <span><%= t('stk.supplier') %></span>
                      <select name="partner_id">
                        <option value="">—</option>
                        <% partners.forEach((p) => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
                      </select>
                    </label>
                  </div>
                  <button type="submit" class="btn btn-primary btn-block"><%= t('common.create') %></button>
                </form>
              </div>

              <div class="card">
                <div class="card-head"><h3><%= t('stk.stockCount', { count: items.length }) %></h3></div>
                <% if (items.length === 0) { %>
                  <div class="empty-state"><%= t('stk.noItem') %></div>
                <% } else { %>
                  <div class="table-wrap">
                    <table>
                      <thead><tr><th><%= t('stk.item') %></th><th><%= t('stk.stock') %></th><th><%= t('common.threshold') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
                      <tbody>
                        <% items.forEach((i) => { %>
                          <tr>
                            <td>
                              <div class="cell-strong"><%= i.label %></div>
                              <div class="cell-sub"><%= [i.reference, i.category, i.partner_name].filter(Boolean).join(' · ') || '—' %></div>
                            </td>
                            <td class="num cell-strong <%= i.below ? 'text-danger' : '' %>"><%= i.stock %> <%= i.unit %></td>
                            <td class="num cell-sub"><%= i.stock_min %></td>
                            <td>
                              <span class="status <%= !i.active ? 'status-off' : (i.below ? 'status-warning' : 'status-on') %>">
                                <%= !i.active ? t('common.inactive') : (i.below ? 'Sous le seuil' : 'En stock') %>
                              </span>
                            </td>
                            <td class="actions">
                              <form method="POST" action="/stock/articles/<%= i.id %>/statut" class="inline-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                <button type="submit" class="btn btn-sm"><%= i.active ? 'Désactiver' : 'Activer' %></button>
                              </form>
                              <form method="POST" action="/stock/articles/<%= i.id %>/supprimer" class="inline-form" data-confirm="<%= t('stk.confirmDeleteItem') %>">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
                              </form>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                  <p class="hint"><%= t('stk.stockIsSum') %></p>
                <% } %>
              </div>
            </div>
          </section>

          <!-- ---------- Mouvements ---------- -->
          <section class="tab-panel" id="mouvements">
            <div class="grid-2">
              <div class="card">
                <div class="card-head"><h3><%= t('stk.recordMovement') %></h3></div>
                <% if (items.length === 0) { %>
                  <div class="empty-state"><%= t('stk.createItemFirst') %></div>
                <% } else { %>
                  <form method="POST" action="/stock/mouvements" class="stack">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <label>
                      <span><%= t('stk.item') %></span>
                      <select name="item_id" required>
                        <% items.forEach((i) => { %><option value="<%= i.id %>"><%= i.label %> (<%= i.stock %> <%= i.unit %>)</option><% }) %>
                      </select>
                    </label>
                    <div class="form-grid">
                      <label>
                        <span><%= t('common.type') %></span>
                        <select name="kind" required>
                          <% movementKinds.forEach((k) => { %><option value="<%= k %>"><%= k %></option><% }) %>
                        </select>
                      </label>
                      <label>
                        <span><%= t('common.quantity') %></span>
                        <input type="text" name="quantity" inputmode="decimal" required />
                      </label>
                      <label>
                        <span><%= t('common.date') %></span>
                        <input type="date" name="moved_on" />
                      </label>
                      <label>
                        <span><%= t('common.reason') %></span>
                        <input type="text" name="reason" maxlength="200" />
                      </label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block"><%= t('common.save') %></button>
                    <p class="hint"><%= t('stk.movementRule') %></p>
                  </form>
                <% } %>
              </div>

              <div class="card">
                <div class="card-head"><h3><%= t('stk.lastMovements') %> <span class="muted">(<%= movements.length %>)</span></h3></div>
                <% if (movements.length === 0) { %>
                  <div class="empty-state"><%= t('stk.noMovement') %></div>
                <% } else { %>
                  <div class="table-wrap">
                    <table>
                      <thead><tr><th><%= t('common.date') %></th><th><%= t('stk.item') %></th><th><%= t('common.type') %></th><th><%= t('common.quantity') %></th><th><%= t('gov.by') %></th></tr></thead>
                      <tbody>
                        <% movements.slice(0, 40).forEach((m) => { %>
                          <tr>
                            <td><%= day(m.moved_on) %></td>
                            <td>
                              <%= m.item_label %>
                              <% if (m.reason) { %><div class="cell-sub"><%= m.reason %></div><% } %>
                            </td>
                            <td>
                              <span class="tag <%= m.kind === 'Entrée' ? 'tag-accent' : '' %>"><%= m.kind %></span>
                            </td>
                            <td class="num cell-strong"><%= m.quantity %> <%= m.unit %></td>
                            <td class="cell-sub"><%= m.first_name ? m.first_name + ' ' + m.last_name : '—' %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } %>
              </div>
            </div>
          </section>
        <% } %>

        <!-- ---------- Demandes d'achat ---------- -->
        <section class="tab-panel <%= isFinance ? '' : 'is-active' %>" id="demandes">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('stk.newRequest') %></h3></div>
              <form method="POST" action="/stock/demandes" class="stack">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label>
                  <span><%= t('common.subject') %></span>
                  <input type="text" name="label" maxlength="160" required />
                </label>
                <div class="form-grid">
                  <label>
                    <span><%= t('common.quantity') %></span>
                    <input type="text" name="quantity" inputmode="decimal" value="1" required />
                  </label>
                  <label>
                    <span><%= t('stk.estimatedAmount') %></span>
                    <input type="text" name="estimated_amount" inputmode="decimal" value="0" required />
                  </label>
                </div>
                <% if (items.length) { %>
                  <label>
                    <span><%= t('stk.catalogItem') %> <span class="cell-sub">(<%= t('common.optional') %>)</span></span>
                    <select name="item_id">
                      <option value="">—</option>
                      <% items.filter((i) => i.active).forEach((i) => { %><option value="<%= i.id %>"><%= i.label %></option><% }) %>
                    </select>
                  </label>
                <% } %>
                <label>
                  <span><%= t('stk.justification') %></span>
                  <textarea name="justification" rows="3" maxlength="1000"></textarea>
                </label>
                <button type="submit" class="btn btn-primary btn-block"><%= t('common.send') %></button>
                <p class="hint"><%= t('stk.twoLevelNote', { threshold }) %></p>
              </form>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('leave.myRequests') %> <span class="muted">(<%= myRequests.length %>)</span></h3></div>
              <% if (myRequests.length === 0) { %>
                <div class="empty-state"><%= t('stk.noRequestSent') %></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th><%= t('common.subject') %></th><th><%= t('erp.amount') %></th><th><%= t('common.status') %></th><th class="actions"></th></tr></thead>
                    <tbody>
                      <% myRequests.forEach((r) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= r.label %></div>
                            <div class="cell-sub"><%= r.quantity %> × <%= day(r.created_at.slice(0, 10)) %></div>
                          </td>
                          <td class="num"><%= money(r.estimated_amount) %></td>
                          <td>
                            <span class="status <%= ['Approuvée','Commandée'].includes(r.status) ? 'status-on' : (r.status === 'Refusée' || r.status === 'Annulée' ? 'status-danger' : 'status-warning') %>">
                              <%= r.status === 'Manager' ? 'Chez le manager' : (r.status === 'Gestion' ? 'Chez la gestion' : r.status) %>
                            </span>
                            <% if (r.review_note) { %><div class="cell-sub"><%= r.review_note %></div><% } %>
                          </td>
                          <td class="actions">
                            <% if (r.status === 'Manager') { %>
                              <form method="POST" action="/stock/demandes/<%= r.id %>/annuler" data-confirm="<%= t('stk.confirmCancelRequest') %>">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                <button type="submit" class="btn btn-danger btn-sm"><%= t('common.cancel') %></button>
                              </form>
                            <% } else { %>
                              <span class="cell-sub">—</span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>

          <% if (managerRequests.length) { %>
            <div class="card">
              <div class="card-head">
                <div>
                  <h3><%= t('stk.toArbitrate', { count: managerRequests.length }) %></h3>
                  <p class="card-sub"><%= t('stk.firstLevelNote', { threshold }) %></p>
                </div>
              </div>
              <ul class="meeting-list">
                <% managerRequests.forEach((r) => { %>
                  <li class="meeting-item">
                    <div class="meeting-head">
                      <span class="meeting-title"><%= r.label %></span>
                      <span class="tag"><%= money(r.estimated_amount) %></span>
                    </div>
                    <p class="cell-sub"><%= r.first_name %> <%= r.last_name %> · <%= t('stk.unitCount', { count: r.quantity }) %><%= r.department_name ? ' · ' + r.department_name : '' %></p>
                    <% if (r.justification) { %><p class="benefit-text"><%= r.justification %></p><% } %>
                    <div class="row-actions">
                      <% ['approuver', 'refuser'].forEach((decision) => { %>
                        <form method="POST" action="/stock/demandes/<%= r.id %>/manager" class="inline-form">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <input type="hidden" name="decision" value="<%= decision %>" />
                          <button type="submit" class="btn btn-sm <%= decision === 'approuver' ? 'btn-primary' : '' %>">
                            <%= decision === 'approuver' ? t('hr.approve') : t('hr.refuse') %>
                          </button>
                        </form>
                      <% }) %>
                    </div>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <% if (isFinance) { %>
            <div class="card">
              <div class="card-head">
                <div>
                  <h3><%= t('stk.allRequests', { count: allRequests.length }) %></h3>
                  <p class="card-sub"><%= t('stk.secondLevelNote', { threshold }) %></p>
                </div>
              </div>
              <% if (allRequests.length === 0) { %>
                <div class="empty-state"><%= t('stk.noPurchaseRequest') %></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th><%= t('common.requester') %></th><th><%= t('common.subject') %></th><th><%= t('erp.amount') %></th><th><%= t('common.status') %></th><th class="actions"><%= t('common.actions') %></th></tr></thead>
                    <tbody>
                      <% allRequests.forEach((r) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= r.first_name %> <%= r.last_name %></div>
                            <div class="cell-sub"><%= r.department_name || '—' %></div>
                          </td>
                          <td>
                            <%= r.label %>
                            <div class="cell-sub"><%= t('stk.unitCount', { count: r.quantity }) %></div>
                          </td>
                          <td class="num cell-strong"><%= money(r.estimated_amount) %></td>
                          <td>
                            <span class="status <%= ['Approuvée','Commandée'].includes(r.status) ? 'status-on' : (['Refusée','Annulée'].includes(r.status) ? 'status-danger' : 'status-warning') %>">
                              <%= r.status === 'Manager' ? 'Chez le manager' : (r.status === 'Gestion' ? 'Chez la gestion' : r.status) %>
                            </span>
                          </td>
                          <td class="actions">
                            <% if (r.status === 'Gestion') { %>
                              <% ['approuver', 'refuser'].forEach((decision) => { %>
                                <form method="POST" action="/stock/demandes/<%= r.id %>/gestion" class="inline-form">
                                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                  <input type="hidden" name="decision" value="<%= decision %>" />
                                  <button type="submit" class="btn btn-sm <%= decision === 'approuver' ? 'btn-primary' : '' %>">
                                    <%= decision === 'approuver' ? t('hr.approve') : t('hr.refuse') %>
                                  </button>
                                </form>
                              <% }) %>
                            <% } else if (r.status === 'Approuvée') { %>
                              <form method="POST" action="/stock/demandes/<%= r.id %>/commander" class="inline-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                <button type="submit" class="btn btn-primary btn-sm"><%= t('stk.order') %></button>
                              </form>
                            <% } else { %>
                              <span class="cell-sub">—</span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          <% } %>
        </section>

        <% if (isFinance) { %>
          <section class="tab-panel" id="commandes">
            <% const money = (n) => (n == null ? '—' : Number(n).toLocaleString(locale, { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' €'); %>
            <% const day = (iso) => (iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>

            <section class="stats-grid">
              <div class="stat-card">
                <span class="stat-icon"><%- include('partials/icon', { name: 'briefcase', iconSize: 18 }) %></span>
                <span class="stat-body"><span class="stat-value"><%= purchaseSummary.open %></span><span class="stat-label"><%= t('ach.openOrders') %></span></span>
              </div>
              <div class="stat-card">
                <span class="stat-icon"><%- include('partials/icon', { name: 'card', iconSize: 18 }) %></span>
                <span class="stat-body"><span class="stat-value"><%= money(purchaseSummary.engaged) %></span><span class="stat-label"><%= t('ach.engaged') %></span></span>
              </div>
              <div class="stat-card">
                <span class="stat-icon"><%- include('partials/icon', { name: 'clock', iconSize: 18 }) %></span>
                <span class="stat-body"><span class="stat-value"><%= money(purchaseSummary.awaited) %></span><span class="stat-label"><%= t('ach.awaited') %></span></span>
              </div>
              <div class="stat-card">
                <span class="stat-icon"><%- include('partials/icon', { name: 'shield', iconSize: 18 }) %></span>
                <span class="stat-body"><span class="stat-value"><%= purchaseSummary.discrepancies %></span><span class="stat-label"><%= t('ach.gaps') %></span></span>
              </div>
            </section>

            <% if (discrepancies.length) { %>
              <div class="card">
                <div class="card-head"><h3><%= t('ach.gapsTitle', { count: discrepancies.length }) %></h3></div>
                <p class="hint"><%= t('ach.gapsHint') %></p>
                <ul class="org-list">
                  <% discrepancies.forEach((row) => { %>
                    <li class="org-item">
                      <span>
                        <a class="cell-strong" href="/stock/commandes/<%= row.order.id %>"><%= row.order.reference %></a>
                        <span class="cell-sub"> · <%= row.order.partner_name %></span>
                        <br />
                        <% row.match.issues.forEach((issue) => { %>
                          <span class="tag tag-danger">
                            <%= issue.kind === 'sur_commande'
                              ? t('ach.gapOverOrdered', { amount: money(issue.gap) })
                              : t('ach.gapOverReceived', { amount: money(issue.gap) }) %>
                          </span>
                        <% }) %>
                      </span>
                      <a class="btn btn-outline btn-sm" href="/stock/commandes/<%= row.order.id %>"><%= t('common.open') %></a>
                    </li>
                  <% }) %>
                </ul>
              </div>
            <% } %>

            <div class="card">
              <div class="card-head"><h3><%= t('ach.orderCount', { count: orderList.length }) %></h3></div>
              <div class="table-wrap">
                <table>
                  <thead><tr>
                    <th><%= t('ach.reference') %></th><th><%= t('erp.partners') %></th><th><%= t('ach.orderedOn') %></th>
                    <th><%= t('ach.ordered') %></th><th><%= t('ach.received') %></th><th><%= t('ach.invoiced') %></th>
                    <th><%= t('common.status') %></th><th></th>
                  </tr></thead>
                  <tbody>
                    <% orderList.forEach((order) => { %>
                      <tr>
                        <td class="cell-strong mono"><a href="/stock/commandes/<%= order.id %>"><%= order.reference %></a></td>
                        <td><%= order.partner_name %><% if (order.department_name) { %><br /><span class="cell-sub"><%= order.department_name %></span><% } %></td>
                        <td class="cell-sub nowrap"><%= day(order.ordered_on) %></td>
                        <td class="cell-sub nowrap"><%= money(order.ordered_amount) %></td>
                        <td class="cell-sub nowrap"><%= money(order.received_amount) %></td>
                        <td class="cell-sub nowrap"><%= money(order.invoiced_amount) %></td>
                        <td><span class="tag <%= order.status === 'Reçue' ? 'tag-success' : (order.status === 'Annulée' ? '' : 'tag-warning') %>"><%= st(order.status) %></span></td>
                        <td><a class="btn btn-outline btn-sm" href="/stock/commandes/<%= order.id %>"><%= t('common.open') %></a></td>
                      </tr>
                    <% }) %>
                    <% if (orderList.length === 0) { %><tr><td colspan="8" class="cell-sub"><%= t('ach.noOrder') %></td></tr><% } %>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('ach.newOrder') %></h3></div>
              <form method="POST" action="/stock/commandes" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label><span><%= t('ach.supplier') %></span>
                  <select name="partner_id" required>
                    <option value="" disabled selected><%= t('common.choose') %></option>
                    <% partners.forEach((partner) => { %><option value="<%= partner.id %>"><%= partner.name %></option><% }) %>
                  </select>
                </label>
                <label><span><%= t('common.department') %></span>
                  <select name="department_id"><option value="">—</option>
                    <% departments.forEach((department) => { %><option value="<%= department.id %>"><%= department.name %></option><% }) %>
                  </select>
                </label>
                <label><span><%= t('ach.orderedOn') %></span><input type="date" name="ordered_on" value="<%= today %>" required /></label>
                <label><span><%= t('ach.expectedOn') %></span><input type="date" name="expected_on" /></label>
                <label class="span-2"><span><%= t('common.notes') %></span><textarea name="notes" rows="2" maxlength="1000"></textarea></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.create') %></button></div>
              </form>
            </div>
          </section>
        <% } %>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

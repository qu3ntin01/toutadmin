<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>"<%- railAttrs %>>
<head>
  <%- include('partials/head', { title: bon.reference + ' — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/services-sidebar') %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('ven.deliveryNote') + ' ' + bon.reference,
        headerSubtitle: bon.partner_name,
        backHref: '/crm/commandes/' + bon.order_id,
        backLabel: bon.order_reference,
        onglets: [{ href: '/crm/commandes/' + bon.order_id, label: bon.order_reference, icon: 'back', active: true }]
      }) %>

      <main class="page">
        <% const qte = (n) => Number(n || 0).toLocaleString(locale, { maximumFractionDigits: 3 }); %>
        <div class="card">
          <div class="grid-2">
            <div>
              <h3><%= bon.societe.name || companyName %></h3>
              <% if (bon.societe.registration) { %><div class="cell-sub"><%= bon.societe.registration %></div><% } %>
            </div>
            <div>
              <div class="cell-sub"><%= t('ven.deliveredTo') %></div>
              <div class="cell-strong"><%= bon.partner_name %></div>
              <% if (bon.partner_address) { %><div class="cell-sub"><%= bon.partner_address %></div><% } %>
            </div>
          </div>
          <dl class="summary-list mt-m">
            <div><dt><%= t('ven.deliveryNote') %></dt><dd class="mono"><%= bon.reference %></dd></div>
            <div><dt><%= t('ven.order') %></dt><dd class="mono"><%= bon.order_reference %></dd></div>
            <div><dt><%= t('ven.deliveredOn') %></dt><dd><%= new Date(bon.delivered_on + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) %></dd></div>
          </dl>
          <div class="table-wrap mt-m">
            <table>
              <thead><tr><th><%= t('common.reference') %></th><th><%= t('common.label') %></th><th class="num"><%= t('ven.qty') %></th></tr></thead>
              <tbody>
                <% bon.lignes.forEach((l) => { %>
                  <tr><td class="mono"><%= l.product_reference || '—' %></td><td><%= l.label %></td><td class="num"><%= qte(l.quantity) %> <%= l.unit %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <p class="cell-sub mt-m"><%= t('ven.receivedBy') %></p>
        </div>
      </main>
    </div>
  </div>
  <script src="<%= asset('/js/theme.js') %>"></script>
</body>
</html>

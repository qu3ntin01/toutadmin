<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>"<%- railAttrs %>>
<head>
  <%- include('partials/head', { title: t('sec.settings.title') + ' — ' + t(groupe.titre) + ' — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/admin-sidebar', { asLinks: true }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t(groupe.titre) + ' — ' + t('sec.settings.title'),
        headerSubtitle: t('sec.settings.sub')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>

        <div class="card">
          <div class="card-head"><h2><%= t('sec.settings.title') %></h2></div>
          <% if (champs.length === 0) { %>
            <p class="hint"><%= t('sec.settings.none') %></p>
          <% } else { %>
            <p class="hint"><%= t('sec.settings.intro') %></p>
            <form method="POST" action="/section/<%= groupe.cle %>/reglages" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <%- include('partials/champs-section', { groupe, champs }) %>
              <div class="span-2 form-actions">
                <button type="submit" class="btn btn-primary"><%= t('common.save') %></button>
                <a class="btn" href="/section/<%= groupe.cle %>"><%= t('common.back') %></a>
              </div>
            </form>
          <% } %>
        </div>

        <div class="card">
          <div class="card-head"><h3><%= t('sec.wizard.again') %></h3></div>
          <p class="hint"><%= t('sec.wizard.againHelp') %></p>
          <form method="POST" action="/section/<%= groupe.cle %>/assistant/rouvrir">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn"><%= t('sec.wizard.againButton') %></button>
          </form>
        </div>
      </main>
    </div>
  </div>
  <script src="<%= asset('/js/theme.js') %>"></script>
</body>
</html>

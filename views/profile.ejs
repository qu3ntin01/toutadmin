<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: t('profile.title') + ' — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/member-sidebar', { active: 'profil' }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('profile.title'),
        headerSubtitle: t('profile.subtitle')
      }) %>

      <main class="page">

        <% if (flash) { %>
          <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
        <% } %>

        <div class="grid-2">
          <div class="stack">
            <div class="card">
              <div class="card-head"><h3><%= t('profile.photo') %></h3></div>
              <div class="manager-card">
                <%- include('partials/avatar', { person: profile, size: 'lg' }) %>
                <div>
                  <div class="manager-name"><%= profile.first_name %> <%= profile.last_name %></div>
                  <div class="manager-role"><%= profile.grade %><%= department ? ' · ' + department.name : '' %></div>
                </div>
              </div>

              <form method="POST" action="/mon-profil/photo" enctype="multipart/form-data" class="stack">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label>
                  <span><%= t('profile.photo') %></span>
                  <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" required />
                </label>
                <div class="form-actions">
                  <button type="submit" class="btn btn-primary"><%= t('profile.upload') %></button>
                </div>
              </form>

              <% if (profile.avatar_file) { %>
                <form method="POST" action="/mon-profil/photo/supprimer" class="form-actions" data-confirm="<%= t('profile.removePhoto') %> ?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-sm btn-danger"><%= t('profile.removePhoto') %></button>
                </form>
              <% } %>
              <p class="hint"><%= t('profile.photoHelp') %></p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('profile.details') %></h3></div>
              <table>
                <tbody>
                  <tr><td class="cell-sub"><%= t('common.email') %></td><td class="cell-strong"><%= profile.email %></td></tr>
                  <tr><td class="cell-sub"><%= t('common.grade') %></td><td><%= profile.grade %></td></tr>
                  <tr><td class="cell-sub"><%= t('common.department') %></td><td><%= department ? department.name : '—' %></td></tr>
                  <tr><td class="cell-sub"><%= t('common.team') %></td><td><%= team ? team.name : '—' %></td></tr>
                  <tr><td class="cell-sub"><%= t('common.contract') %></td><td><%= profile.contract_type || '—' %></td></tr>
                  <tr>
                    <td class="cell-sub"><%= t('common.managers') %></td>
                    <td><%= managers.length ? managers.map((m) => m.first_name + ' ' + m.last_name).join(', ') : t('home.noManager') %></td>
                  </tr>
                </tbody>
              </table>
              <p class="hint"><%= t('profile.managedByAdmin') %></p>
            </div>
          </div>

          <div class="stack">
            <div class="card">
              <div class="card-head"><h3><%= t('profile.about') %></h3></div>
              <form method="POST" action="/mon-profil/informations" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span><%= t('profile.about') %></span>
                  <textarea name="bio" rows="4" placeholder="<%= t('profile.aboutPlaceholder') %>"><%= profile.bio %></textarea>
                </label>
                <label class="span-2">
                  <span><%= t('common.phone') %></span>
                  <input type="text" name="phone" value="<%= profile.phone %>" placeholder="+33 6 12 34 56 78" />
                </label>
                <label class="span-2">
                  <span><%= t('common.language') %></span>
                  <select name="locale">
                    <% locales.forEach((l) => { %>
                      <option value="<%= l.code %>" <%= l.code === locale ? 'selected' : '' %>><%= l.flag %> <%= l.label %></option>
                    <% }) %>
                  </select>
                </label>
                <div class="span-2">
                  <button type="submit" class="btn btn-primary btn-block"><%= t('common.save') %></button>
                </div>
              </form>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('profile.password') %></h3></div>
              <form method="POST" action="/mon-profil/mot-de-passe" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span><%= t('profile.currentPassword') %></span>
                  <input type="password" name="current_password" required autocomplete="current-password" />
                </label>
                <label>
                  <span><%= t('profile.newPassword') %></span>
                  <input type="password" name="new_password" required minlength="12" autocomplete="new-password" />
                </label>
                <label>
                  <span><%= t('profile.confirmPassword') %></span>
                  <input type="password" name="confirm_password" required minlength="12" autocomplete="new-password" />
                </label>
                <div class="span-2">
                  <button type="submit" class="btn btn-primary btn-block"><%= t('profile.password') %></button>
                </div>
              </form>
              <p class="hint"><%= t('profile.passwordHelp') %></p>
            </div>

            <div class="card" id="securite">
              <div class="card-head">
                <h3>Double authentification</h3>
                <% if (twoFactorState.enabled) { %>
                  <span class="tag tag-success">Active</span>
                <% } else if (twoFactorRequired) { %>
                  <span class="tag tag-danger">Exigée</span>
                <% } %>
              </div>

              <% if (recoveryCodes) { %>
                <div class="flash flash-success">
                  Codes de secours — affichés une seule fois. Notez-les et rangez-les ailleurs que sur ce poste.
                </div>
                <ul class="code-list">
                  <% recoveryCodes.forEach((code) => { %><li><%= code %></li><% }) %>
                </ul>
              <% } %>

              <% if (twoFactorState.enabled) { %>
                <p class="cell-sub">
                  Un code temporaire vous est demandé à chaque connexion.
                  <%= twoFactorState.remainingCodes %> code(s) de secours restant(s).
                </p>
                <form method="POST" action="/mon-profil/2fa/codes" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-outline btn-sm">Régénérer les codes de secours</button>
                </form>
                <% if (!twoFactorRequired) { %>
                  <form method="POST" action="/mon-profil/2fa/desactiver" class="form-grid" data-confirm="Désactiver la double authentification ?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <label class="span-2">
                      <span>Mot de passe, pour confirmer</span>
                      <input type="password" name="current_password" required autocomplete="current-password" />
                    </label>
                    <div class="span-2">
                      <button type="submit" class="btn btn-danger btn-sm"><%= t('common.disable') %></button>
                    </div>
                  </form>
                <% } %>

              <% } else if (twoFactorState.pending) { %>
                <p class="cell-sub">Scannez ce QR code dans votre application d'authentification, puis saisissez le code affiché.</p>
                <% if (twoFactorQr) { %>
                  <img class="totp-qr" src="<%= twoFactorQr %>" alt="QR code de mise en service" width="220" height="220" />
                <% } %>
                <p class="cell-sub">Saisie manuelle : <code class="totp-secret"><%= twoFactorSecret %></code></p>
                <form method="POST" action="/mon-profil/2fa/activer" class="form-grid">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label class="span-2">
                    <span>Code à 6 chiffres</span>
                    <input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required />
                  </label>
                  <div class="span-2">
                    <button type="submit" class="btn btn-primary btn-block"><%= t('common.enable') %></button>
                  </div>
                </form>

              <% } else { %>
                <p class="cell-sub">
                  Un mot de passe volé ne suffit plus à entrer : un code temporaire, généré sur votre
                  téléphone, est demandé en plus.
                  <% if (twoFactorRequired) { %>
                    <strong>Votre rôle l'exige : activez-la maintenant.</strong>
                  <% } %>
                </p>
                <form method="POST" action="/mon-profil/2fa/preparer">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-primary btn-block">Mettre en service</button>
                </form>
              <% } %>
            </div>

            <div class="card">
              <div class="card-head"><h3>Sessions ouvertes</h3></div>
              <p class="cell-sub">
                Si vous vous êtes connecté depuis un poste qui n'est plus le vôtre, fermez toutes les
                sessions : la vôtre comprise, vous vous reconnecterez.
              </p>
              <form method="POST" action="/sessions/fermer" data-confirm="Fermer toutes les sessions, y compris celle-ci ?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="btn btn-outline btn-block">Fermer toutes mes sessions</button>
              </form>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

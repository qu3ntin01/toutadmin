<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Pilotage — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('nav.steering'),
      navItems: [
        { tab: 'tableau', label: t('common.dashboard'), icon: 'home' },
        { tab: 'echeances', label: 'Échéances', icon: 'clock', badge: deadlines.overdue },
        { tab: 'projets', label: 'Santé des projets', icon: 'briefcase' },
        { tab: 'objectifs', label: t('common.objectives'), icon: 'check' }
      ],
      footLinks: [{ href: currentUser.role === 'admin' ? '/admin' : '/mon-espace', label: t('common.back'), icon: 'back' }]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('nav.steering'),
        headerSubtitle: "Ce que la direction regarde : effectif, activité, échéances et objectifs — exercice " + year
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const money = (n) => (n == null ? '—' : Number(n).toLocaleString(locale, { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €'); %>
        <% const day = (iso) => (iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'users', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= overview.headcount.total %></span><span class="stat-label">Effectif actif</span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'card', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(overview.revenue.sales) %></span><span class="stat-label">Facturé <%= year %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'ticket', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(overview.unpaid.total) %></span><span class="stat-label"><%= overview.unpaid.count %> facture(s) client en attente</span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clock', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value <%= deadlines.overdue ? 'text-danger' : '' %>"><%= deadlines.overdue %></span><span class="stat-label">Échéances dépassées</span></span>
          </div>
        </section>

        <!-- ---------- Tableau de bord ---------- -->
        <section class="tab-panel is-active" id="tableau">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('common.headcount') %></h3></div>
              <table>
                <tbody>
                  <% overview.headcount.byContract.forEach((row) => { %>
                    <tr><td class="cell-sub"><%= row.contract_type || 'Non renseigné' %></td><td class="cell-strong"><%= row.n %></td></tr>
                  <% }) %>
                  <tr><td class="cell-sub">Absents aujourd'hui</td><td class="cell-strong"><%= overview.absentToday %></td></tr>
                  <% if (overview.headcount.byContract.length === 0) { %><tr><td class="cell-sub" colspan="2">Aucun membre actif.</td></tr><% } %>
                </tbody>
              </table>
            </div>

            <div class="card">
              <div class="card-head"><h3>Activité <%= year %></h3></div>
              <table>
                <tbody>
                  <tr><td class="cell-sub">Facturé client (HT)</td><td class="cell-strong"><%= money(overview.revenue.sales) %></td></tr>
                  <tr><td class="cell-sub">Achats fournisseurs (HT)</td><td><%= money(overview.revenue.purchases) %></td></tr>
                  <tr><td class="cell-sub">Marge brute</td><td class="cell-strong <%= overview.revenue.margin < 0 ? 'text-danger' : '' %>"><%= money(overview.revenue.margin) %></td></tr>
                  <tr>
                    <td class="cell-sub">Masse salariale mensuelle</td>
                    <td><%= overview.payroll ? money(overview.payroll.monthly) + ' (' + overview.payroll.known + ' salaires connus)' : '— non renseignée' %></td>
                  </tr>
                  <tr>
                    <td class="cell-sub">Trésorerie</td>
                    <td class="<%= overview.treasury != null && overview.treasury < 0 ? 'text-danger' : '' %>">
                      <%= overview.treasury == null ? '— module éteint' : money(overview.treasury) %>
                    </td>
                  </tr>
                  <tr><td class="cell-sub">Tickets ouverts</td><td><%= overview.tickets.open %> (<%= overview.tickets.month %> ce mois-ci)</td></tr>
                </tbody>
              </table>
              <p class="hint">Un tiret marque une donnée absente, pas un zéro : c'est ce qu'il faut renseigner.</p>
            </div>
          </div>
        </section>

        <!-- ---------- Échéances ---------- -->
        <section class="tab-panel" id="echeances">
          <div class="card">
            <div class="card-head"><h3><%= deadlines.total %> échéance(s) à 45 jours, dont <%= deadlines.overdue %> dépassée(s)</h3></div>
            <div class="row-actions">
              <% Object.entries(deadlines.bySource).forEach(([source, counts]) => { %>
                <span class="tag <%= counts.overdue ? 'tag-danger' : '' %>"><%= source %> : <%= counts.total %><%= counts.overdue ? ' (' + counts.overdue + ' en retard)' : '' %></span>
              <% }) %>
            </div>
          </div>

          <div class="card">
            <div class="table-wrap">
              <table>
                <thead><tr><th><%= t('erp.dueDate') %></th><th><%= t('common.source') %></th><th><%= t('common.subject') %></th><th><%= t('common.detail') %></th><th></th></tr></thead>
                <tbody>
                  <% deadlines.rows.forEach((row) => { %>
                    <tr>
                      <td class="<%= row.overdue ? 'text-danger cell-strong' : 'cell-sub' %> nowrap"><%= day(row.due) %></td>
                      <td><span class="tag <%= row.overdue ? 'tag-danger' : '' %>"><%= row.source %></span></td>
                      <td class="cell-strong"><%= row.label %></td>
                      <td class="cell-sub"><%= row.detail || '—' %></td>
                      <td><% if (row.link) { %><a class="btn btn-outline btn-sm" href="<%= row.link %>"><%= t('common.open') %></a><% } %></td>
                    </tr>
                  <% }) %>
                  <% if (deadlines.rows.length === 0) { %><tr><td colspan="5" class="cell-sub">Rien à 45 jours.</td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ---------- Projets ---------- -->
        <section class="tab-panel" id="projets">
          <div class="card">
            <div class="card-head"><h3><%= overview.projects.length %> projet(s) en cours</h3></div>
            <div class="table-wrap">
              <table>
                <thead><tr><th><%= t('common.project') %></th><th><%= t('common.status') %></th><th><%= t('erp.dueDate') %></th><th><%= t('common.hours') %></th><th><%= t('common.cost') %></th><th><%= t('common.budget') %></th><th><%= t('erp.consumed') %></th></tr></thead>
                <tbody>
                  <% overview.projects.forEach((p) => { %>
                    <tr>
                      <td><a class="cell-strong" href="/projets/<%= p.id %>"><%= p.name %></a></td>
                      <td><span class="tag"><%= st(p.status) %></span></td>
                      <td class="<%= p.late ? 'text-danger' : 'cell-sub' %> nowrap"><%= day(p.due_date) %></td>
                      <td class="cell-sub"><%= Math.round(p.hours * 10) / 10 %> h</td>
                      <td><%= money(p.cost) %></td>
                      <td class="cell-sub"><%= money(p.budget_amount) %></td>
                      <td>
                        <% if (p.consumed == null) { %>
                          <span class="cell-sub">—</span>
                        <% } else { %>
                          <span class="meter"><span class="meter-fill <%= p.consumed > 100 ? 'is-danger' : (p.consumed > 80 ? 'is-warn' : '') %>" data-ratio="<%= Math.min(100, p.consumed) %>"></span></span>
                          <span class="cell-sub"><%= p.consumed %> %</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (overview.projects.length === 0) { %><tr><td colspan="7" class="cell-sub">Aucun projet en cours.</td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ---------- Objectifs ---------- -->
        <section class="tab-panel" id="objectifs">
          <div class="card">
            <div class="card-head"><h3>Fixer un objectif</h3></div>
            <form method="POST" action="/pilotage/objectifs" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="span-2"><span><%= t('common.title') %></span><input type="text" name="title" required maxlength="200" placeholder="Réduire le délai de réponse au support" /></label>
              <label><span><%= t('common.scope') %></span>
                <select name="scope"><% scopes.forEach((s) => { %><option value="<%= s %>"><%= s %></option><% }) %></select>
              </label>
              <label><span><%= t('common.period') %></span><input type="text" name="period" maxlength="20" placeholder="2026-T1" /></label>
              <label class="span-2"><span>Service ou équipe (si portée restreinte)</span>
                <select name="scope_id">
                  <option value="">—</option>
                  <optgroup label="Services"><% departments.forEach((d) => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %></optgroup>
                  <optgroup label="Équipes"><% teams.forEach((tm) => { %><option value="<%= tm.id %>"><%= tm.name %></option><% }) %></optgroup>
                </select>
              </label>
              <label class="span-2"><span><%= t('gov.holder') %></span>
                <select name="owner_id"><option value="">—</option>
                  <% people.forEach((u) => { %><option value="<%= u.id %>"><%= u.first_name %> <%= u.last_name %></option><% }) %>
                </select>
              </label>
              <label class="span-2"><span><%= t('common.description') %></span><textarea name="description" rows="2"></textarea></label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.create') %></button></div>
            </form>
          </div>

          <% objectiveList.forEach((o) => { %>
            <div class="card">
              <div class="card-head">
                <h3><%= o.title %></h3>
                <span class="tag <%= o.status === 'Atteint' ? 'tag-success' : (o.status === 'Abandonné' ? 'tag-danger' : 'tag-accent') %>"><%= st(o.status) %></span>
              </div>
              <p class="cell-sub">
                <%= o.scope %><%= o.period ? ' · ' + o.period : '' %>
                <%= o.first_name ? ' · ' + o.first_name + ' ' + o.last_name : '' %>
                <%= o.description ? ' · ' + o.description : '' %>
              </p>
              <span class="meter"><span class="meter-fill <%= o.progress >= 100 ? '' : (o.progress < 34 ? 'is-warn' : '') %>" data-ratio="<%= o.progress %>"></span></span>
              <p class="cell-sub"><%= o.progress %> % — moyenne des résultats clés, chacun sur sa propre échelle.</p>

              <ul class="org-list">
                <% o.results.forEach((r) => { %>
                  <li class="org-item">
                    <span>
                      <span class="cell-strong"><%= r.title %></span>
                      <br /><span class="cell-sub">de <%= r.start_value %> à <%= r.target_value %> <%= r.unit %> — actuellement <%= r.current_value %></span>
                    </span>
                    <span class="row-actions">
                      <form method="POST" action="/pilotage/resultats/<%= r.id %>" class="inline-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="text" name="current_value" value="<%= r.current_value %>" class="input-sm" inputmode="decimal" />
                        <button type="submit" class="btn btn-sm"><%= t('common.update') %></button>
                      </form>
                      <form method="POST" action="/pilotage/resultats/<%= r.id %>/supprimer" class="inline-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-danger btn-sm"><%= t('common.remove') %></button>
                      </form>
                    </span>
                  </li>
                <% }) %>
                <% if (o.results.length === 0) { %><li class="cell-sub">Aucun résultat clé : l'objectif n'est pas mesurable en l'état.</li><% } %>
              </ul>

              <form method="POST" action="/pilotage/objectifs/<%= o.id %>/resultats" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2"><span>Résultat clé</span><input type="text" name="title" required maxlength="200" placeholder="Délai médian de première réponse" /></label>
                <label><span>Départ</span><input type="text" name="start_value" inputmode="decimal" value="0" required /></label>
                <label><span>Cible</span><input type="text" name="target_value" inputmode="decimal" required /></label>
                <label><span>Actuel</span><input type="text" name="current_value" inputmode="decimal" /></label>
                <label><span><%= t('common.unit') %></span><input type="text" name="unit" maxlength="20" placeholder="h, %, €" /></label>
                <div class="span-2"><button type="submit" class="btn btn-outline btn-block">Ajouter le résultat clé</button></div>
              </form>

              <div class="row-actions">
                <form method="POST" action="/pilotage/objectifs/<%= o.id %>/statut" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <select name="status" class="input-sm">
                    <% statuses.forEach((s) => { %><option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
                  </select>
                  <button type="submit" class="btn btn-sm">Changer le statut</button>
                </form>
                <form method="POST" action="/pilotage/objectifs/<%= o.id %>/supprimer" class="inline-form" data-confirm="Supprimer cet objectif et ses résultats clés ?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
                </form>
              </div>
            </div>
          <% }) %>
          <% if (objectiveList.length === 0) { %>
            <div class="card"><p class="cell-sub">Aucun objectif fixé.</p></div>
          <% } %>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/meter.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

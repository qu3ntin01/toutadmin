<%
/* En-tête des pages sans navigation latérale (espace membre, pages d'édition).
   Attend : headerTitle?, backHref?, backLabel?, showUser? */
%>
<header class="page-topbar">
  <div class="page-topbar-brand">
    <span class="brand-mark">SM</span>
    <span class="brand-text">
      <span class="brand-name"><%= t('app.name') %></span>
      <% if (typeof headerTitle !== 'undefined' && headerTitle) { %>
        <span class="brand-panel"><%= headerTitle %></span>
      <% } %>
    </span>
  </div>

  <div class="page-topbar-side">
    <%- include('theme-toggle') %>

    <% if (typeof extraLink !== 'undefined' && extraLink) { %>
      <a href="<%= extraLink.href %>" class="btn btn-primary"><%= extraLink.label %></a>
    <% } %>

    <% if (typeof backHref !== 'undefined' && backHref) { %>
      <a href="<%= backHref %>" class="btn btn-quiet">
        <%- include('icon', { name: 'back', iconSize: 16 }) %>
        <span class="btn-label"><%= typeof backLabel !== 'undefined' && backLabel ? backLabel : 'Retour' %></span>
      </a>
    <% } %>

    <% if (typeof showUser !== 'undefined' && showUser && currentUser) { %>
      <div class="user-chip">
        <span class="user-avatar"><%= currentUser.firstName.charAt(0) %><%= currentUser.lastName.charAt(0) %></span>
        <span class="user-meta">
          <span class="user-name"><%= currentUser.firstName %> <%= currentUser.lastName %></span>
          <span class="user-role"><%= currentUser.grade %></span>
        </span>
      </div>
      <form method="POST" action="/deconnexion">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn btn-quiet">
          <%- include('icon', { name: 'logout', iconSize: 16 }) %>
          <span class="btn-label">Déconnexion</span>
        </button>
      </form>
    <% } %>
  </div>
</header>

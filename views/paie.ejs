<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Paie — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: 'Moteur de paie',
      navItems: [
        { tab: 'bulletins', label: 'Bulletins', icon: 'card' },
        { tab: 'salaires', label: 'Salaires', icon: 'users' },
        { tab: 'baremes', label: 'Barèmes', icon: 'settings' }
      ],
      footLinks: [{ href: '/rh', label: t('nav.hrSpace'), icon: 'back' }]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: 'Moteur de paie',
        headerSubtitle: 'Du brut au net, part patronale et coût employeur'
      }) %>

      <main class="page">
        <% if (flash) { %>
          <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
        <% } %>

        <% const money = (n) => Number(n || 0).toLocaleString(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'; %>

        <div class="banner is-warning">
          <%- include('partials/icon', { name: 'shield', iconSize: 17 }) %>
          <span>
            Les taux ci-dessous sont ceux que vous saisissez. Ils sont pré-remplis à titre indicatif
            et doivent être vérifiés par votre gestionnaire de paie. Aucune DSN n'est produite.
          </span>
        </div>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'card', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(cost.gross) %></span><span class="stat-label">Brut <%= period %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'check', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(cost.net) %></span><span class="stat-label">Net à payer</span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'shield', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(cost.employer) %></span><span class="stat-label">Charges patronales</span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'ticket', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(cost.cost) %></span><span class="stat-label">Coût employeur</span></span>
          </div>
        </section>

        <!-- ---------- Bulletins ---------- -->
        <section class="tab-panel is-active" id="bulletins">
          <div class="grid-2">
            <div class="stack">
              <div class="card">
                <div class="card-head"><h3>Calculer un bulletin</h3></div>
                <form method="POST" action="/paie/bulletins" class="stack">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label>
                    <span><%= t('common.member') %></span>
                    <select name="employee_id" required>
                      <option value="">—</option>
                      <% staff.forEach((e) => { %>
                        <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %><%= e.gross_salary ? ' — ' + money(e.gross_salary) : '' %></option>
                      <% }) %>
                    </select>
                  </label>
                  <div class="form-grid">
                    <label>
                      <span><%= t('common.period') %></span>
                      <input type="text" name="period" value="<%= period %>" pattern="\d{4}-\d{2}" placeholder="AAAA-MM" required />
                    </label>
                    <label>
                      <span>Brut mensuel</span>
                      <input type="text" name="gross_salary" inputmode="decimal" required />
                    </label>
                  </div>
                  <button type="submit" class="btn btn-primary btn-block">Calculer</button>
                </form>
              </div>

              <div class="card">
                <div class="card-head"><h3>Génération en lot</h3></div>
                <form method="POST" action="/paie/bulletins/lot" class="stack">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label>
                    <span><%= t('common.period') %></span>
                    <input type="text" name="period" value="<%= period %>" pattern="\d{4}-\d{2}" required />
                  </label>
                  <button type="submit" class="btn btn-primary btn-block">Générer pour tout le personnel</button>
                  <p class="hint">Seuls les salariés dont le brut est renseigné sont traités. Un bulletin déjà émis n'est pas recalculé.</p>
                </form>
              </div>

              <div class="card">
                <div class="card-head"><h3>Simulateur</h3></div>
                <form method="GET" action="/paie" class="stack">
                  <input type="hidden" name="periode" value="<%= period %>" />
                  <label>
                    <span>Brut mensuel</span>
                    <input type="number" name="brut" step="0.01" min="0" value="<%= simulationGross || '' %>" required />
                  </label>
                  <button type="submit" class="btn btn-block">Simuler</button>
                </form>

                <% if (simulation) { %>
                  <table>
                    <tbody>
                      <tr><td class="cell-sub">Brut</td><td class="num cell-strong"><%= money(simulation.gross) %></td></tr>
                      <tr><td class="cell-sub">Cotisations salariales</td><td class="num">− <%= money(simulation.employeeTotal) %></td></tr>
                      <tr><td class="cell-sub">Net à payer</td><td class="num cell-strong"><%= money(simulation.net) %></td></tr>
                      <tr><td class="cell-sub">Charges patronales</td><td class="num"><%= money(simulation.employerTotal) %></td></tr>
                      <tr><td class="cell-sub">Coût employeur</td><td class="num cell-strong"><%= money(simulation.employerCost) %></td></tr>
                    </tbody>
                  </table>
                <% } %>
              </div>
            </div>

            <div class="card">
              <div class="card-head">
                <div>
                  <h3>Bulletins <span class="muted">(<%= payslips.length %>)</span></h3>
                  <p class="card-sub">Un bulletin calculé porte le détail de ses cotisations ; une fiche saisie à la main n'en a pas.</p>
                </div>
              </div>
              <% if (payslips.length === 0) { %>
                <div class="empty-state">Aucun bulletin.</div>
              <% } else { %>
                <ul class="meeting-list">
                  <% payslips.slice(0, 20).forEach((p) => { %>
                    <li class="meeting-item">
                      <div class="meeting-head">
                        <span class="meeting-title"><%= p.first_name %> <%= p.last_name %> — <%= p.period %></span>
                        <span class="status <%= p.status === 'Payée' ? 'status-on' : 'status-warning' %>"><%= p.status %></span>
                      </div>
                      <p class="cell-sub">
                        Brut <%= money(p.gross_amount) %> · Net <%= money(p.net_amount) %>
                        <%= p.line_count ? ' · Coût employeur ' + money(p.employer_cost) : '' %>
                      </p>
                      <% if (p.line_count) { %>
                        <details class="minutes">
                          <summary>Détail des cotisations (<%= p.line_count %>)</summary>
                          <div class="table-wrap">
                            <table>
                              <thead><tr><th>Cotisation</th><th>Base</th><th>Salarial</th><th>Patronal</th></tr></thead>
                              <tbody>
                                <% linesOf(p.id).forEach((l) => { %>
                                  <tr>
                                    <td class="cell-sub"><%= l.label %></td>
                                    <td class="num"><%= money(l.base_amount) %></td>
                                    <td class="num"><%= l.employee_rate %> % · <%= money(l.employee_amount) %></td>
                                    <td class="num"><%= l.employer_rate %> % · <%= money(l.employer_amount) %></td>
                                  </tr>
                                <% }) %>
                              </tbody>
                            </table>
                          </div>
                        </details>
                      <% } else { %>
                        <p class="cell-sub">Fiche saisie manuellement, sans détail de cotisations.</p>
                      <% } %>
                    </li>
                  <% }) %>
                </ul>
              <% } %>
            </div>
          </div>
        </section>

        <!-- ---------- Salaires ---------- -->
        <section class="tab-panel" id="salaires">
          <div class="card">
            <div class="card-head">
              <div>
                <h3>Salaires bruts <span class="muted">(<%= staff.length %>)</span></h3>
                <p class="card-sub">Le brut mensuel de référence, repris par la génération en lot.</p>
              </div>
            </div>
            <% if (staff.length === 0) { %>
              <div class="empty-state">Aucun salarié non-freelance.</div>
            <% } else { %>
              <div class="table-wrap">
                <table>
                  <thead><tr><th><%= t('common.member') %></th><th><%= t('common.contract') %></th><th>Brut mensuel</th><th>Net estimé</th></tr></thead>
                  <tbody>
                    <% staff.forEach((e) => { %>
                      <tr>
                        <td>
                          <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                          <div class="cell-sub"><%= e.grade %></div>
                        </td>
                        <td><span class="tag"><%= e.contract_type || '—' %></span></td>
                        <td>
                          <form method="POST" action="/paie/salaires/<%= e.id %>" class="inline-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <input type="text" name="gross_salary" class="input-sm" inputmode="decimal" value="<%= e.gross_salary || '' %>" />
                            <button type="submit" class="btn btn-sm"><%= t('common.save') %></button>
                          </form>
                        </td>
                        <td class="num cell-sub">
                          <%= e.gross_salary ? money(netOf(e.gross_salary)) : '—' %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </section>

        <!-- ---------- Barèmes ---------- -->
        <section class="tab-panel" id="baremes">
          <div class="grid-2">
            <div class="stack">
              <div class="card">
                <div class="card-head"><h3>Ajouter une cotisation</h3></div>
                <form method="POST" action="/paie/baremes" class="stack">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label>
                    <span>Intitulé</span>
                    <input type="text" name="label" maxlength="120" required />
                  </label>
                  <div class="form-grid">
                    <label>
                      <span>Base</span>
                      <select name="base">
                        <% rateBases.forEach((b) => { %><option value="<%= b %>"><%= b %></option><% }) %>
                      </select>
                    </label>
                    <label>
                      <span>Ordre</span>
                      <input type="number" name="sort_order" min="0" max="999" value="90" />
                    </label>
                    <label>
                      <span>Taux salarial (%)</span>
                      <input type="text" name="employee_rate" inputmode="decimal" value="0" />
                    </label>
                    <label>
                      <span>Taux patronal (%)</span>
                      <input type="text" name="employer_rate" inputmode="decimal" value="0" />
                    </label>
                  </div>
                  <button type="submit" class="btn btn-primary btn-block"><%= t('common.create') %></button>
                  <p class="hint">« Plafond » applique le taux sur la part du brut limitée au plafond mensuel.</p>
                </form>
              </div>

              <div class="card">
                <div class="card-head"><h3>Plafond mensuel</h3></div>
                <form method="POST" action="/paie/plafond" class="stack">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label>
                    <span>Plafond de la sécurité sociale</span>
                    <input type="text" name="ceiling" inputmode="decimal" value="<%= ceiling %>" required />
                  </label>
                  <button type="submit" class="btn btn-block"><%= t('common.save') %></button>
                  <p class="hint">Il change chaque année : c'est un paramètre, pas une constante du logiciel.</p>
                </form>
              </div>
            </div>

            <div class="card">
              <div class="card-head"><h3>Barème <span class="muted">(<%= rates.length %>)</span></h3></div>
              <div class="table-wrap">
                <table>
                  <thead><tr><th>Cotisation</th><th>Base</th><th>Salarial</th><th>Patronal</th><th class="actions"></th></tr></thead>
                  <tbody>
                    <% rates.forEach((r) => { %>
                      <tr class="<%= r.active ? '' : 'muted' %>">
                        <td class="cell-strong"><%= r.label %></td>
                        <td><span class="tag"><%= r.base %></span></td>
                        <td class="num"><%= r.employee_rate %> %</td>
                        <td class="num"><%= r.employer_rate %> %</td>
                        <td class="actions">
                          <form method="POST" action="/paie/baremes/<%= r.id %>/statut" class="inline-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-sm"><%= r.active ? 'Désactiver' : 'Activer' %></button>
                          </form>
                          <form method="POST" action="/paie/baremes/<%= r.id %>/supprimer" class="inline-form" data-confirm="Supprimer cette cotisation du barème ?">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

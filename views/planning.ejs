<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Planning — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('nav.planning'),
      navItems: [
        { tab: 'semaine', label: t('pln.tabWeek'), icon: 'calendar' },
        { tab: 'astreintes', label: t('pln.tabOnCall'), icon: 'shield', badge: onCallList.length },
        { tab: 'roulements', label: t('pln.tabRotations'), icon: 'clock' },
        { tab: 'charge', label: t('pln.tabLoad'), icon: 'network' }
      ],
      footLinks: [
        { href: '/mon-espace', label: t('nav.mySpace'), icon: 'home' },
        { href: '/agenda', label: t('nav.agenda'), icon: 'calendar' }
      ]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('pln.title'),
        headerSubtitle: planner ? "Postes, roulements et astreintes de votre périmètre" : 'Vos créneaux planifiés'
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const day = (iso) => new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC', day: '2-digit', month: '2-digit' }); %>
        <% const hour = (moment) => moment.slice(11, 16); %>

        <!-- ---------- Semaine ---------- -->
        <section class="tab-panel is-active" id="semaine">
          <div class="card">
            <div class="card-head">
              <h3><%= t('pln.weekOf', { start: day(start), end: day(end) }) %></h3>
              <span class="card-sub"><%= t('pln.plannedPeople', { count: week.rows.length }) %></span>
            </div>
            <div class="pager">
              <a href="/planning?semaine=<%= previousWeek %><%= teamId ? `&equipe=${teamId}` : '' %>" class="btn btn-outline btn-sm"><%= t('pln.previousWeek') %></a>
              <a href="/planning?semaine=<%= today %><%= teamId ? `&equipe=${teamId}` : '' %>" class="btn btn-outline btn-sm"><%= t('pln.thisWeek') %></a>
              <a href="/planning?semaine=<%= nextWeek %><%= teamId ? `&equipe=${teamId}` : '' %>" class="btn btn-outline btn-sm"><%= t('pln.nextWeek') %></a>
            </div>

            <% if (planner && teams.length) { %>
              <form method="GET" action="/planning" class="form-grid">
                <input type="hidden" name="semaine" value="<%= start %>" />
                <label><span><%= t('common.team') %></span>
                  <select name="equipe">
                    <option value=""><%= t('hr.filterAll') %></option>
                    <% teams.forEach((tm) => { %><option value="<%= tm.id %>" <%= tm.id === teamId ? 'selected' : '' %>><%= tm.name %></option><% }) %>
                  </select>
                </label>
                <div><button type="submit" class="btn btn-outline btn-block"><%= t('common.filter') %></button></div>
              </form>
            <% } %>

            <% if (!week.rows.length) { %>
              <p class="empty-state"><%= t('pln.noSlotThisWeek') %></p>
            <% } else { %>
              <div class="table-wrap">
                <table class="planning-grid">
                  <thead>
                    <tr>
                      <th><%= t('common.person') %></th>
                      <% week.days.forEach((d) => { %><th class="matrix-head"><%= d.short %><br /><span class="cell-sub"><%= day(d.date) %></span></th><% }) %>
                      <th class="matrix-head"><%= t('common.hours') %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% week.rows.forEach((row) => { %>
                      <tr>
                        <td class="cell-strong"><%= row.name %></td>
                        <% week.days.forEach((d) => { %>
                          <td class="planning-cell">
                            <% (row.days[d.date] || []).forEach((s) => { %>
                              <span class="shift shift-<%= s.kind === 'Astreinte' ? 'oncall' : (s.kind === 'Télétravail' ? 'remote' : 'shift') %><%= s.published ? '' : ' is-draft' %>">
                                <span class="shift-time"><%= hour(s.starts_at) %>–<%= hour(s.ends_at) %></span>
                                <span class="shift-label"><%= s.label || s.kind %></span>
                                <% if (planner) { %>
                                  <form method="POST" action="/planning/creneaux/<%= s.id %>/supprimer" class="inline-form" data-confirm="<%= t('pln.confirmRemoveSlot') %>">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                    <button type="submit" class="btn btn-link btn-sm">×</button>
                                  </form>
                                <% } %>
                              </span>
                            <% }) %>
                          </td>
                        <% }) %>
                        <td class="num"><%= row.hours %> h</td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <p class="hint"><%= t('pln.draftNote') %></p>
            <% } %>
          </div>

          <% if (planner) { %>
            <div class="card">
              <div class="card-head"><h3><%= t('pln.addSlot') %></h3></div>
              <form method="POST" action="/planning/creneaux" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="week" value="<%= start %>" />
                <label><span><%= t('common.person') %></span>
                  <select name="user_id" required>
                    <% people.forEach((p) => { %><option value="<%= p.id %>"><%= p.first_name %> <%= p.last_name %></option><% }) %>
                  </select>
                </label>
                <label><span><%= t('common.nature') %></span>
                  <select name="kind"><% kinds.forEach((k) => { %><option value="<%= k %>"><%= k %></option><% }) %></select>
                </label>
                <label><span><%= t('common.day') %></span><input type="date" name="day" value="<%= start %>" required /></label>
                <label><span><%= t('messages.from') %></span><input type="time" name="start_time" value="09:00" required /></label>
                <label><span><%= t('pln.endDay') %></span><input type="date" name="end_day" /></label>
                <label><span>À</span><input type="time" name="end_time" value="17:00" required /></label>
                <label><span><%= t('common.label') %></span><input type="text" name="label" maxlength="160" placeholder="<%= t('pln.slotPlaceholder') %>" /></label>
                <label><span><%= t('common.place') %></span><input type="text" name="location" maxlength="160" /></label>
                <label><span><%= t('common.team') %></span>
                  <select name="team_id">
                    <option value="">—</option>
                    <% teams.forEach((tm) => { %><option value="<%= tm.id %>"><%= tm.name %></option><% }) %>
                  </select>
                </label>
                <label class="check-row"><input type="checkbox" name="published" value="1" /><span><%= t('pln.publishNow') %></span></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('pln.addTheSlot') %></button></div>
              </form>
              <p class="hint"><%= t('pln.overlapNote') %></p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('pln.publishWeek') %></h3></div>
              <form method="POST" action="/planning/publier" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="week" value="<%= start %>" />
                <% if (teamId) { %><input type="hidden" name="team_id" value="<%= teamId %>" /><% } %>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('pln.publishDraftsOf', { date: day(start) }) %></button></div>
              </form>
            </div>
          <% } %>
        </section>

        <!-- ---------- Astreintes ---------- -->
        <section class="tab-panel" id="astreintes">
          <div class="card">
            <div class="card-head"><h3><%= t('pln.onCallNow') %></h3></div>
            <% if (!onCallNow.length) { %>
              <p class="empty-state"><%= t('pln.nobodyOnCall') %></p>
            <% } else { %>
              <ul class="person-list">
                <% onCallNow.forEach((s) => { %>
                  <li class="person-row">
                    <span class="person-body">
                      <span class="person-name"><%= s.first_name %> <%= s.last_name %></span>
                      <span class="person-role"><%= t('pln.untilAt', { date: day(s.ends_at.slice(0, 10)), hour: hour(s.ends_at) }) %><%= s.phone ? ` · ${s.phone}` : '' %></span>
                    </span>
                    <span class="tag tag-success"><%= t('status.running') %></span>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('pln.weekOnCall') %></h3></div>
            <% if (!onCallList.length) { %>
              <p class="empty-state"><%= t('pln.noOnCall') %></p>
            <% } else { %>
              <div class="table-wrap">
                <table>
                  <thead><tr><th><%= t('common.person') %></th><th><%= t('common.start') %></th><th><%= t('common.end') %></th><th><%= t('common.duration') %></th><th><%= t('common.state') %></th></tr></thead>
                  <tbody>
                    <% onCallList.forEach((s) => { %>
                      <tr>
                        <td class="cell-strong"><%= s.first_name %> <%= s.last_name %></td>
                        <td class="cell-sub nowrap"><%= day(s.starts_at.slice(0, 10)) %> <%= hour(s.starts_at) %></td>
                        <td class="cell-sub nowrap"><%= day(s.ends_at.slice(0, 10)) %> <%= hour(s.ends_at) %></td>
                        <td class="num"><%= s.hours %> h</td>
                        <td><span class="tag <%= s.published ? 'tag-success' : 'tag-warning' %>"><%= s.published ? 'Publiée' : 'Brouillon' %></span></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </section>

        <!-- ---------- Roulements ---------- -->
        <section class="tab-panel" id="roulements">
          <% if (planner) { %>
            <div class="card">
              <div class="card-head"><h3><%= t('pln.createRotation') %></h3></div>
              <form method="POST" action="/planning/roulements" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="week" value="<%= start %>" />
                <label><span><%= t('common.name') %></span><input type="text" name="name" required maxlength="120" placeholder="<%= t('pln.rotationPlaceholder') %>" /></label>
                <label><span><%= t('common.nature') %></span>
                  <select name="kind"><% kinds.forEach((k) => { %><option value="<%= k %>"><%= k %></option><% }) %></select>
                </label>
                <label><span><%= t('messages.from') %></span><input type="time" name="start_time" value="06:00" required /></label>
                <label><span>À</span><input type="time" name="end_time" value="14:00" required /></label>
                <label class="span-2"><span><%= t('common.days') %></span>
                  <span class="filter-pills">
                    <% weekdays.forEach((d) => { %>
                      <label class="check-row"><input type="checkbox" name="weekdays" value="<%= d.value %>" <%= d.value <= 5 ? 'checked' : '' %> /><span><%= d.short %></span></label>
                    <% }) %>
                  </span>
                </label>
                <label class="span-2"><span><%= t('common.place') %></span><input type="text" name="location" maxlength="160" /></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('pln.saveRotation') %></button></div>
              </form>
              <p class="hint"><%= t('pln.nightShiftNote') %></p>
            </div>
          <% } %>

          <div class="card">
            <div class="card-head"><h3><%= templateList.length %> roulement(s)</h3></div>
            <% if (!templateList.length) { %>
              <p class="empty-state"><%= t('pln.noRotation') %></p>
            <% } else { %>
              <ul class="meeting-list">
                <% templateList.forEach((tp) => { %>
                  <li class="meeting-item">
                    <div class="meeting-head">
                      <span class="meeting-title"><%= tp.name %></span>
                      <span class="tag"><%= tp.kind %></span>
                    </div>
                    <p class="cell-sub">
                      <%= tp.start_time %> – <%= tp.end_time %><%= tp.end_time <= tp.start_time ? ' (nuit)' : '' %>
                      · <%= weekdays.filter((d) => tp.days.includes(d.value)).map((d) => d.short).join(', ') %>
                      <%= tp.location ? ` · ${tp.location}` : '' %>
                    </p>
                    <% if (planner) { %>
                      <form method="POST" action="/planning/roulements/<%= tp.id %>/appliquer" class="form-grid">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="week" value="<%= start %>" />
                        <label><span><%= t('common.person') %></span>
                          <select name="user_id" required>
                            <% people.forEach((p) => { %><option value="<%= p.id %>"><%= p.first_name %> <%= p.last_name %></option><% }) %>
                          </select>
                        </label>
                        <label><span><%= t('leave.from') %></span><input type="date" name="from" value="<%= start %>" required /></label>
                        <label><span><%= t('leave.to') %></span><input type="date" name="to" value="<%= end %>" required /></label>
                        <label class="check-row"><input type="checkbox" name="published" value="1" /><span><%= t('common.publish') %></span></label>
                        <div class="span-2"><button type="submit" class="btn btn-outline btn-block"><%= t('common.apply') %></button></div>
                      </form>
                      <div class="row-actions">
                        <form method="POST" action="/planning/roulements/<%= tp.id %>/supprimer" class="inline-form" data-confirm="<%= t('pln.confirmDeleteRotation') %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <input type="hidden" name="week" value="<%= start %>" />
                          <button type="submit" class="btn btn-link btn-sm"><%= t('common.delete') %></button>
                        </form>
                      </div>
                    <% } %>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </section>

        <!-- ---------- Charge ---------- -->
        <section class="tab-panel" id="charge">
          <div class="card">
            <div class="card-head"><h3><%= t('pln.plannedHours', { start: day(start), end: day(end) }) %></h3></div>
            <% if (!planner) { %>
              <div class="table-wrap">
                <table>
                  <thead><tr><th><%= t('common.day') %></th><th><%= t('pln.slot') %></th><th><%= t('common.nature') %></th><th><%= t('common.duration') %></th></tr></thead>
                  <tbody>
                    <% mine.forEach((s) => { %>
                      <tr>
                        <td class="cell-sub nowrap"><%= day(s.day) %></td>
                        <td class="cell-strong"><%= hour(s.starts_at) %>–<%= hour(s.ends_at) %><%= s.label ? ` · ${s.label}` : '' %></td>
                        <td class="cell-sub"><%= s.kind %></td>
                        <td class="num"><%= s.hours %> h</td>
                      </tr>
                    <% }) %>
                    <% if (!mine.length) { %><tr><td colspan="4" class="cell-sub"><%= t('pln.noSlotThisWeekShort') %></td></tr><% } %>
                  </tbody>
                </table>
              </div>
            <% } else if (!loadList.length) { %>
              <p class="empty-state"><%= t('pln.nothingPlanned') %></p>
            <% } else { %>
              <div class="table-wrap">
                <table>
                  <thead><tr><th><%= t('common.person') %></th><th><%= t('pln.slots') %></th><th><%= t('pln.tabOnCall') %></th><th><%= t('common.hours') %></th><th><%= t('pln.distribution') %></th></tr></thead>
                  <tbody>
                    <% const maxHours = Math.max(...loadList.map((l) => l.hours), 1); %>
                    <% loadList.forEach((l) => { %>
                      <tr>
                        <td class="cell-strong"><%= l.name %></td>
                        <td><%= l.shifts %></td>
                        <td><%= l.onCall %></td>
                        <td class="num"><%= l.hours %> h</td>
                        <td><span class="meter"><span class="meter-fill <%= l.hours > 48 ? 'is-over' : (l.hours > 40 ? 'is-warn' : '') %>" data-ratio="<%= Math.round(l.hours * 100 / maxHours) %>"></span></span></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <p class="hint"><%= t('pln.imbalanceNote') %></p>
            <% } %>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
  <script src="/js/meter.js"></script>
</body>
</html>

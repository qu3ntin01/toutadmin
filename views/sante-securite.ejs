<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Santé et sécurité — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('nav.healthSafety'),
      navItems: [
        { tab: 'risques', label: t('sst.singleDocument'), icon: 'shield' },
        { tab: 'accidents', label: t('sst.accidentRegister'), icon: 'ticket' },
        { tab: 'protections', label: t('erp.assets'), icon: 'tool' },
        { tab: 'visites', label: t('sst.medicalVisits'), icon: 'calendar' },
        { tab: 'echeances', label: t('sst.deadlines'), icon: 'clock', badge: upcoming.visits.length + upcoming.ppe.length + upcoming.risks.length }
      ],
      footLinks: [{ href: '/rh', label: t('nav.hrSpace'), icon: 'back' }]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('sst.title'),
        headerSubtitle: t('sst.subtitle')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const day = (iso) => (iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>
        <% const fullName = (r) => [r.first_name, r.last_name].filter(Boolean).join(' ') || '—'; %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'shield', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= riskList.filter((r) => r.critical).length %></span><span class="stat-label"><%= t('sst.risksNeedingAction') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'ticket', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= indicators.accidents %></span><span class="stat-label"><%= t('sst.lostTimeAccidents12') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'network', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= indicators.frequency %></span><span class="stat-label"><%= t('sst.frequencyRate') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clock', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= indicators.severity %></span><span class="stat-label"><%= t('sst.severityRate') %></span></span>
          </div>
        </section>

        <!-- ---------- Document unique ---------- -->
        <section class="tab-panel is-active" id="risques">
          <div class="card">
            <div class="card-head"><h3><%= t('sst.recordRisk') %></h3></div>
            <form method="POST" action="/sante-securite/risques" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label><span><%= t('sst.workUnit') %></span><input type="text" name="unit" required maxlength="120" placeholder="<%= t('sst.workUnitExample') %>" /></label>
              <label><span><%= t('sst.hazard') %></span><input type="text" name="hazard" required maxlength="200" placeholder="<%= t('sst.hazardExample') %>" /></label>
              <label class="span-2"><span><%= t('sst.exposure') %></span><input type="text" name="exposure" maxlength="300" placeholder="<%= t('sst.exposureExample') %>" /></label>
              <label><span><%= t('sst.severity4') %></span>
                <select name="severity"><% severities.forEach((s) => { %><option value="<%= s %>" <%= s === 2 ? 'selected' : '' %>><%= s %></option><% }) %></select>
              </label>
              <label><span><%= t('sst.probability4') %></span>
                <select name="likelihood"><% likelihoods.forEach((l) => { %><option value="<%= l %>" <%= l === 2 ? 'selected' : '' %>><%= l %></option><% }) %></select>
              </label>
              <label class="span-2"><span><%= t('sst.preventiveMeasures') %></span><textarea name="measures" rows="3" placeholder="<%= t('sst.measuresExample') %>"></textarea></label>
              <label><span><%= t('sst.assessedOn') %></span><input type="date" name="reviewed_on" value="<%= today %>" /></label>
              <label><span><%= t('gov.nextReview') %></span><input type="date" name="next_review" /></label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.record') %></button></div>
            </form>
            <p class="hint"><%= t('sst.criticalityHelp', { threshold: actionThreshold }) %></p>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('sst.risksAssessed', { count: riskList.length }) %></h3></div>
            <div class="table-wrap">
              <table>
                <thead><tr><th><%= t('common.unit') %></th><th><%= t('sst.hazard') %></th><th>G</th><th>P</th><th><%= t('sst.criticality') %></th><th><%= t('common.measures') %></th><th><%= t('common.review') %></th><th></th></tr></thead>
                <tbody>
                  <% riskList.forEach((r) => { %>
                    <tr>
                      <td class="cell-sub"><%= r.unit %></td>
                      <td class="cell-strong"><%= r.hazard %><% if (r.exposure) { %><br /><span class="cell-sub"><%= r.exposure %></span><% } %></td>
                      <td><%= r.severity %></td>
                      <td><%= r.likelihood %></td>
                      <td><span class="tag <%= r.critical ? 'tag-danger' : 'tag-success' %>"><%= r.score %></span></td>
                      <td class="cell-sub audit-detail"><%= r.measures || '—' %></td>
                      <td class="cell-sub nowrap"><%= day(r.next_review) %></td>
                      <td>
                        <form method="POST" action="/sante-securite/risques/<%= r.id %>/supprimer" class="inline-form" data-confirm="<%= t('sst.deleteRisk') %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit" class="btn btn-danger btn-sm"><%= t('common.remove') %></button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (riskList.length === 0) { %><tr><td colspan="8" class="cell-sub"><%= t('sst.emptyDocument') %></td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ---------- Accidents ---------- -->
        <section class="tab-panel" id="accidents">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('sst.recordEvent') %></h3></div>
              <form method="POST" action="/sante-securite/accidents" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label><span><%= t('sst.occurredOn') %></span><input type="date" name="occurred_on" max="<%= today %>" value="<%= today %>" required /></label>
                <label><span><%= t('common.nature') %></span>
                  <select name="kind"><% incidentKinds.forEach((k) => { %><option value="<%= k %>"><%= k %></option><% }) %></select>
                </label>
                <label class="span-2"><span><%= t('sst.personConcerned') %></span>
                  <select name="user_id"><option value="">—</option>
                    <% employees.forEach((u) => { %><option value="<%= u.id %>"><%= fullName(u) %></option><% }) %>
                  </select>
                </label>
                <label class="span-2"><span><%= t('common.place') %></span><input type="text" name="location" maxlength="160" /></label>
                <label class="span-2"><span><%= t('sst.circumstances') %></span><textarea name="description" rows="3"></textarea></label>
                <label><span><%= t('sst.daysOff') %></span><input type="number" name="days_off" min="0" max="3650" value="0" /></label>
                <label><span><%= t('sst.declaredOn') %></span><input type="date" name="declared_on" /></label>
                <label class="span-2"><span><%= t('sst.followUp') %></span><textarea name="follow_up" rows="2"></textarea></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.record') %></button></div>
              </form>
              <p class="hint"><%= t('sst.registerNotice') %></p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('sst.twelveMonthIndicators') %></h3></div>
              <table>
                <tbody>
                  <tr><td class="cell-sub"><%= t('common.headcount') %></td><td class="cell-strong"><%= indicators.headcount %></td></tr>
                  <tr><td class="cell-sub"><%= t('sst.hoursWorked') %></td><td><%= indicators.worked.toLocaleString(locale) %></td></tr>
                  <tr><td class="cell-sub"><%= t('sst.lostTimeAccidents') %></td><td><%= indicators.accidents %></td></tr>
                  <tr><td class="cell-sub"><%= t('sst.daysLost') %></td><td><%= indicators.daysOff %></td></tr>
                  <tr><td class="cell-sub"><%= t('sst.frequencyRate') %></td><td class="cell-strong"><%= indicators.frequency %></td></tr>
                  <tr><td class="cell-sub"><%= t('sst.severityRate') %></td><td class="cell-strong"><%= indicators.severity %></td></tr>
                </tbody>
              </table>
              <p class="hint">
                <%= t('sst.ratesHelp') %>
              </p>
            </div>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('sst.registerCount', { count: incidentList.length }) %></h3></div>
            <div class="table-wrap">
              <table>
                <thead><tr><th><%= t('common.date') %></th><th><%= t('common.nature') %></th><th><%= t('common.person') %></th><th><%= t('common.place') %></th><th><%= t('sst.stopped') %></th><th><%= t('sst.declared') %></th><th></th></tr></thead>
                <tbody>
                  <% incidentList.forEach((i) => { %>
                    <tr>
                      <td class="cell-sub nowrap"><%= day(i.occurred_on) %></td>
                      <td><span class="tag <%= i.kind === 'Presque-accident' ? '' : 'tag-danger' %>"><%= i.kind %></span></td>
                      <td><%= fullName(i) %></td>
                      <td class="cell-sub"><%= i.location || '—' %><% if (i.description) { %><br /><span class="cell-sub"><%= i.description %></span><% } %></td>
                      <td class="cell-strong"><%= i.days_off %> j</td>
                      <td class="cell-sub nowrap"><%= day(i.declared_on) %></td>
                      <td>
                        <form method="POST" action="/sante-securite/accidents/<%= i.id %>/supprimer" class="inline-form" data-confirm="<%= t('sst.deleteEntry') %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit" class="btn btn-danger btn-sm"><%= t('common.remove') %></button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (incidentList.length === 0) { %><tr><td colspan="7" class="cell-sub"><%= t('sst.noEvent') %></td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ---------- Protections ---------- -->
        <section class="tab-panel" id="protections">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('sst.declareEquipment') %></h3></div>
              <form method="POST" action="/sante-securite/protections" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2"><span><%= t('common.title') %></span><input type="text" name="name" required maxlength="120" placeholder="<%= t('sst.equipmentExample') %>" /></label>
                <label><span><%= t('common.category') %></span><input type="text" name="category" value="Protection" maxlength="60" /></label>
                <label><span><%= t('sst.validityMonths') %></span><input type="number" name="validity_months" min="1" max="600" placeholder="60" /></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.declare') %></button></div>
              </form>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('sst.handOverTo') %></h3></div>
              <form method="POST" action="/sante-securite/protections/remettre" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2"><span><%= t('common.equipment') %></span>
                  <select name="ppe_id" required><option value="">—</option>
                    <% ppeList.forEach((p) => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
                  </select>
                </label>
                <label class="span-2"><span><%= t('common.person') %></span>
                  <select name="user_id" required><option value="">—</option>
                    <% employees.forEach((u) => { %><option value="<%= u.id %>"><%= fullName(u) %></option><% }) %>
                  </select>
                </label>
                <label class="span-2"><span><%= t('sst.handedOn') %></span><input type="date" name="issued_on" value="<%= today %>" required /></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('sst.recordHandOver') %></button></div>
              </form>
            </div>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('sst.inCirculation', { count: ppeGiven.length }) %></h3></div>
            <div class="table-wrap">
              <table>
                <thead><tr><th><%= t('common.equipment') %></th><th><%= t('common.holder') %></th><th><%= t('sst.handedOn') %></th><th><%= t('erp.dueDate') %></th><th></th></tr></thead>
                <tbody>
                  <% ppeGiven.forEach((a) => { %>
                    <tr>
                      <td class="cell-strong"><%= a.name %><br /><span class="cell-sub"><%= a.category %></span></td>
                      <td><%= fullName(a) %></td>
                      <td class="cell-sub nowrap"><%= day(a.issued_on) %></td>
                      <td class="<%= a.expires_on && a.expires_on < today ? 'text-danger' : 'cell-sub' %> nowrap"><%= day(a.expires_on) %></td>
                      <td>
                        <form method="POST" action="/sante-securite/protections/remises/<%= a.id %>/rendre" class="inline-form">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit" class="btn btn-outline btn-sm"><%= t('sst.returned') %></button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (ppeGiven.length === 0) { %><tr><td colspan="5" class="cell-sub"><%= t('sst.noneInCirculation') %></td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('hr.catalogue') %></h3></div>
            <ul class="org-list">
              <% ppeList.forEach((p) => { %>
                <li class="org-item">
                  <span><span class="cell-strong"><%= p.name %></span><br /><span class="cell-sub"><%= p.category %><%= ' · ' + (p.validity_months ? t('sst.monthsValidity', { count: p.validity_months }) : t('sst.noExpiry')) %></span></span>
                  <form method="POST" action="/sante-securite/protections/<%= p.id %>/supprimer" class="inline-form" data-confirm="<%= t('sst.deleteEquipment') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
                  </form>
                </li>
              <% }) %>
              <% if (ppeList.length === 0) { %><li class="cell-sub"><%= t('sst.noEquipment') %></li><% } %>
            </ul>
          </div>
        </section>

        <!-- ---------- Visites ---------- -->
        <section class="tab-panel" id="visites">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('sst.recordVisit') %></h3></div>
              <form method="POST" action="/sante-securite/visites" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2"><span><%= t('common.person') %></span>
                  <select name="user_id" required><option value="">—</option>
                    <% employees.forEach((u) => { %><option value="<%= u.id %>"><%= fullName(u) %></option><% }) %>
                  </select>
                </label>
                <label class="span-2"><span><%= t('common.type') %></span>
                  <select name="kind"><% visitKinds.forEach((k) => { %><option value="<%= k %>"><%= k %></option><% }) %></select>
                </label>
                <label><span><%= t('sst.scheduledOn') %></span><input type="date" name="scheduled_on" /></label>
                <label><span><%= t('sst.performedOn') %></span><input type="date" name="done_on" /></label>
                <label class="span-2"><span><%= t('sst.opinion') %></span><input type="text" name="verdict" maxlength="200" placeholder="<%= t('sst.opinionExample') %>" /></label>
                <label class="span-2"><span><%= t('sst.nextDue') %></span><input type="date" name="next_due" /></label>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.record') %></button></div>
              </form>
              <p class="hint"><%= t('sst.medicalNotice') %></p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('sst.visitsTracked', { count: visitList.length }) %></h3></div>
              <ul class="org-list">
                <% visitList.forEach((v) => { %>
                  <li class="org-item">
                    <span>
                      <span class="cell-strong"><%= fullName(v) %></span>
                      <br /><span class="cell-sub"><%= v.kind %><%= v.verdict ? ' · ' + v.verdict : '' %> <%= t('sst.performed') %> <%= day(v.done_on) %> · <%= t('ges.next') %> <%= day(v.next_due) %></span>
                    </span>
                    <form method="POST" action="/sante-securite/visites/<%= v.id %>/supprimer" class="inline-form" data-confirm="<%= t('sst.deleteVisit') %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-danger btn-sm"><%= t('common.remove') %></button>
                    </form>
                  </li>
                <% }) %>
                <% if (visitList.length === 0) { %><li class="cell-sub"><%= t('sst.noVisit') %></li><% } %>
              </ul>
            </div>
          </div>
        </section>

        <!-- ---------- Échéances ---------- -->
        <section class="tab-panel" id="echeances">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('sst.visitsDue') %></h3></div>
              <ul class="org-list">
                <% upcoming.visits.forEach((v) => { %>
                  <li class="org-item"><span class="cell-strong"><%= fullName(v) %></span><span class="cell-sub"><%= v.kind %> · <%= day(v.next_due) %></span></li>
                <% }) %>
                <% if (upcoming.visits.length === 0) { %><li class="cell-sub"><%= t('sst.nothingIn60') %></li><% } %>
              </ul>
            </div>
            <div class="card">
              <div class="card-head"><h3><%= t('sst.protectionsToReplace') %></h3></div>
              <ul class="org-list">
                <% upcoming.ppe.forEach((a) => { %>
                  <li class="org-item"><span class="cell-strong"><%= a.name %></span><span class="cell-sub"><%= fullName(a) %> · <%= day(a.expires_on) %></span></li>
                <% }) %>
                <% if (upcoming.ppe.length === 0) { %><li class="cell-sub"><%= t('sst.nothingIn60') %></li><% } %>
              </ul>
            </div>
            <div class="card">
              <div class="card-head"><h3><%= t('sst.risksToReassess') %></h3></div>
              <ul class="org-list">
                <% upcoming.risks.forEach((r) => { %>
                  <li class="org-item"><span class="cell-strong"><%= r.hazard %></span><span class="cell-sub"><%= r.unit %> · <%= day(r.next_review) %></span></li>
                <% }) %>
                <% if (upcoming.risks.length === 0) { %><li class="cell-sub"><%= t('sst.nothingIn60') %></li><% } %>
              </ul>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Qualité — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('nav.quality'),
      navItems: [
        { tab: 'non-conformites', label: t('qua.tabNc'), icon: 'ticket', badge: stats.open },
        { tab: 'actions', label: t('common.actions'), icon: 'check', badge: stats.openActions },
        { tab: 'audits', label: t('qua.tabAudits'), icon: 'ballot' }
      ],
      footLinks: [
        { href: '/sante-securite', label: t('nav.healthSafety'), icon: 'shield' },
        { href: '/mon-espace', label: t('nav.mySpace'), icon: 'home' }
      ]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('nav.quality'),
        headerSubtitle: t('qua.headerSub')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const day = (iso) => (iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>
        <% const who = (r) => [r.first_name, r.last_name].filter(Boolean).join(' ') || '—'; %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'ticket', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= stats.open %></span><span class="stat-label"><%= t('qua.openNc') %><%= stats.critical ? ` · ${t('qua.criticalCount', { count: stats.critical })}` : '' %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'check', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= stats.openActions %></span><span class="stat-label"><%= t('qua.ongoingActions') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clock', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= stats.awaitingVerification %></span><span class="stat-label"><%= t('qua.toVerify') %></span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'card', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= stats.cost.toLocaleString(locale) %> €</span><span class="stat-label"><%= t('qua.gapCost') %></span></span>
          </div>
        </section>

        <!-- ---------- Non-conformités ---------- -->
        <section class="tab-panel is-active" id="non-conformites">
          <div class="card">
            <div class="card-head"><h3><%= t('qua.recordGap') %></h3></div>
            <form method="POST" action="/qualite/non-conformites" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="span-2"><span><%= t('common.title') %></span><input type="text" name="title" required maxlength="200" placeholder="<%= t('qua.gapPlaceholder') %>" /></label>
              <label><span><%= t('common.origin') %></span>
                <select name="source"><% sources.forEach((s) => { %><option value="<%= s %>"><%= s %></option><% }) %></select>
              </label>
              <label><span><%= t('qua.severity') %></span>
                <select name="severity"><% severities.forEach((s) => { %><option value="<%= s %>"><%= s %></option><% }) %></select>
              </label>
              <label><span><%= t('qua.detectedOn') %></span><input type="date" name="detected_on" value="<%= today %>" required /></label>
              <label><span><%= t('qua.estimatedCost') %></span><input type="text" name="cost" inputmode="decimal" placeholder="0" /></label>
              <label class="span-2"><span><%= t('qua.subject') %></span><input type="text" name="subject" maxlength="200" placeholder="<%= t('qua.subjectPlaceholder') %>" /></label>
              <label class="span-2"><span><%= t('common.description') %></span><textarea name="description" rows="3"></textarea></label>
              <label class="span-2"><span><%= t('qua.immediateAction') %></span><textarea name="immediate_action" rows="2" placeholder="<%= t('qua.immediatePlaceholder') %>"></textarea></label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('common.save') %></button></div>
            </form>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('qua.ncCount', { count: ncList.length }) %></h3></div>
            <% if (!ncList.length) { %>
              <p class="empty-state"><%= t('qua.noGap') %></p>
            <% } else { %>
              <ul class="meeting-list">
                <% ncList.forEach((n) => { %>
                  <li class="meeting-item">
                    <div class="meeting-head">
                      <span class="meeting-title"><span class="mono"><%= n.reference %></span> — <%= n.title %></span>
                      <span class="tag <%= n.severity === 'Critique' ? 'tag-danger' : (n.severity === 'Majeure' ? 'tag-warning' : '') %>"><%= n.severity %></span>
                    </div>
                    <p class="cell-sub">
                      <%= day(n.detected_on) %> · <%= n.source %><%= n.subject ? ` · ${n.subject}` : '' %> · <%= t('qua.detectedBy') %> <%= who(n) %>
                      · <span class="tag <%= n.status === 'Clôturée' ? 'tag-success' : 'tag-warning' %>"><%= st(n.status) %></span>
                      <% if (n.open_actions) { %> · <%= t('qua.openActionCount', { count: n.open_actions }) %><% } %>
                      <% if (n.cost) { %> · <%= n.cost.toLocaleString(locale) %> €<% } %>
                    </p>
                    <% if (n.description) { %><p class="cell-sub"><%= n.description %></p><% } %>
                    <% if (n.immediate_action) { %><details class="minutes"><summary><%= t('qua.immediateAction') %></summary><p><%= n.immediate_action %></p></details><% } %>

                    <form method="POST" action="/qualite/non-conformites/<%= n.id %>/cause" class="form-grid">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <label class="span-2"><span><%= t('qua.rootCause') %></span><textarea name="root_cause" rows="2" placeholder="<%= t('qua.rootCausePlaceholder') %>"><%= n.root_cause %></textarea></label>
                      <div class="span-2"><button type="submit" class="btn btn-outline btn-block"><%= t('qua.recordCause') %></button></div>
                    </form>

                    <div class="row-actions">
                      <form method="POST" action="/qualite/non-conformites/<%= n.id %>/statut" class="inline-field">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <select name="status" class="input-sm">
                          <% ncStatuses.forEach((s) => { %><option value="<%= s %>" <%= s === n.status ? 'selected' : '' %>><%= s %></option><% }) %>
                        </select>
                        <button type="submit" class="btn btn-outline btn-sm"><%= t('gov.changeState') %></button>
                      </form>
                      <form method="POST" action="/qualite/non-conformites/<%= n.id %>/supprimer" class="inline-form" data-confirm="<%= t('qua.confirmDeleteNc') %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-link btn-sm"><%= t('common.delete') %></button>
                      </form>
                    </div>
                  </li>
                <% }) %>
              </ul>
              <p class="hint"><%= t('qua.closeRule') %></p>
            <% } %>
          </div>
        </section>

        <!-- ---------- Actions ---------- -->
        <section class="tab-panel" id="actions">
          <div class="card">
            <div class="card-head"><h3><%= t('qua.openAction') %></h3></div>
            <form method="POST" action="/qualite/actions" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="span-2"><span><%= t('common.action') %></span><input type="text" name="label" required maxlength="300" placeholder="<%= t('qua.actionPlaceholder') %>" /></label>
              <label><span><%= t('common.type') %></span>
                <select name="kind"><% actionKinds.forEach((k) => { %><option value="<%= k %>"><%= k %></option><% }) %></select>
              </label>
              <label><span><%= t('common.owner') %></span>
                <select name="owner_id">
                  <option value="">—</option>
                  <% employees.forEach((e) => { %><option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %></option><% }) %>
                </select>
              </label>
              <label><span><%= t('gov.forDate') %></span><input type="date" name="due_date" /></label>
              <label><span><%= t('qua.nonconformity') %></span>
                <select name="nonconformity_id">
                  <option value="">—</option>
                  <% ncList.forEach((n) => { %><option value="<%= n.id %>"><%= n.reference %> — <%= n.title %></option><% }) %>
                </select>
              </label>
              <label class="span-2"><span><%= t('qua.audit') %></span>
                <select name="audit_id">
                  <option value="">—</option>
                  <% auditList.forEach((a) => { %><option value="<%= a.id %>"><%= a.reference %> — <%= a.scope %></option><% }) %>
                </select>
              </label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('qua.openTheAction') %></button></div>
            </form>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= t('qua.actionCount', { count: actionList.length }) %></h3></div>
            <% if (!actionList.length) { %>
              <p class="empty-state"><%= t('qua.noAction') %></p>
            <% } else { %>
              <div class="table-wrap">
                <table>
                  <thead><tr><th><%= t('erp.dueDate') %></th><th><%= t('common.action') %></th><th><%= t('common.type') %></th><th><%= t('common.owner') %></th><th><%= t('common.origin') %></th><th><%= t('common.state') %></th><th><%= t('qua.effectiveness') %></th></tr></thead>
                  <tbody>
                    <% actionList.forEach((a) => { %>
                      <tr>
                        <td class="cell-sub nowrap"><% if (a.due_date && a.due_date < today && a.status !== 'Faite') { %><span class="tag tag-danger"><%= day(a.due_date) %></span><% } else { %><%= day(a.due_date) %><% } %></td>
                        <td class="cell-strong"><%= a.label %></td>
                        <td class="cell-sub"><%= a.kind %></td>
                        <td class="cell-sub"><%= who(a) %></td>
                        <td class="cell-sub mono"><%= a.nc_reference || a.audit_reference || '—' %></td>
                        <td>
                          <form method="POST" action="/qualite/actions/<%= a.id %>/statut" class="inline-field">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <select name="status" class="input-sm">
                              <% actionStatuses.forEach((s) => { %><option value="<%= s %>" <%= s === a.status ? 'selected' : '' %>><%= s %></option><% }) %>
                            </select>
                            <button type="submit" class="btn btn-outline btn-sm"><%= t('common.update') %></button>
                          </form>
                        </td>
                        <td>
                          <% if (a.effectiveness !== 'Non vérifiée') { %>
                            <span class="tag <%= a.effectiveness === 'Efficace' ? 'tag-success' : 'tag-danger' %>"><%= a.effectiveness === 'Efficace' ? t('qua.effective') : t('qua.ineffective') %></span>
                            <span class="cell-sub"><%= day(a.verified_on) %></span>
                          <% } else if (a.status === 'Faite') { %>
                            <form method="POST" action="/qualite/actions/<%= a.id %>/efficacite" class="inline-field">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <select name="effectiveness" class="input-sm">
                                <option value="Efficace"><%= t('qua.effective') %></option>
                                <option value="Inefficace"><%= t('qua.ineffective') %></option>
                              </select>
                              <button type="submit" class="btn btn-outline btn-sm"><%= t('common.verify') %></button>
                            </form>
                          <% } else { %>
                            <span class="cell-sub">—</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <p class="hint"><%= t('qua.effectivenessRule') %></p>
            <% } %>
          </div>
        </section>

        <!-- ---------- Audits ---------- -->
        <section class="tab-panel" id="audits">
          <div class="card">
            <div class="card-head"><h3><%= t('qua.planAudit') %></h3></div>
            <form method="POST" action="/qualite/audits" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="span-2"><span><%= t('qua.scope') %></span><input type="text" name="scope" required maxlength="200" placeholder="<%= t('qua.scopePlaceholder') %>" /></label>
              <label><span><%= t('qua.standard') %></span><input type="text" name="standard" maxlength="120" placeholder="ISO 9001:2015" /></label>
              <label><span><%= t('qua.plannedOn') %></span><input type="date" name="planned_on" /></label>
              <label class="span-2"><span><%= t('qua.auditor') %></span>
                <select name="auditor_id">
                  <option value="">—</option>
                  <% employees.forEach((e) => { %><option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %></option><% }) %>
                </select>
              </label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('qua.plan') %></button></div>
            </form>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= auditList.length %> audit(s)</h3></div>
            <% if (!auditList.length) { %>
              <p class="empty-state"><%= t('qua.noAudit') %></p>
            <% } else { %>
              <ul class="meeting-list">
                <% auditList.forEach((a) => { %>
                  <li class="meeting-item">
                    <div class="meeting-head">
                      <span class="meeting-title"><span class="mono"><%= a.reference %></span> — <%= a.scope %></span>
                      <span class="tag <%= a.status === 'Planifié' ? 'tag-warning' : 'tag-success' %>"><%= st(a.status) %></span>
                    </div>
                    <p class="cell-sub">
                      <%= a.standard || t('qua.noStandard') %> · <%= t('qua.plannedFor') %> <%= day(a.planned_on) %><%= a.done_on ? ` · ${t('qua.doneOnLower')} ${day(a.done_on)}` : '' %>
                      · <%= who(a) %> · <%= t('qua.findingCount', { count: a.finding_count }) %><%= a.nc_count ? `, ${t('qua.ofWhichNc', { count: a.nc_count })}` : '' %>
                    </p>
                    <% if (a.summary) { %><details class="minutes"><summary><%= t('qua.summary') %></summary><p><%= a.summary %></p></details><% } %>

                    <% const list = findingsByAudit[a.id] || []; %>
                    <% if (list.length) { %>
                      <div class="table-wrap">
                        <table>
                          <thead><tr><th><%= t('common.type') %></th><th><%= t('qua.requirement') %></th><th><%= t('qua.finding') %></th><th></th></tr></thead>
                          <tbody>
                            <% list.forEach((f) => { %>
                              <tr>
                                <td><span class="tag <%= f.kind === 'Non-conformité' ? 'tag-danger' : (f.kind === 'Point fort' ? 'tag-success' : '') %>"><%= f.kind %></span></td>
                                <td class="cell-sub mono"><%= f.clause || '—' %></td>
                                <td class="cell-sub"><%= f.statement %></td>
                                <td>
                                  <div class="row-actions">
                                    <% if (f.kind === 'Non-conformité') { %>
                                      <form method="POST" action="/qualite/constats/<%= f.id %>/en-non-conformite" class="inline-form">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                        <button type="submit" class="btn btn-outline btn-sm"><%= t('qua.openNcFromFinding') %></button>
                                      </form>
                                    <% } %>
                                    <form method="POST" action="/qualite/constats/<%= f.id %>/supprimer" class="inline-form">
                                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                      <button type="submit" class="btn btn-link btn-sm"><%= t('common.remove') %></button>
                                    </form>
                                  </div>
                                </td>
                              </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>
                    <% } %>

                    <form method="POST" action="/qualite/audits/<%= a.id %>/constats" class="form-grid">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <label><span><%= t('qua.findingType') %></span>
                        <select name="kind"><% findingKinds.forEach((k) => { %><option value="<%= k %>"><%= k %></option><% }) %></select>
                      </label>
                      <label><span><%= t('qua.requirement') %></span><input type="text" name="clause" maxlength="60" placeholder="8.4.1" /></label>
                      <label class="span-2"><span><%= t('qua.finding') %></span><textarea name="statement" rows="2" required></textarea></label>
                      <div class="span-2"><button type="submit" class="btn btn-outline btn-block"><%= t('qua.addFinding') %></button></div>
                    </form>

                    <% if (a.status === 'Planifié') { %>
                      <form method="POST" action="/qualite/audits/<%= a.id %>/realiser" class="form-grid">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <label><span><%= t('qua.doneOn') %></span><input type="date" name="done_on" value="<%= today %>" required /></label>
                        <label class="span-2"><span><%= t('qua.summary') %></span><textarea name="summary" rows="3"></textarea></label>
                        <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('qua.closeAudit') %></button></div>
                      </form>
                    <% } %>

                    <div class="row-actions">
                      <form method="POST" action="/qualite/audits/<%= a.id %>/supprimer" class="inline-form" data-confirm="<%= t('qua.confirmDeleteAudit') %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-link btn-sm"><%= t('common.delete') %></button>
                      </form>
                    </div>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

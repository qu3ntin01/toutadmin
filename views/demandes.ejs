<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Demandes — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: t('nav.requests'),
      navItems: [
        { tab: 'nouvelle', label: t('leave.newRequest'), icon: 'plus' },
        { tab: 'mes-demandes', label: t('leave.myRequests'), icon: 'inbox', badge: mine.filter((r) => r.status === 'En cours').length },
        { tab: 'a-valider', label: t('stk.toApprove'), icon: 'check', badge: toDecide.length }
      ].concat(admin ? [{ tab: 'types', label: t('dmd.tabFlows'), icon: 'settings', badge: stats.forms }] : []),
      footLinks: [{ href: '/mon-espace', label: t('nav.mySpace'), icon: 'home' }]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('nav.internalRequests'),
        headerSubtitle: t('dmd.headerSub')
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const day = (iso) => (iso ? new Date(iso.slice(0, 10) + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>
        <% const stateTag = (s) => (s === 'Approuvée' ? 'tag-success' : (s === 'En cours' ? 'tag-warning' : 'tag-danger')); %>

        <% const requestList = (rows, empty) => { %>
          <% if (!rows.length) { %>
            <p class="empty-state"><%= empty %></p>
          <% } else { %>
            <ul class="meeting-list">
              <% rows.forEach((r) => { %>
                <li class="meeting-item">
                  <div class="meeting-head">
                    <span class="meeting-title"><a href="/demandes/<%= r.id %>"><%= r.form ? r.form.label : 'Demande' %></a></span>
                    <span class="tag <%= stateTag(r.status) %>"><%= st(r.status) %></span>
                  </div>
                  <p class="cell-sub">
                    <%= r.requesterName %> · <%= t('dmd.submittedOn', { date: day(r.created_at) }) %>
                    <% if (r.summary) { %> · <%= r.summary %><% } %>
                  </p>
                  <% if (r.status === 'En cours' && r.step) { %>
                    <p class="cell-sub">
                      <%= t('common.step') %> <%= r.stepIndex + 1 %>/<%= r.steps.length %> —
                      <%= r.step.label || r.step.approver %> ·
                      <%= r.pendingApprovers.map((a) => `${a.first_name} ${a.last_name}`).join(', ') %>
                    </p>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } %>
        <% }; %>

        <section class="tab-panel is-active" id="nouvelle">
          <% if (!openForms.length) { %>
            <div class="card"><p class="empty-state"><%= t('dmd.noOpenType') %></p></div>
          <% } %>
          <% openForms.forEach((form) => { %>
            <div class="card">
              <div class="card-head"><h3><%= form.label %></h3><span class="card-sub"><%= t('dmd.stepCount', { count: form.steps.length }) %></span></div>
              <% if (form.description) { %><p class="cell-sub"><%= form.description %></p><% } %>
              <form method="POST" action="/demandes" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="form_id" value="<%= form.id %>" />
                <% form.fieldList.forEach((field) => { %>
                  <label class="<%= field.type === 'zone' ? 'span-2' : '' %>">
                    <span><%= field.label %><%= field.required ? ' *' : '' %></span>
                    <% if (field.type === 'zone') { %>
                      <textarea name="champ_<%= field.name %>" rows="3" <%= field.required ? 'required' : '' %>></textarea>
                    <% } else if (field.type === 'choix') { %>
                      <select name="champ_<%= field.name %>" <%= field.required ? 'required' : '' %>>
                        <option value="">—</option>
                        <% field.options.forEach((o) => { %><option value="<%= o %>"><%= o %></option><% }) %>
                      </select>
                    <% } else if (field.type === 'date') { %>
                      <input type="date" name="champ_<%= field.name %>" <%= field.required ? 'required' : '' %> />
                    <% } else if (field.type === 'nombre' || field.type === 'montant') { %>
                      <input type="text" inputmode="decimal" name="champ_<%= field.name %>" <%= field.required ? 'required' : '' %> placeholder="0" />
                    <% } else { %>
                      <input type="text" name="champ_<%= field.name %>" maxlength="2000" <%= field.required ? 'required' : '' %> />
                    <% } %>
                  </label>
                <% }) %>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('dmd.submit') %></button></div>
              </form>
              <% if (form.steps.length) { %>
                <p class="hint">
                  <%= t('dmd.flowLabel') %>
                  <% form.steps.forEach((s, index) => { %><%= index ? ' → ' : '' %><%= s.label || s.approver %><% if (s.threshold) { %> (<%= t('dmd.aboveThreshold', { threshold: s.threshold }) %>)<% } %><% }) %>
                </p>
              <% } %>
            </div>
          <% }) %>
        </section>

        <section class="tab-panel" id="mes-demandes">
          <div class="card">
            <div class="card-head"><h3><%= t('leave.myRequests') %></h3></div>
            <% requestList(mine, "Vous n'avez déposé aucune demande.") %>
          </div>
        </section>

        <section class="tab-panel" id="a-valider">
          <div class="card">
            <div class="card-head"><h3><%= t('dmd.awaitingYou') %></h3></div>
            <% requestList(toDecide, 'Rien à valider.') %>
          </div>
        </section>

        <% if (admin) { %>
          <section class="tab-panel" id="types">
            <div class="card">
              <div class="card-head"><h3><%= t('dmd.createType') %></h3></div>
              <form method="POST" action="/demandes/types" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label><span><%= t('common.title') %></span><input type="text" name="label" required maxlength="120" placeholder="<%= t('dmd.typePlaceholder') %>" /></label>
                <label><span><%= t('dmd.amountField') %></span><input type="text" name="amount_field" maxlength="60" placeholder="montant" /></label>
                <label class="span-2"><span><%= t('common.description') %></span><textarea name="description" rows="2" placeholder="<%= t('dmd.descriptionPlaceholder') %>"></textarea></label>

                <div class="span-2">
                  <p class="section-label"><%= t('dmd.fieldsToFill', { max: maxFields }) %></p>
                  <% [1, 2, 3, 4, 5].forEach((rank) => { %>
                    <div class="signer-row">
                      <span class="signer-rank"><%= rank %></span>
                      <input type="text" name="field_names" maxlength="60" placeholder="nom_technique" />
                      <input type="text" name="field_labels" maxlength="120" placeholder="<%= t('dmd.displayedLabel') %>" />
                      <select name="field_types">
                        <% fieldTypes.forEach((ft) => { %><option value="<%= ft.key %>"><%= ft.label %></option><% }) %>
                      </select>
                      <select name="field_required"><option value="0"><%= t('dmd.optional') %></option><option value="1"><%= t('common.mandatory') %></option></select>
                      <input type="text" name="field_options" maxlength="300" placeholder="<%= t('dmd.choicesPlaceholder') %>" />
                    </div>
                  <% }) %>
                </div>
                <div class="span-2"><button type="submit" class="btn btn-primary btn-block"><%= t('dmd.createTheType') %></button></div>
              </form>
              <p class="hint">
                <%= t('dmd.thresholdNote') %>
              </p>
            </div>

            <% allForms.forEach((form) => { %>
              <div class="card">
                <div class="card-head">
                  <h3><%= form.label %></h3>
                  <span class="tag <%= form.active ? 'tag-success' : 'tag-danger' %>"><%= form.active ? 'Ouvert' : 'Fermé' %></span>
                </div>
                <p class="cell-sub">
                  <%= form.fieldList.map((f) => f.label).join(' · ') %>
                  <%= form.amount_field ? ` · montant : ${form.amount_field}` : '' %>
                </p>

                <div class="table-wrap">
                  <table>
                    <thead><tr><th><%= t('common.step') %></th><th><%= t('dmd.approver') %></th><th><%= t('common.threshold') %></th><th></th></tr></thead>
                    <tbody>
                      <% form.steps.forEach((s) => { %>
                        <tr>
                          <td class="cell-sub"><%= s.position %></td>
                          <td class="cell-strong">
                            <%= s.label || (approvers.find((a) => a.key === s.approver) || {}).label || s.approver %>
                            <% if (s.approver === 'user' && s.first_name) { %><br /><span class="cell-sub"><%= s.first_name %> <%= s.last_name %></span><% } %>
                          </td>
                          <td class="num"><%= s.threshold ? s.threshold : '—' %></td>
                          <td>
                            <form method="POST" action="/demandes/types/<%= form.id %>/etapes/<%= s.id %>/supprimer" class="inline-form">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-link btn-sm"><%= t('common.remove') %></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                      <% if (!form.steps.length) { %>
                        <tr><td colspan="4" class="cell-sub"><%= t('dmd.noStep') %></td></tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>

                <form method="POST" action="/demandes/types/<%= form.id %>/etapes" class="form-grid">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label><span><%= t('dmd.approver') %></span>
                    <select name="approver"><% approvers.forEach((a) => { %><option value="<%= a.key %>"><%= a.label %></option><% }) %></select>
                  </label>
                  <label><span><%= t('dmd.designatedPerson') %></span>
                    <select name="approver_id">
                      <option value="">—</option>
                      <% employees.forEach((e) => { %><option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %></option><% }) %>
                    </select>
                  </label>
                  <label><span><%= t('dmd.stepLabel') %></span><input type="text" name="label" maxlength="80" placeholder="<%= t('dmd.stepPlaceholder') %>" /></label>
                  <label><span><%= t('dmd.triggerThreshold') %></span><input type="number" name="threshold" min="0" step="1" value="0" /></label>
                  <div class="span-2"><button type="submit" class="btn btn-outline btn-block"><%= t('dmd.addStep') %></button></div>
                </form>

                <div class="row-actions">
                  <form method="POST" action="/demandes/types/<%= form.id %>/etat" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="active" value="<%= form.active ? '0' : '1' %>" />
                    <button type="submit" class="btn btn-outline btn-sm"><%= form.active ? 'Fermer aux demandes' : 'Ouvrir aux demandes' %></button>
                  </form>
                  <form method="POST" action="/demandes/types/<%= form.id %>/supprimer" class="inline-form" data-confirm="<%= t('dmd.confirmDeleteType') %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn-link btn-sm"><%= t('common.delete') %></button>
                  </form>
                </div>
              </div>
            <% }) %>
          </section>
        <% } %>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

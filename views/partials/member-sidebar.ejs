<%
/* Barre latérale de l'espace collaborateur.
   Attend : active ('espace'|'annuaire'|'messagerie'|'equipe'|'profil') */
const memberLinks = [
  { key: 'espace', href: '/mon-espace', label: t('nav.mySpace'), icon: 'home' },
  { key: 'annuaire', href: '/annuaire', label: t('nav.directory'), icon: 'users' },
  { key: 'messagerie', href: '/messagerie', label: t('nav.messages'), icon: 'inbox', badge: unreadMessages },
];
if (isManager) memberLinks.push({ key: 'equipe', href: '/mon-equipe', label: t('nav.team'), icon: 'shield' });
memberLinks.push({ key: 'profil', href: '/mon-profil', label: t('nav.profile'), icon: 'user' });

// Les espaces d'encadrement restent au pied de la barre, séparés du parcours du membre.
const memberFootLinks = [];
if (currentUser.isHr || currentUser.role === 'admin') {
  memberFootLinks.push({ href: '/rh', label: t('nav.hrSpace'), icon: 'briefcase' });
}
if (currentUser.role === 'admin') {
  memberFootLinks.push({ href: '/admin', label: t('nav.adminConsole'), icon: 'settings' });
}
%>
<%- include('sidebar', {
  panelLabel: t('app.portal'),
  navItems: memberLinks.map((link) => ({ ...link, active: link.key === active })),
  footLinks: memberFootLinks
}) %>

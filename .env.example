PORT=3000

# Laissez ces trois lignes commentées pour installer via l'assistant (/installation).
# Le secret de session est alors généré automatiquement dans data/session.key.
# SESSION_SECRET=un-secret-long-et-aleatoire

# Recommandé sur un serveur exposé : l'assistant réclame ce jeton avant d'installer.
# INSTALL_TOKEN=un-jeton-long-et-aleatoire

# Installation sans interface (déploiement automatisé) : crée l'administrateur au démarrage.
# ADMIN_EMAIL=admin@entreprise.com
# ADMIN_PASSWORD=un-mot-de-passe-fort

# NODE_ENV=production
# TRUST_PROXY=1

# La base : SQLite dans un fichier (défaut), ou MySQL / MariaDB.
# Laissé vide, DB_DRIVER vaut « sqlite » et la base vit dans DB_PATH.
# DB_PATH=data/app.sqlite

# Sur MySQL, les lignes suivantes remplacent DB_PATH pour les tables.
# DB_PATH garde son rôle de dossier de travail : c'est son dossier parent qui
# reçoit instance.json et les fichiers déposés. Un DB_HOST commençant par « / »
# est compris comme une socket Unix, et DB_PORT est alors ignoré.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=toutadmin
# DB_USER=toutadmin
# DB_PASSWORD=

# Changer DB_DRIVER sur une instance qui tourne ne migre rien : elle pointera
# sur une base vide et vous accueillera avec l'assistant. La sauvegarde du
# produit ne traverse pas les moteurs — c'est voulu, et dit à l'écran.

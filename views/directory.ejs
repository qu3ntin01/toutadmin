<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>">
<head>
  <%- include('partials/head', { title: t('directory.title') + ' — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/member-sidebar', { active: 'annuaire' }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('directory.title'),
        headerSubtitle: t('directory.subtitle')
      }) %>

      <main class="page">

        <% if (flash) { %>
          <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
        <% } %>

        <% if (viewerHidden) { %>
          <div class="banner is-warning">
            <%- include('partials/icon', { name: 'user', iconSize: 17 }) %>
            <span><%= t('directory.hidden') %></span>
          </div>
        <% } %>

        <div class="card">
          <div class="card-head">
            <h3><%= t('directory.count', { count: people.length }) %></h3>
            <form method="GET" action="/annuaire" class="search-bar">
              <input type="search" name="q" value="<%= query %>" placeholder="<%= t('directory.search') %>" />
              <button type="submit" class="btn"><%= t('common.search') %></button>
            </form>
          </div>

          <% if (people.length === 0) { %>
            <div class="empty-state"><%= t('directory.empty') %></div>
          <% } else { %>
            <div class="people-grid">
              <% people.forEach((person) => { %>
                <article class="person-card">
                  <%- include('partials/avatar', { person }) %>
                  <div class="person-body">
                    <div class="person-name"><%= person.first_name %> <%= person.last_name %></div>
                    <div class="person-role"><%= person.grade %><%= person.department ? ' · ' + person.department : '' %></div>
                    <div class="person-line"><%= person.mail_address || person.email %></div>
                    <% if (person.phone) { %><div class="person-line"><%= person.phone %></div><% } %>
                    <% if (person.manager_first_name) { %>
                      <div class="person-line"><%= t('common.manager') %> : <%= person.manager_first_name %> <%= person.manager_last_name %></div>
                    <% } %>
                    <% if (person.bio) { %><p class="person-bio"><%= person.bio %></p><% } %>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </div>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
</body>
</html>

<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>">
<head>
  <%- include('partials/head', { title: 'Immobilisations — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: 'Immobilisations',
      navItems: [
        { tab: 'registre', label: 'Registre', icon: 'briefcase' },
        { tab: 'tableaux', label: "Tableaux d'amortissement", icon: 'card' }
      ],
      footLinks: [{ href: '/gestion', label: t('nav.gestion'), icon: 'back' }]
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: 'Immobilisations',
        headerSubtitle: "Registre, amortissements et valeur nette comptable"
      }) %>

      <main class="page">
        <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
        <% const money = (n) => (n == null ? '—' : Number(n).toLocaleString(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'); %>
        <% const day = (iso) => (iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString(locale, { timeZone: 'UTC' }) : '—'); %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'briefcase', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= summary.count %></span><span class="stat-label">Immobilisations en service</span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'card', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(summary.gross) %></span><span class="stat-label">Valeur brute</span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'check', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(summary.net) %></span><span class="stat-label">Valeur nette comptable</span></span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clock', iconSize: 18 }) %></span>
            <span class="stat-body"><span class="stat-value"><%= money(summary.charge) %></span><span class="stat-label">Dotation <%= currentYear %></span></span>
          </div>
        </section>

        <section class="tab-panel is-active" id="registre">
          <div class="card">
            <div class="card-head"><h3>Enregistrer une immobilisation</h3></div>
            <form method="POST" action="/immobilisations" class="form-grid">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="span-2"><span>Intitulé</span><input type="text" name="label" required maxlength="160" placeholder="Serveur de production" /></label>
              <label><span>Catégorie</span><input type="text" name="category" value="Matériel" maxlength="60" /></label>
              <label><span>Acquise le</span><input type="date" name="acquired_on" value="<%= today %>" required /></label>
              <label><span>Montant HT (€)</span><input type="text" name="amount" inputmode="decimal" required /></label>
              <label><span>Durée (années)</span><input type="number" name="duration_years" min="1" max="50" value="3" required /></label>
              <label class="span-2"><span>Mode</span>
                <select name="method"><% methods.forEach((m) => { %><option value="<%= m %>"><%= m %></option><% }) %></select>
              </label>
              <label class="span-2"><span>Note</span><input type="text" name="note" maxlength="500" /></label>
              <div class="span-2"><button type="submit" class="btn btn-primary btn-block">Enregistrer</button></div>
            </form>
            <p class="hint">
              En dégressif, la dotation s'applique à la valeur résiduelle jusqu'à ce que le linéaire sur les
              années restantes devienne plus favorable : la bascule est calculée, pas saisie.
            </p>
          </div>

          <div class="card">
            <div class="card-head"><h3><%= assetList.length %> immobilisation(s)</h3></div>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Intitulé</th><th>Acquise</th><th>Brut</th><th>Mode</th><th>Cumul</th><th>Dotation <%= currentYear %></th><th>VNC</th><th></th></tr></thead>
                <tbody>
                  <% assetList.forEach((a) => { %>
                    <tr class="<%= a.disposed_on ? 'is-muted' : '' %>">
                      <td>
                        <span class="cell-strong"><%= a.label %></span>
                        <% if (a.disposed_on) { %><span class="tag">cédée le <%= day(a.disposed_on) %></span><% } %>
                        <br /><span class="cell-sub"><%= a.category %><%= a.note ? ' · ' + a.note : '' %></span>
                      </td>
                      <td class="cell-sub nowrap"><%= day(a.acquired_on) %></td>
                      <td><%= money(a.amount) %></td>
                      <td class="cell-sub"><%= a.method %> · <%= a.duration_years %> ans</td>
                      <td class="cell-sub"><%= money(a.cumulated) %></td>
                      <td><%= money(a.currentCharge) %></td>
                      <td class="cell-strong"><%= money(a.bookValue) %></td>
                      <td>
                        <% if (!a.disposed_on) { %>
                          <form method="POST" action="/immobilisations/<%= a.id %>/ceder" class="inline-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <input type="date" name="disposed_on" value="<%= today %>" class="input-sm" required />
                            <button type="submit" class="btn btn-outline btn-sm">Céder</button>
                          </form>
                        <% } %>
                        <form method="POST" action="/immobilisations/<%= a.id %>/supprimer" class="inline-form" data-confirm="Supprimer cette immobilisation ?">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (assetList.length === 0) { %><tr><td colspan="8" class="cell-sub">Aucune immobilisation.</td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="tab-panel" id="tableaux">
          <% assetList.forEach((a) => { %>
            <div class="card">
              <div class="card-head"><h3><%= a.label %> — <%= a.method %> sur <%= a.duration_years %> ans</h3></div>
              <div class="table-wrap">
                <table>
                  <thead><tr><th>Exercice</th><th>Dotation</th><th>Valeur résiduelle</th></tr></thead>
                  <tbody>
                    <% a.schedule.forEach((row) => { %>
                      <tr class="<%= row.year === currentYear ? 'is-current' : '' %>">
                        <td class="cell-strong"><%= row.year %></td>
                        <td><%= money(row.charge) %></td>
                        <td class="cell-sub"><%= money(row.residual) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          <% }) %>
          <% if (assetList.length === 0) { %>
            <div class="card"><p class="cell-sub">Enregistrez une immobilisation pour voir son tableau.</p></div>
          <% } %>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>

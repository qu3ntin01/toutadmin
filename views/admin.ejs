<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>">
<head>
  <%- include('partials/head', { title: 'Administration — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/sidebar', {
      panelLabel: 'Administration',
      navItems: [
        { tab: 'personnel', label: t('nav.personnel'), icon: 'users' },
        { tab: 'organisation', label: 'Organisation', icon: 'network' },
        { tab: 'outils', label: t('nav.tools'), icon: 'tool' },
        { tab: 'affectations', label: t('nav.assignments'), icon: 'link' },
        { tab: 'actualites', label: t('nav.news'), icon: 'megaphone' },
        { tab: 'rh', label: t('nav.hr'), icon: 'shield', badge: pendingRequestCount }
      ],
      sidebarLink: { href: '/rh', label: t('nav.openHrSpace'), icon: 'external' }
    }) %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('admin.title'),
        headerSubtitle: t('admin.subtitle')
      }) %>

      <main class="page">
        <% if (flash) { %>
          <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
        <% } %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'users', iconSize: 17 }) %></span>
            <span class="stat-body">
              <span class="stat-value"><%= stats.employeeCount %></span>
              <span class="stat-label">Membres du personnel</span>
            </span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'tool', iconSize: 17 }) %></span>
            <span class="stat-body">
              <span class="stat-value"><%= stats.toolCount %></span>
              <span class="stat-label">Outils au catalogue</span>
            </span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'link', iconSize: 17 }) %></span>
            <span class="stat-body">
              <span class="stat-value"><%= stats.assignedCount %></span>
              <span class="stat-label">Affectations actives</span>
            </span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'plus', iconSize: 17 }) %></span>
            <span class="stat-body">
              <span class="stat-value"><%= stats.availableCount %></span>
              <span class="stat-label">Outils non affectés</span>
            </span>
          </div>
        </section>

        <!-- PERSONNEL -->
        <section class="tab-panel is-active" id="personnel">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3>Ajouter un membre</h3></div>
              <form method="POST" action="/admin/employes" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label>
                  <span>Prénom</span>
                  <input type="text" name="first_name" required />
                </label>
                <label>
                  <span>Nom</span>
                  <input type="text" name="last_name" required />
                </label>
                <label class="span-2">
                  <span>Email (identifiant de connexion)</span>
                  <input type="email" name="email" required />
                </label>
                <label>
                  <span>Grade</span>
                  <select name="grade" required>
                    <option value="" disabled selected>Choisir…</option>
                    <% grades.forEach((g) => { %><option value="<%= g %>"><%= g %></option><% }) %>
                  </select>
                </label>
                <label>
                  <span>Service</span>
                  <input type="text" name="department" placeholder="Ex : Maintenance" />
                </label>
                <label>
                  <span>Type de contrat</span>
                  <select name="contract_type" required>
                    <option value="" disabled selected>Choisir…</option>
                    <% contractTypes.forEach((c) => { %><option value="<%= c %>"><%= c %></option><% }) %>
                  </select>
                </label>
                <label>
                  <span>Fin de contrat</span>
                  <input type="date" name="contract_end_date" />
                </label>
                <label class="span-2">
                  <span>TJM en € (freelance uniquement)</span>
                  <input type="number" name="daily_rate" min="0" step="0.01" placeholder="Ex : 450" />
                </label>
                <div class="span-2">
                  <button type="submit" class="btn btn-primary btn-block">Créer le compte</button>
                </div>
              </form>
              <p class="hint">
                Un mot de passe temporaire est généré et affiché une seule fois. Si une date de fin
                est renseignée, le compte se désactive automatiquement à l'échéance. Un membre
                non-freelance démarre avec <%= annualLeaveDays %> jours de congés.
              </p>
            </div>

            <div class="card">
              <div class="card-head"><h3>Équipe <span class="muted">(<%= employees.length %>)</span></h3></div>
              <% if (employees.length === 0) { %>
                <div class="empty-state">Aucun membre enregistré pour le moment.</div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Membre</th><th>Grade</th><th>Contrat</th><th>Outils</th><th>Statut</th><th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% const todayStr = new Date().toISOString().slice(0, 10); %>
                      <% employees.forEach((e) => {
                        let daysLeft = null;
                        if (e.contract_end_date) {
                          daysLeft = Math.ceil((new Date(e.contract_end_date + 'T00:00:00Z') - new Date(todayStr + 'T00:00:00Z')) / 86400000);
                        }
                        const isExpired = daysLeft !== null && daysLeft < 0;
                        const isSoon = daysLeft !== null && daysLeft >= 0 && daysLeft <= 30;
                        const dateClass = isExpired ? 'text-danger' : (isSoon ? 'text-warning' : 'cell-sub');
                      %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                            <div class="cell-sub"><%= e.email %></div>
                          </td>
                          <td><span class="tag tag-accent"><%= e.grade %></span></td>
                          <td>
                            <div class="cell-strong small"><%= e.contract_type || '—' %></div>
                            <% if (e.contract_end_date) { %>
                              <div class="small <%= dateClass %>">
                                <%= isExpired ? 'Expiré le' : "Jusqu'au" %>
                                <%= new Date(e.contract_end_date + 'T00:00:00Z').toLocaleDateString('fr-FR') %><% if (!isExpired) { %> · <%= daysLeft %> j<% } %>
                              </div>
                            <% } else { %>
                              <div class="cell-sub">Durée indéterminée</div>
                            <% } %>
                          </td>
                          <td class="num"><%= (toolsByEmployee[e.id] || []).length %></td>
                          <td>
                            <% if (isExpired) { %>
                              <span class="status status-warning">Expiré</span>
                            <% } else { %>
                              <span class="status <%= e.active ? 'status-on' : 'status-off' %>"><%= e.active ? 'Actif' : 'Désactivé' %></span>
                            <% } %>
                            <% if (e.is_hr) { %><div><span class="tag tag-accent">RH</span></div><% } %>
                          </td>
                          <td class="actions">
                            <a href="/admin/employes/<%= e.id %>/modifier" class="btn btn-sm">Modifier</a>
                            <form method="POST" action="/admin/employes/<%= e.id %>/statut">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm"><%= e.active ? 'Désactiver' : 'Activer' %></button>
                            </form>
                            <form method="POST" action="/admin/employes/<%= e.id %>/reinitialiser">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm">Réinit. mdp</button>
                            </form>
                            <form method="POST" action="/admin/employes/<%= e.id %>/supprimer" data-confirm="Supprimer définitivement ce membre ?">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- OUTILS -->
        <section class="tab-panel" id="outils">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3>Ajouter un outil</h3></div>
              <form method="POST" action="/admin/outils" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span>Nom de l'outil</span>
                  <input type="text" name="name" required />
                </label>
                <label>
                  <span>Catégorie</span>
                  <input type="text" name="category" placeholder="Ex : Informatique" />
                </label>
                <label>
                  <span>Référence</span>
                  <input type="text" name="reference" placeholder="Ex : REF-2031" />
                </label>
                <label class="span-2">
                  <span>URL de connexion</span>
                  <input type="url" name="login_url" placeholder="https://outil.entreprise.com" />
                </label>
                <label class="span-2">
                  <span>Description</span>
                  <textarea name="description" rows="3"></textarea>
                </label>
                <div class="span-2">
                  <button type="submit" class="btn btn-primary btn-block">Ajouter au catalogue</button>
                </div>
              </form>
            </div>

            <div class="card">
              <div class="card-head"><h3>Catalogue <span class="muted">(<%= tools.length %>)</span></h3></div>
              <% if (tools.length === 0) { %>
                <div class="empty-state">Aucun outil au catalogue pour le moment.</div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr><th>Outil</th><th>Catégorie</th><th>Référence</th><th>Affecté à</th><th></th></tr>
                    </thead>
                    <tbody>
                      <% tools.forEach((t) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= t.name %></div>
                            <% if (t.login_url) { %><div class="cell-sub">Accès configuré</div><% } %>
                          </td>
                          <td><span class="tag"><%= t.category || '—' %></span></td>
                          <td class="cell-sub"><%= t.reference || '—' %></td>
                          <td class="num"><%= (employeesByTool[t.id] || []).length %></td>
                          <td class="actions">
                            <a href="/admin/outils/<%= t.id %>/modifier" class="btn btn-sm">Modifier</a>
                            <form method="POST" action="/admin/outils/<%= t.id %>/supprimer" data-confirm="Supprimer cet outil du catalogue ?">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- AFFECTATIONS -->
        <section class="tab-panel" id="affectations">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3>Affecter un outil</h3></div>
              <form method="POST" action="/admin/affectations" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span>Membre</span>
                  <select name="employee_id" required>
                    <option value="" disabled selected>Choisir…</option>
                    <% employees.forEach((e) => { %>
                      <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %> — <%= e.grade %></option>
                    <% }) %>
                  </select>
                </label>
                <label class="span-2">
                  <span>Outil</span>
                  <select name="tool_id" required>
                    <option value="" disabled selected>Choisir…</option>
                    <% tools.forEach((t) => { %>
                      <option value="<%= t.id %>"><%= t.name %><%= t.reference ? ' — ' + t.reference : '' %></option>
                    <% }) %>
                  </select>
                </label>
                <label>
                  <span>Identifiant</span>
                  <input type="text" name="username" placeholder="Ex : marie.dupont" />
                </label>
                <label>
                  <span>Note</span>
                  <input type="text" name="note" placeholder="Ex : usage chantier" />
                </label>
                <div class="span-2">
                  <button type="submit" class="btn btn-primary btn-block">Affecter</button>
                </div>
              </form>
              <p class="hint">L'identifiant est visible par le membre dans son espace, à côté de l'URL de connexion de l'outil.</p>
            </div>

            <div class="card">
              <% const rows = Object.values(toolsByEmployee).flat(); %>
              <div class="card-head"><h3>Affectations actives <span class="muted">(<%= rows.length %>)</span></h3></div>
              <% if (rows.length === 0) { %>
                <div class="empty-state">Aucune affectation pour le moment.</div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr><th>Membre</th><th>Outil</th><th>Identifiant</th><th>Depuis</th><th></th></tr>
                    </thead>
                    <tbody>
                      <% rows.sort((a, b) => new Date(b.assigned_at) - new Date(a.assigned_at)).forEach((row) => { %>
                        <tr>
                          <td class="cell-strong"><%= employeesMap[row.employee_id].first_name %> <%= employeesMap[row.employee_id].last_name %></td>
                          <td><%= toolsMap[row.tool_id].name %></td>
                          <td class="mono"><%= row.username || '—' %></td>
                          <td class="cell-sub"><%= new Date(row.assigned_at).toLocaleDateString('fr-FR') %></td>
                          <td class="actions">
                            <form method="POST" action="/admin/affectations/<%= row.id %>/supprimer">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger">Retirer</button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- ORGANISATION -->
        <section class="tab-panel" id="organisation">
          <div class="card">
            <div class="card-head">
              <div>
                <h3>Rattachement hiérarchique et annuaire</h3>
                <p class="card-sub">Chaque membre peut être rattaché à un manager, qui obtient alors son espace équipe. La visibilité dans l'annuaire se pilote ici uniquement.</p>
              </div>
            </div>

            <% if (employees.length === 0) { %>
              <div class="empty-state">Aucun membre enregistré pour le moment.</div>
            <% } else { %>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr><th><%= t('common.member') %></th><th><%= t('common.manager') %></th><th>Équipe</th><th><%= t('admin.directoryVisibility') %></th><th></th></tr>
                  </thead>
                  <tbody>
                    <% employees.forEach((e) => { %>
                      <tr>
                        <td>
                          <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                          <div class="cell-sub"><%= e.grade %><%= e.department ? ' · ' + e.department : '' %></div>
                        </td>
                        <td>
                          <form method="POST" action="/admin/employes/<%= e.id %>/manager" class="inline-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <select name="manager_id">
                              <option value="">— <%= t('common.none') %> —</option>
                              <% employees.forEach((m) => { if (m.id !== e.id) { %>
                                <option value="<%= m.id %>" <%= e.manager_id === m.id ? 'selected' : '' %>><%= m.first_name %> <%= m.last_name %></option>
                              <% } }) %>
                            </select>
                            <button type="submit" class="btn btn-sm"><%= t('common.save') %></button>
                          </form>
                        </td>
                        <td class="num"><%= teamSizes[e.id] || 0 %></td>
                        <td>
                          <span class="status <%= e.directory_hidden ? 'status-off' : 'status-on' %>">
                            <%= e.directory_hidden ? t('admin.hidden') : t('admin.visible') %>
                          </span>
                        </td>
                        <td class="actions">
                          <form method="POST" action="/admin/employes/<%= e.id %>/annuaire">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-sm"><%= e.directory_hidden ? "Afficher dans l'annuaire" : "Masquer de l'annuaire" %></button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </section>

        <!-- ACTUALITES -->
        <section class="tab-panel" id="actualites">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3>Publier une actualité</h3></div>
              <form method="POST" action="/admin/actualites" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span><%= t('team.newsTitle') %></span>
                  <input type="text" name="title" required maxlength="150" />
                </label>
                <label class="span-2">
                  <span><%= t('team.newsBody') %></span>
                  <textarea name="body" rows="5" maxlength="2000"></textarea>
                </label>
                <div class="span-2">
                  <button type="submit" class="btn btn-primary btn-block"><%= t('team.publish') %></button>
                </div>
              </form>
              <p class="hint">Une actualité publiée ici est visible par tout le personnel sur sa page d'accueil. Les managers publient de leur côté pour leur seule équipe.</p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('team.publishedNews') %> <span class="muted">(<%= companyNews.length %>)</span></h3></div>
              <% if (companyNews.length === 0) { %>
                <div class="empty-state"><%= t('home.noNews') %></div>
              <% } else { %>
                <% companyNews.forEach((n) => { %>
                  <div class="news-item">
                    <div class="news-head">
                      <span class="news-title"><%= n.title %></span>
                      <span class="tag tag-accent"><%= t('home.companyNews') %></span>
                      <span class="news-meta"><%= new Date(n.created_at).toLocaleDateString(locale) %></span>
                      <form method="POST" action="/admin/actualites/<%= n.id %>/supprimer" data-confirm="<%= t('common.delete') %> ?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-sm btn-danger"><%= t('common.delete') %></button>
                      </form>
                    </div>
                    <% if (n.body) { %><p class="news-body"><%= n.body %></p><% } %>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        </section>

        <!-- RESSOURCES HUMAINES -->
        <section class="tab-panel" id="rh">
          <div class="card">
            <div class="card-head">
              <div>
                <h3>Espace RH</h3>
                <p class="card-sub">Demandes, soldes de congés et fiches de paie de tout le personnel non-freelance.</p>
              </div>
              <a href="/rh" class="btn btn-primary">Ouvrir l'espace RH</a>
            </div>
          </div>

          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3>Nommer un responsable RH</h3></div>
              <% if (hrEligibleEmployees.length === 0) { %>
                <div class="empty-state">Tous les membres disposent déjà de l'accès RH.</div>
              <% } else { %>
                <form method="POST" action="/admin/rh/nommer" class="form-grid">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label class="span-2">
                    <span>Membre</span>
                    <select name="employee_id" required>
                      <option value="" disabled selected>Choisir…</option>
                      <% hrEligibleEmployees.forEach((e) => { %>
                        <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %> — <%= e.grade %></option>
                      <% }) %>
                    </select>
                  </label>
                  <div class="span-2">
                    <button type="submit" class="btn btn-primary btn-block">Donner l'accès RH</button>
                  </div>
                </form>
              <% } %>
              <p class="hint">Un membre RH conserve son espace personnel et obtient en plus le panneau de gestion RH. Les droits sont pris en compte à sa prochaine connexion.</p>
            </div>

            <div class="card">
              <div class="card-head"><h3>Membres RH <span class="muted">(<%= hrMembers.length %>)</span></h3></div>
              <% if (hrMembers.length === 0) { %>
                <div class="empty-state">Aucun responsable RH désigné.</div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th>Membre</th><th>Grade</th><th></th></tr></thead>
                    <tbody>
                      <% hrMembers.forEach((e) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                            <div class="cell-sub"><%= e.email %></div>
                          </td>
                          <td><span class="tag"><%= e.grade %></span></td>
                          <td class="actions">
                            <form method="POST" action="/admin/rh/<%= e.id %>/retirer" data-confirm="Retirer l'accès RH à ce membre ?">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger">Retirer l'accès</button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/confirm.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>

<!doctype html>
<html lang="<%= locale %>" dir="<%= localeDir %>" data-palette="<%= palette %>">
<head>
  <%- include('partials/head', { title: 'Administration — ' + t('app.name') }) %>
</head>
<body class="app-body">
  <div class="app-shell">
    <%- include('partials/admin-sidebar') %>

    <div class="app-main">
      <%- include('partials/app-header', {
        headerTitle: t('admin.title'),
        headerSubtitle: t('admin.subtitle')
      }) %>

      <main class="page">
        <% if (flash) { %>
          <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
        <% } %>

        <section class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'users', iconSize: 17 }) %></span>
            <span class="stat-body">
              <span class="stat-value"><%= stats.employeeCount %></span>
              <span class="stat-label"><%= t('admin.staffMembers') %></span>
            </span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'tool', iconSize: 17 }) %></span>
            <span class="stat-body">
              <span class="stat-value"><%= stats.toolCount %></span>
              <span class="stat-label"><%= t('admin.catalogueTools') %></span>
            </span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'link', iconSize: 17 }) %></span>
            <span class="stat-body">
              <span class="stat-value"><%= stats.assignedCount %></span>
              <span class="stat-label"><%= t('admin.activeAssignments') %></span>
            </span>
          </div>
          <div class="stat-card">
            <span class="stat-icon"><%- include('partials/icon', { name: 'plus', iconSize: 17 }) %></span>
            <span class="stat-body">
              <span class="stat-value"><%= stats.availableCount %></span>
              <span class="stat-label"><%= t('admin.unassignedTools') %></span>
            </span>
          </div>
        </section>

        <!-- PERSONNEL -->
        <section class="tab-panel is-active" id="personnel">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('admin.addMember') %></h3></div>
              <form method="POST" action="/admin/employes" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label>
                  <span><%= t('common.firstName') %></span>
                  <input type="text" name="first_name" required />
                </label>
                <label>
                  <span><%= t('common.name') %></span>
                  <input type="text" name="last_name" required />
                </label>
                <label class="span-2">
                  <span><%= t('admin.loginEmail') %></span>
                  <input type="email" name="email" required />
                </label>
                <label>
                  <span><%= t('common.grade') %></span>
                  <select name="grade" required>
                    <option value="" disabled selected><%= t('common.choose') %></option>
                    <% grades.forEach((g) => { %><option value="<%= g %>"><%= g %></option><% }) %>
                  </select>
                </label>
                <label>
                  <span><%= t('common.department') %></span>
                  <select name="department_id">
                    <option value="">— <%= t('common.none') %> —</option>
                    <% departments.forEach((d) => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
                  </select>
                </label>
                <label>
                  <span><%= t('common.team') %></span>
                  <select name="team_id">
                    <option value="">— <%= t('common.none') %> —</option>
                    <% teams.forEach((tm) => { %><option value="<%= tm.id %>"><%= tm.name %><%= tm.department_name ? ' · ' + tm.department_name : '' %></option><% }) %>
                  </select>
                </label>
                <label>
                  <span><%= t('admin.contractType') %></span>
                  <select name="contract_type" required>
                    <option value="" disabled selected><%= t('common.choose') %></option>
                    <% contractTypes.forEach((c) => { %><option value="<%= c %>"><%= c %></option><% }) %>
                  </select>
                </label>
                <label>
                  <span><%= t('admin.contractEnd') %></span>
                  <input type="date" name="contract_end_date" />
                </label>
                <label class="span-2">
                  <span><%= t('emp.dailyRate') %></span>
                  <input type="number" name="daily_rate" min="0" step="0.01" placeholder="Ex : 450" />
                </label>
                <div class="span-2">
                  <button type="submit" class="btn btn-primary btn-block"><%= t('admin.createAccount') %></button>
                </div>
              </form>
              <p class="hint">
                <%= t('admin.newMemberHelp', { days: annualLeaveDays }) %>
              </p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('common.team') %> <span class="muted">(<%= employees.length %>)</span></h3></div>
              <% if (employees.length === 0) { %>
                <div class="empty-state"><%= t('admin.noMemberYet') %></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th><%= t('common.member') %></th><th><%= t('common.grade') %></th><th><%= t('common.contract') %></th><th><%= t('nav.tools') %></th><th><%= t('common.status') %></th><th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% const todayStr = new Date().toISOString().slice(0, 10); %>
                      <% employees.forEach((e) => {
                        let daysLeft = null;
                        if (e.contract_end_date) {
                          daysLeft = Math.ceil((new Date(e.contract_end_date + 'T00:00:00Z') - new Date(todayStr + 'T00:00:00Z')) / 86400000);
                        }
                        const isExpired = daysLeft !== null && daysLeft < 0;
                        const isSoon = daysLeft !== null && daysLeft >= 0 && daysLeft <= 30;
                        const dateClass = isExpired ? 'text-danger' : (isSoon ? 'text-warning' : 'cell-sub');
                      %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                            <div class="cell-sub"><%= e.email %></div>
                          </td>
                          <td><span class="tag tag-accent"><%= e.grade %></span></td>
                          <td>
                            <div class="cell-strong small"><%= e.contract_type || '—' %></div>
                            <% if (e.contract_end_date) { %>
                              <div class="small <%= dateClass %>">
                                <%= isExpired ? 'Expiré le' : "Jusqu'au" %>
                                <%= new Date(e.contract_end_date + 'T00:00:00Z').toLocaleDateString(locale) %><% if (!isExpired) { %> · <%= daysLeft %> j<% } %>
                              </div>
                            <% } else { %>
                              <div class="cell-sub"><%= t('admin.openEnded') %></div>
                            <% } %>
                          </td>
                          <td class="num"><%= (toolsByEmployee[e.id] || []).length %></td>
                          <td>
                            <% if (isExpired) { %>
                              <span class="status status-warning"><%= t('status.expired') %></span>
                            <% } else { %>
                              <span class="status <%= e.active ? 'status-on' : 'status-off' %>"><%= e.active ? 'Actif' : 'Désactivé' %></span>
                            <% } %>
                            <% if (e.is_hr) { %><div><span class="tag tag-accent">RH</span></div><% } %>
                          </td>
                          <td class="actions">
                            <a href="/admin/employes/<%= e.id %>/modifier" class="btn btn-sm"><%= t('common.edit') %></a>
                            <form method="POST" action="/admin/employes/<%= e.id %>/statut">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm"><%= e.active ? 'Désactiver' : 'Activer' %></button>
                            </form>
                            <form method="POST" action="/admin/employes/<%= e.id %>/reinitialiser">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm"><%= t('admin.resetPassword') %></button>
                            </form>
                            <form method="POST" action="/admin/employes/<%= e.id %>/supprimer" data-confirm="<%= t('admin.deleteMember') %>">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger"><%= t('common.delete') %></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- OUTILS -->
        <section class="tab-panel" id="outils">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('admin.addTool') %></h3></div>
              <form method="POST" action="/admin/outils" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span><%= t('admin.toolName') %></span>
                  <input type="text" name="name" required />
                </label>
                <label>
                  <span><%= t('common.category') %></span>
                  <input type="text" name="category" placeholder="Ex : Informatique" />
                </label>
                <label>
                  <span><%= t('common.reference') %></span>
                  <input type="text" name="reference" placeholder="Ex : REF-2031" />
                </label>
                <label class="span-2">
                  <span><%= t('admin.loginUrl') %></span>
                  <input type="url" name="login_url" placeholder="https://outil.entreprise.com" />
                </label>
                <label class="span-2">
                  <span><%= t('common.description') %></span>
                  <textarea name="description" rows="3"></textarea>
                </label>
                <div class="span-2">
                  <button type="submit" class="btn btn-primary btn-block"><%= t('admin.addToCatalogue') %></button>
                </div>
              </form>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('hr.catalogue') %> <span class="muted">(<%= tools.length %>)</span></h3></div>
              <% if (tools.length === 0) { %>
                <div class="empty-state"><%= t('admin.noToolYet') %></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr><th><%= t('admin.tool') %></th><th><%= t('common.category') %></th><th><%= t('common.reference') %></th><th><%= t('admin.assignedTo') %></th><th></th></tr>
                    </thead>
                    <tbody>
                      <% tools.forEach((tool) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= tool.name %></div>
                            <% if (tool.login_url) { %><div class="cell-sub"><%= t('admin.accessConfigured') %></div><% } %>
                          </td>
                          <td><span class="tag"><%= tool.category || '—' %></span></td>
                          <td class="cell-sub"><%= tool.reference || '—' %></td>
                          <td class="num"><%= (employeesByTool[tool.id] || []).length %></td>
                          <td class="actions">
                            <a href="/admin/outils/<%= tool.id %>/modifier" class="btn btn-sm"><%= t('common.edit') %></a>
                            <form method="POST" action="/admin/outils/<%= tool.id %>/supprimer" data-confirm="<%= t('admin.deleteTool') %>">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger"><%= t('common.delete') %></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- AFFECTATIONS -->
        <section class="tab-panel" id="affectations">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('admin.assignTool') %></h3></div>
              <form method="POST" action="/admin/affectations" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span><%= t('common.member') %></span>
                  <select name="employee_id" required>
                    <option value="" disabled selected><%= t('common.choose') %></option>
                    <% employees.forEach((e) => { %>
                      <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %> — <%= e.grade %></option>
                    <% }) %>
                  </select>
                </label>
                <label class="span-2">
                  <span><%= t('admin.tool') %></span>
                  <select name="tool_id" required>
                    <option value="" disabled selected><%= t('common.choose') %></option>
                    <% tools.forEach((tool) => { %>
                      <option value="<%= tool.id %>"><%= tool.name %><%= tool.reference ? ' — ' + tool.reference : '' %></option>
                    <% }) %>
                  </select>
                </label>
                <label>
                  <span><%= t('common.identifier') %></span>
                  <input type="text" name="username" placeholder="Ex : marie.dupont" />
                </label>
                <label>
                  <span><%= t('common.note') %></span>
                  <input type="text" name="note" placeholder="Ex : usage chantier" />
                </label>
                <div class="span-2">
                  <button type="submit" class="btn btn-primary btn-block"><%= t('common.assign') %></button>
                </div>
              </form>
              <p class="hint"><%= t('admin.identifierHelp') %></p>
            </div>

            <div class="card">
              <% const rows = Object.values(toolsByEmployee).flat(); %>
              <div class="card-head"><h3><%= t('admin.activeAssignments') %> <span class="muted">(<%= rows.length %>)</span></h3></div>
              <% if (rows.length === 0) { %>
                <div class="empty-state"><%= t('admin.noAssignment') %></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr><th><%= t('common.member') %></th><th><%= t('admin.tool') %></th><th><%= t('common.identifier') %></th><th><%= t('admin.since') %></th><th></th></tr>
                    </thead>
                    <tbody>
                      <% rows.sort((a, b) => new Date(b.assigned_at) - new Date(a.assigned_at)).forEach((row) => { %>
                        <tr>
                          <td class="cell-strong"><%= employeesMap[row.employee_id].first_name %> <%= employeesMap[row.employee_id].last_name %></td>
                          <td><%= toolsMap[row.tool_id].name %></td>
                          <td class="mono"><%= row.username || '—' %></td>
                          <td class="cell-sub"><%= new Date(row.assigned_at).toLocaleDateString(locale) %></td>
                          <td class="actions">
                            <form method="POST" action="/admin/affectations/<%= row.id %>/supprimer">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger"><%= t('common.remove') %></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>

        <!-- ORGANISATION -->
        <section class="tab-panel" id="organisation">
          <div class="grid-2">
            <div class="stack">
              <div class="card">
                <div class="card-head"><h3><%= t('org.newDepartment') %></h3></div>
                <form method="POST" action="/admin/services" class="stack">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label>
                    <span><%= t('common.name') %></span>
                    <input type="text" name="name" maxlength="120" placeholder="Ex : Production" required />
                  </label>
                  <label>
                    <span><%= t('common.description') %> <span class="cell-sub">(<%= t('common.optional') %>)</span></span>
                    <input type="text" name="description" maxlength="500" />
                  </label>
                  <button type="submit" class="btn btn-primary btn-block"><%= t('common.create') %></button>
                </form>
              </div>

              <div class="card">
                <div class="card-head"><h3><%= t('org.newTeam') %></h3></div>
                <form method="POST" action="/admin/equipes" class="stack">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label>
                    <span><%= t('common.name') %></span>
                    <input type="text" name="name" maxlength="120" placeholder="Ex : Maintenance nord" required />
                  </label>
                  <label>
                    <span><%= t('common.department') %></span>
                    <select name="department_id">
                      <option value="">— <%= t('common.none') %> —</option>
                      <% departments.forEach((d) => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
                    </select>
                  </label>
                  <label>
                    <span><%= t('common.description') %> <span class="cell-sub">(<%= t('common.optional') %>)</span></span>
                    <input type="text" name="description" maxlength="500" />
                  </label>
                  <button type="submit" class="btn btn-primary btn-block"><%= t('common.create') %></button>
                  <p class="hint"><%= t('admin.teamHelp') %></p>
                </form>
              </div>
            </div>

            <div class="stack">
              <!-- Services et leurs managers -->
              <div class="card">
                <div class="card-head"><h3><%= t('org.departments') %> <span class="muted">(<%= departments.length %>)</span></h3></div>
                <% if (departments.length === 0) { %>
                  <div class="empty-state"><%= t('org.noDepartment') %></div>
                <% } else { %>
                  <ul class="org-list">
                    <% departments.forEach((d) => { %>
                      <li class="org-item">
                        <div class="org-head">
                          <div>
                            <span class="org-name"><%= d.name %></span>
                            <span class="cell-sub"><%= t('org.members') %> : <%= d.member_count %> · <%= t('org.teams') %> : <%= d.team_count %></span>
                          </div>
                          <form method="POST" action="/admin/services/<%= d.id %>/supprimer" data-confirm="<%= t('admin.deleteDepartment') %>">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
                          </form>
                        </div>
                        <% if (d.description) { %><p class="cell-sub"><%= d.description %></p><% } %>

                        <div class="org-managers">
                          <span class="cell-sub"><%= t('org.management') %> :</span>
                          <% const dManagers = departmentManagers[d.id] || []; %>
                          <% if (dManagers.length === 0) { %>
                            <span class="cell-sub"><%= t('org.noManager') %></span>
                          <% } else { %>
                            <% dManagers.forEach((m) => { %>
                              <form method="POST" action="/admin/encadrement/retirer" class="inline-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                <input type="hidden" name="scope" value="department" />
                                <input type="hidden" name="scope_id" value="<%= d.id %>" />
                                <input type="hidden" name="user_id" value="<%= m.id %>" />
                                <span class="tag tag-accent"><%= m.first_name %> <%= m.last_name %></span>
                                <button type="submit" class="btn btn-quiet btn-sm" title="<%= t('common.delete') %>">×</button>
                              </form>
                            <% }) %>
                          <% } %>
                        </div>

                        <form method="POST" action="/admin/encadrement" class="inline-form">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <input type="hidden" name="scope" value="department" />
                          <input type="hidden" name="scope_id" value="<%= d.id %>" />
                          <select name="user_id" required>
                            <option value=""><%= t('org.addManager') %></option>
                            <% employees.forEach((e) => { %><option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %></option><% }) %>
                          </select>
                          <button type="submit" class="btn btn-sm"><%= t('common.save') %></button>
                        </form>
                      </li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>

              <!-- Équipes et leurs managers -->
              <div class="card">
                <div class="card-head"><h3><%= t('org.teams') %> <span class="muted">(<%= teams.length %>)</span></h3></div>
                <% if (teams.length === 0) { %>
                  <div class="empty-state"><%= t('org.noTeam') %></div>
                <% } else { %>
                  <ul class="org-list">
                    <% teams.forEach((tm) => { %>
                      <li class="org-item">
                        <div class="org-head">
                          <div>
                            <span class="org-name"><%= tm.name %></span>
                            <span class="cell-sub"><%= tm.department_name || t('common.none') %> · <%= t('org.members') %> : <%= tm.member_count %></span>
                          </div>
                          <form method="POST" action="/admin/equipes/<%= tm.id %>/supprimer" data-confirm="<%= t('admin.deleteTeam') %>">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
                          </form>
                        </div>
                        <% if (tm.description) { %><p class="cell-sub"><%= tm.description %></p><% } %>

                        <div class="org-managers">
                          <span class="cell-sub"><%= t('org.management') %> :</span>
                          <% const tManagers = teamManagers[tm.id] || []; %>
                          <% if (tManagers.length === 0) { %>
                            <span class="cell-sub"><%= t('org.noManager') %></span>
                          <% } else { %>
                            <% tManagers.forEach((m) => { %>
                              <form method="POST" action="/admin/encadrement/retirer" class="inline-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                <input type="hidden" name="scope" value="team" />
                                <input type="hidden" name="scope_id" value="<%= tm.id %>" />
                                <input type="hidden" name="user_id" value="<%= m.id %>" />
                                <span class="tag tag-accent"><%= m.first_name %> <%= m.last_name %></span>
                                <button type="submit" class="btn btn-quiet btn-sm" title="<%= t('common.delete') %>">×</button>
                              </form>
                            <% }) %>
                          <% } %>
                        </div>

                        <form method="POST" action="/admin/encadrement" class="inline-form">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <input type="hidden" name="scope" value="team" />
                          <input type="hidden" name="scope_id" value="<%= tm.id %>" />
                          <select name="user_id" required>
                            <option value=""><%= t('org.addManager') %></option>
                            <% employees.forEach((e) => { %><option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %></option><% }) %>
                          </select>
                          <button type="submit" class="btn btn-sm"><%= t('common.save') %></button>
                        </form>
                      </li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Rattachement de chaque membre et visibilité dans l'annuaire -->
          <div class="card">
            <div class="card-head">
              <div>
                <h3><%= t('org.assignment') %></h3>
                <p class="card-sub"><%= t('admin.orgHelp') %></p>
              </div>
            </div>

            <% if (employees.length === 0) { %>
              <div class="empty-state"><%= t('admin.noMemberYet') %></div>
            <% } else { %>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th><%= t('common.member') %></th>
                      <th><%= t('org.assignment') %></th>
                      <th><%= t('common.managers') %></th>
                      <th><%= t('admin.directoryVisibility') %></th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% employees.forEach((e) => { %>
                      <tr>
                        <td>
                          <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                          <div class="cell-sub"><%= e.grade %></div>
                        </td>
                        <td>
                          <form method="POST" action="/admin/employes/<%= e.id %>/rattachement" class="inline-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <select name="department_id">
                              <option value="">— <%= t('common.department') %> —</option>
                              <% departments.forEach((d) => { %>
                                <option value="<%= d.id %>" <%= e.department_id === d.id ? 'selected' : '' %>><%= d.name %></option>
                              <% }) %>
                            </select>
                            <select name="team_id">
                              <option value="">— <%= t('common.team') %> —</option>
                              <% teams.forEach((tm) => { %>
                                <option value="<%= tm.id %>" <%= e.team_id === tm.id ? 'selected' : '' %>><%= tm.name %></option>
                              <% }) %>
                            </select>
                            <button type="submit" class="btn btn-sm"><%= t('common.save') %></button>
                          </form>
                        </td>
                        <td class="cell-sub">
                          <%
                            const seen = new Set();
                            const mgrs = [
                              ...(e.team_id ? (teamManagers[e.team_id] || []) : []),
                              ...(e.department_id ? (departmentManagers[e.department_id] || []) : []),
                            ].filter((m) => m.id !== e.id && !seen.has(m.id) && seen.add(m.id));
                          %>
                          <%= mgrs.length ? mgrs.map((m) => m.first_name + ' ' + m.last_name).join(', ') : '—' %>
                        </td>
                        <td>
                          <span class="status <%= e.directory_hidden ? 'status-off' : 'status-on' %>">
                            <%= e.directory_hidden ? t('admin.hidden') : t('admin.visible') %>
                          </span>
                        </td>
                        <td class="actions">
                          <form method="POST" action="/admin/employes/<%= e.id %>/annuaire">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <button type="submit" class="btn btn-sm"><%= e.directory_hidden ? "Afficher dans l'annuaire" : "Masquer de l'annuaire" %></button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </section>

        <!-- ACTUALITES -->
        <section class="tab-panel" id="actualites">
          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('team.publishNews') %></h3></div>
              <form method="POST" action="/admin/actualites" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="span-2">
                  <span><%= t('team.newsTitle') %></span>
                  <input type="text" name="title" required maxlength="150" />
                </label>
                <label class="span-2">
                  <span><%= t('team.newsBody') %></span>
                  <textarea name="body" rows="5" maxlength="2000"></textarea>
                </label>
                <label class="span-2">
                  <span><%= t('common.recipients') %></span>
                  <select name="target">
                    <option value="company"><%= t('home.companyNews') %></option>
                    <% departments.forEach((d) => { %>
                      <option value="department:<%= d.id %>"><%= t('common.department') %> · <%= d.name %></option>
                    <% }) %>
                    <% teams.forEach((tm) => { %>
                      <option value="team:<%= tm.id %>"><%= t('common.team') %> · <%= tm.name %></option>
                    <% }) %>
                  </select>
                </label>
                <div class="span-2">
                  <button type="submit" class="btn btn-primary btn-block"><%= t('team.publish') %></button>
                </div>
              </form>
              <p class="hint"><%= t('admin.newsHelp') %></p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('team.publishedNews') %> <span class="muted">(<%= companyNews.length %>)</span></h3></div>
              <% if (companyNews.length === 0) { %>
                <div class="empty-state"><%= t('home.noNews') %></div>
              <% } else { %>
                <% companyNews.forEach((n) => { %>
                  <div class="news-item">
                    <div class="news-head">
                      <span class="news-title"><%= n.title %></span>
                      <span class="tag tag-accent"><%= n.scope === 'company' ? t('home.companyNews') : n.scope_name || '—' %></span>
                      <span class="news-meta"><%= new Date(n.created_at).toLocaleDateString(locale) %></span>
                      <form method="POST" action="/admin/actualites/<%= n.id %>/supprimer" data-confirm="<%= t('common.delete') %> ?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-sm btn-danger"><%= t('common.delete') %></button>
                      </form>
                    </div>
                    <% if (n.body) { %><p class="news-body"><%= n.body %></p><% } %>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        </section>

        <!-- RESSOURCES HUMAINES -->
        <section class="tab-panel" id="rh">
          <div class="card">
            <div class="card-head">
              <div>
                <h3><%= t('nav.hrSpace') %></h3>
                <p class="card-sub"><%= t('admin.hrScope') %></p>
              </div>
              <a href="/rh" class="btn btn-primary"><%= t('nav.openHrSpace') %></a>
            </div>
          </div>

          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('admin.appointHr') %></h3></div>
              <% if (hrEligibleEmployees.length === 0) { %>
                <div class="empty-state"><%= t('admin.allHaveHr') %></div>
              <% } else { %>
                <form method="POST" action="/admin/rh/nommer" class="form-grid">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label class="span-2">
                    <span><%= t('common.member') %></span>
                    <select name="employee_id" required>
                      <option value="" disabled selected><%= t('common.choose') %></option>
                      <% hrEligibleEmployees.forEach((e) => { %>
                        <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %> — <%= e.grade %></option>
                      <% }) %>
                    </select>
                  </label>
                  <div class="span-2">
                    <button type="submit" class="btn btn-primary btn-block"><%= t('admin.grantHr') %></button>
                  </div>
                </form>
              <% } %>
              <p class="hint"><%= t('admin.hrHelp') %></p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('admin.hrMembers') %> <span class="muted">(<%= hrMembers.length %>)</span></h3></div>
              <% if (hrMembers.length === 0) { %>
                <div class="empty-state"><%= t('admin.noHrYet') %></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th><%= t('common.member') %></th><th><%= t('common.grade') %></th><th></th></tr></thead>
                    <tbody>
                      <% hrMembers.forEach((e) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                            <div class="cell-sub"><%= e.email %></div>
                          </td>
                          <td><span class="tag"><%= e.grade %></span></td>
                          <td class="actions">
                            <form method="POST" action="/admin/rh/<%= e.id %>/retirer" data-confirm="<%= t('admin.revokeHr') %>">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger"><%= t('admin.revokeAccess') %></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>

          <div class="card">
            <div class="card-head">
              <div>
                <h3><%= t('admin.financeTitle') %></h3>
                <p class="card-sub"><%= t('admin.financeScope') %></p>
              </div>
              <a href="/gestion" class="btn btn-primary"><%= t('admin.openFinance') %></a>
            </div>
          </div>

          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('admin.appointManager') %></h3></div>
              <% if (financeEligibleEmployees.length === 0) { %>
                <div class="empty-state"><%= t('admin.allHaveFinance') %></div>
              <% } else { %>
                <form method="POST" action="/admin/gestion/nommer" class="form-grid">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label class="span-2">
                    <span><%= t('common.member') %></span>
                    <select name="employee_id" required>
                      <option value="" disabled selected><%= t('common.choose') %></option>
                      <% financeEligibleEmployees.forEach((e) => { %>
                        <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %> — <%= e.grade %></option>
                      <% }) %>
                    </select>
                  </label>
                  <div class="span-2">
                    <button type="submit" class="btn btn-primary btn-block"><%= t('admin.grantFinance') %></button>
                  </div>
                </form>
              <% } %>
              <p class="hint"><%= t('admin.financeHelp') %></p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('admin.managers') %> <span class="muted">(<%= financeMembers.length %>)</span></h3></div>
              <% if (financeMembers.length === 0) { %>
                <div class="empty-state"><%= t('admin.noManagerYet') %></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th><%= t('common.member') %></th><th><%= t('common.grade') %></th><th></th></tr></thead>
                    <tbody>
                      <% financeMembers.forEach((e) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                            <div class="cell-sub"><%= e.email %></div>
                          </td>
                          <td><span class="tag"><%= e.grade %></span></td>
                          <td class="actions">
                            <form method="POST" action="/admin/gestion/<%= e.id %>/retirer" data-confirm="<%= t('admin.revokeFinance') %>">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger"><%= t('admin.revokeAccess') %></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>

          <div class="card">
            <div class="card-head">
              <div>
                <h3><%= t('admin.itTitle') %></h3>
                <p class="card-sub"><%= t('admin.itScope') %></p>
              </div>
              <a href="/informatique" class="btn btn-primary"><%= t('admin.openIt') %></a>
            </div>
          </div>

          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('admin.appointIt') %></h3></div>
              <% if (itEligibleEmployees.length === 0) { %>
                <div class="empty-state"><%= t('admin.allHaveIt') %></div>
              <% } else { %>
                <form method="POST" action="/admin/informatique/nommer" class="form-grid">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label class="span-2">
                    <span><%= t('common.member') %></span>
                    <select name="employee_id" required>
                      <option value="" disabled selected><%= t('common.choose') %></option>
                      <% itEligibleEmployees.forEach((e) => { %>
                        <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %> — <%= e.grade %></option>
                      <% }) %>
                    </select>
                  </label>
                  <div class="span-2">
                    <button type="submit" class="btn btn-primary btn-block"><%= t('admin.grantIt') %></button>
                  </div>
                </form>
              <% } %>
              <p class="hint"><%= t('admin.itHelp') %></p>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('admin.itMembers') %> <span class="muted">(<%= itMembers.length %>)</span></h3></div>
              <% if (itMembers.length === 0) { %>
                <div class="empty-state"><%= t('admin.noItYet') %></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th><%= t('common.member') %></th><th><%= t('common.grade') %></th><th></th></tr></thead>
                    <tbody>
                      <% itMembers.forEach((e) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                            <div class="cell-sub"><%= e.email %></div>
                          </td>
                          <td><span class="tag"><%= e.grade %></span></td>
                          <td class="actions">
                            <form method="POST" action="/admin/informatique/<%= e.id %>/retirer" data-confirm="<%= t('admin.revokeIt') %>">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger"><%= t('admin.revokeAccess') %></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>

          <div class="card">
            <div class="card-head">
              <div>
                <h3><%= t('admin.referentTitle') %></h3>
                <p class="card-sub"><%= t('admin.referentScope') %></p>
              </div>
              <a href="/alertes" class="btn btn-primary"><%= t('admin.openWhistleblow') %></a>
            </div>
            <p class="hint"><%= t('admin.referentHelp') %></p>
          </div>

          <div class="grid-2">
            <div class="card">
              <div class="card-head"><h3><%= t('admin.appointReferent') %></h3></div>
              <% if (referentEligibleEmployees.length === 0) { %>
                <div class="empty-state"><%= t('admin.allAreReferent') %></div>
              <% } else { %>
                <form method="POST" action="/admin/alerte/nommer" class="form-grid">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label class="span-2">
                    <span><%= t('common.member') %></span>
                    <select name="employee_id" required>
                      <option value="" disabled selected><%= t('common.choose') %></option>
                      <% referentEligibleEmployees.forEach((e) => { %>
                        <option value="<%= e.id %>"><%= e.first_name %> <%= e.last_name %> — <%= e.grade %></option>
                      <% }) %>
                    </select>
                  </label>
                  <div class="span-2">
                    <button type="submit" class="btn btn-primary btn-block"><%= t('admin.grantReferent') %></button>
                  </div>
                </form>
              <% } %>
            </div>

            <div class="card">
              <div class="card-head"><h3><%= t('admin.referentMembers') %> <span class="muted">(<%= referentMembers.length %>)</span></h3></div>
              <% if (referentMembers.length === 0) { %>
                <div class="empty-state"><%= t('admin.noReferentYet') %></div>
              <% } else { %>
                <div class="table-wrap">
                  <table>
                    <thead><tr><th><%= t('common.member') %></th><th><%= t('common.grade') %></th><th></th></tr></thead>
                    <tbody>
                      <% referentMembers.forEach((e) => { %>
                        <tr>
                          <td>
                            <div class="cell-strong"><%= e.first_name %> <%= e.last_name %></div>
                            <div class="cell-sub"><%= e.email %></div>
                          </td>
                          <td><span class="tag"><%= e.grade %></span></td>
                          <td class="actions">
                            <form method="POST" action="/admin/alerte/<%= e.id %>/retirer" data-confirm="<%= t('admin.revokeReferent') %>">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <button type="submit" class="btn btn-sm btn-danger"><%= t('admin.revokeAccess') %></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </section>
        <section class="tab-panel" id="modules">
          <div class="card">
            <div class="card-head">
              <div>
                <h3><%= t('nav.modules') %> <span class="muted">(<%= modules.filter((m) => m.enabled).length %>/<%= modules.length %>)</span></h3>
                <p class="card-sub"><%= t('admin.modulesHelp') %></p>
              </div>
            </div>

            <ul class="org-list">
              <% modules.forEach((m) => { %>
                <li class="org-item">
                  <div class="org-head">
                    <div>
                      <span class="org-name"><%= m.label %></span>
                      <span class="cell-sub"><%= m.href %></span>
                    </div>
                    <span class="status <%= m.enabled ? 'status-on' : 'status-off' %>">
                      <%= m.enabled ? t('common.active') : t('common.inactive') %>
                    </span>
                  </div>
                  <p class="benefit-text"><%= m.description %></p>
                  <div class="banner is-warning">
                    <%- include('partials/icon', { name: 'shield', iconSize: 17 }) %>
                    <span><%= m.caveat %></span>
                  </div>
                  <div class="row-actions">
                    <form method="POST" action="/admin/modules/<%= m.key %>" class="inline-form"<%= m.enabled ? ` data-confirm="${t('admin.disableModule')}"` : '' %>>
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <% if (!m.enabled) { %><input type="hidden" name="enabled" value="on" /><% } %>
                      <button type="submit" class="btn btn-sm <%= m.enabled ? '' : 'btn-primary' %>">
                        <%= m.enabled ? 'Désactiver' : 'Débloquer ce module' %>
                      </button>
                    </form>
                    <% if (m.enabled) { %>
                      <a href="<%= m.href %>" class="btn btn-outline btn-sm"><%= t('common.open') %></a>
                    <% } %>
                  </div>
                </li>
              <% }) %>
            </ul>
          </div>
        </section>

        <section class="tab-panel" id="apparence">
          <div class="card">
            <div class="card-head">
              <div>
                <h3><%= t('admin.instancePalette') %></h3>
                <p class="card-sub">
                  <%= t('admin.paletteHelp') %>
                </p>
              </div>
            </div>

            <div class="palette-grid">
              <% palettes.forEach((p) => { %>
                <form method="POST" action="/admin/apparence" class="palette-card <%= p.active ? 'is-active' : '' %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="palette" value="<%= p.key %>" />

                  <span class="palette-preview" data-palette-preview="<%= p.key %>" aria-hidden="true">
                    <span class="palette-nav">
                      <span class="palette-mark"></span>
                      <span class="palette-line"></span>
                      <span class="palette-line is-short"></span>
                    </span>
                    <span class="palette-body">
                      <span class="palette-card-sample">
                        <span class="palette-line is-dark"></span>
                        <span class="palette-line is-dark is-short"></span>
                        <span class="palette-button"></span>
                      </span>
                    </span>
                  </span>

                  <span class="palette-name">
                    <%= p.label %>
                    <% if (p.active) { %><span class="tag tag-accent"><%= t('adm.inService') %></span><% } %>
                  </span>
                  <span class="palette-text"><%= p.description %></span>

                  <button type="submit" class="btn btn-sm <%= p.active ? 'btn-outline' : 'btn-primary' %>" <%= p.active ? 'disabled' : '' %>>
                    <%= p.active ? t('adm.currentPalette') : t('common.apply') %>
                  </button>
                </form>
              <% }) %>
            </div>
          </div>
        </section>

      </main>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/confirm.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>

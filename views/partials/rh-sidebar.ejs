<%
/* Sections de l'espace RH, en un seul endroit (onglets sur /rh, liens ailleurs).
   Attend : asLinks? (booléen), active? (nom de section) */
const rhSections = [
  {
    tab: 'demandes',
    label: t('nav.requests'),
    icon: 'inbox',
    // Le compteur n'est calculé que sur l'espace RH lui-même.
    badge: typeof stats !== 'undefined' && stats ? stats.pendingCount : 0,
  },
  { tab: 'personnel', label: t('nav.leave'), icon: 'users' },
  { tab: 'paie', label: t('nav.payroll'), icon: 'card' },
  { tab: 'remuneration', label: t('nav.remuneration'), icon: 'clock' },
  { tab: 'documents', label: t('erp.documents'), icon: 'inbox' },
  {
    tab: 'formations',
    label: t('erp.trainings'),
    icon: 'ticket',
    badge: typeof talent !== 'undefined' && talent ? talent.pendingSeats : 0,
  },
  { tab: 'entretiens', label: t('erp.reviews'), icon: 'check' },
  { tab: 'recrutement', label: t('erp.recruitment'), icon: 'user' },
  {
    tab: 'cse',
    label: t('nav.cse'),
    icon: 'lifebuoy',
    // Le compteur ne vaut que sur l'espace RH lui-même, où les candidatures sont chargées.
    badge: typeof cse !== 'undefined' && cse ? cse.pendingCandidacies : 0,
  },
];
const rhAsLinks = typeof asLinks !== 'undefined' && asLinks;
const rhActive = typeof active !== 'undefined' ? active : null;
// L'administrateur n'a pas d'espace membre : il retourne à sa console.
const rhFootLinks = [
  { href: '/coffre-fort/gestion', label: 'Coffre-fort', icon: 'shield' },
  { href: '/parcours', label: 'Parcours et compétences', icon: 'users' },
  { href: '/sante-securite', label: 'Santé-sécurité', icon: 'shield' },
];
rhFootLinks.push(currentUser.role === 'admin'
  ? { href: '/admin', label: t('nav.adminConsole'), icon: 'settings' }
  : { href: '/mon-espace', label: t('nav.mySpace'), icon: 'home' });
if (isFinance || currentUser.role === 'admin') rhFootLinks.push({ href: '/gestion', label: t('nav.gestion'), icon: 'briefcase' });
// Le moteur de paie est un module RH : il n'apparaît qu'une fois débloqué.
const payrollModule = enabledModules.find((m) => m.key === 'paie');
if (payrollModule) rhFootLinks.unshift({ href: payrollModule.href, label: payrollModule.label, icon: payrollModule.icon });
%>
<%- include('sidebar', {
  panelLabel: 'Ressources humaines',
  navItems: rhAsLinks
    ? rhSections.map((s) => ({ href: '/rh#' + s.tab, label: s.label, icon: s.icon, badge: s.badge, active: s.tab === rhActive }))
    : rhSections,
  footLinks: rhFootLinks
}) %>
